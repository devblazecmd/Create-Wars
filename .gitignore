# Obsidian local-only workspace state (keep the config that defines the vault's look/plugins, ignore
# per-device window/scroll state)
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json

# OS cruft
Thumbs.db
.DS_Store

# server logs (contain player IP addresses) must never be committed to the public repo
server.log
*.log

# Mods come from packwiz (pack/mods/*.pw.toml). Don't commit loose jars in the repo root.
/*.jar
# Python bytecode
__pycache__/
