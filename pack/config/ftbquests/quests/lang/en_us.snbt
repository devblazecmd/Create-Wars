	]
	"quest.3963055014A29884.title": "Automate: Steak"
	"quest.398902EC58D4FE30.quest_desc": [
		"Paper, precision mechanism and redstone: choose what gets shot at."
	]
	"quest.398902EC58D4FE30.title": "Targeting Filter"
	"quest.39B7178398319DC1.quest_desc": [
		"Brass casing, comparator, precision mechanism and redstone: fires when on target."
