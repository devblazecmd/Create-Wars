	"quest.3D42DEA97763E9D2.title": "Clarified Water"
	"quest.3E2D23E1D3A0EBE4.quest_desc": [
		"Everything starts with rotation. Head to the &6Andesite Age&r."
	]
	"quest.3E2D23E1D3A0EBE4.title": "Start Building"
	"quest.3E8A5CA51D5E3551.quest_desc": [
		"Outputs 0-15 redstone for the pollution around it. Turn on scrubbers automatically."
