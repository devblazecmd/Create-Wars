	]
	"quest.3E8CDCFA219066BF.title": "HE Bouncing Bomb"
	"quest.3EA769AC23CBEC0F.quest_desc": [
		"Mechanical crafting: an AP Shell, iron plates and a propeller. Armor-piercing high"
		"explosive for armored targets."
	]
	"quest.3EA769AC23CBEC0F.title": "APHE Bomb"
	"quest.3EBBCA8C5D0936F3.quest_desc": [
		"Fill the cake base with liquid experience using a Spout."
	]
	"quest.3EBBCA8C5D0936F3.title": "Cake o' Enchanting"
	"quest.3ED4598EDD7E20BC.quest_desc": [
		"Pumpkins under a Slicer with a knife. Make a &astack&r."
	]
	"quest.3ED4598EDD7E20BC.title": "Automate: Pumpkin Slice"
	"quest.3EF1E1D409B7DDAD.quest_desc": [
		"Iron bars, white wool and andesite alloy. Goes in an Air Scrubber. Clogged cartridges"
		"come back clean with &abulk washing&r (fan through water)."
	]
	"quest.3EF1E1D409B7DDAD.title": "Filter Cartridge"
	"quest.3F82F140108CBD1D.quest_desc": [
		"Mechanical crafting: brass plates, an electron tube, a &aWired Fuze&r, a powder charge,"
		"redstone, string and guncotton. Stick it to a wall and set it off remotely."
	]
	"quest.3F82F140108CBD1D.title": "C4 Charge"
	"quest.3FBAC9E934B9E561.quest_desc": [
		"&aCod Roll&r: 2 raw cod slices and cooked rice. &aSalmon Roll&r: 2 raw salmon slices and cooked"
		"rice. Cooked rice comes from the &aCooking Pot&r."
	]
	"quest.3FBAC9E934B9E561.title": "Sushi"
	"quest.3FE2CB017F0A2003.quest_desc": [
		"Cooked rice, dried kelp and a vegetable. Make a &astack&r."
	]
	"quest.3FE2CB017F0A2003.title": "Automate: Kelp Roll"
	"quest.3FFACDD178C182FA.quest_desc": [
		"Compact dough, an egg and 2 sugar into a cake base, then bake it with a smoking fan."
		"Make a &astack&r."
		""
		"&7Needs eggs from Animal Product Automation."
	]
	"quest.3FFACDD178C182FA.title": "Automate: Baked Cake Base"
	"quest.403EEC901700CF83.quest_desc": [
		"Iron sheets and iron rods (roll iron ingots). An empty spool to wind wire onto."
	]
	"quest.403EEC901700CF83.title": "Spool"
	"quest.405CADB4D11C95CC.quest_desc": [
		"Gold, gold nuggets and a golden sheet. A key that opens more of your trains."
	]
	"quest.405CADB4D11C95CC.title": "Gold Key"
	"quest.40615557FFDA4DD0.quest_desc": [
		"Crushed copper ore through a fan blowing through lava. Make a &astack&r."
	]
	"quest.40615557FFDA4DD0.title": "Automate: Copper Ingot"
	"quest.4081D65FB1B1B03E.quest_desc": [
		"Cast iron, iron plate, guncotton and a heavy pressure plate. Stops vehicles."
	]
	"quest.4081D65FB1B1B03E.title": "Large Mine"
	"quest.409EE419472612AB.quest_desc": [
		"A rabbit pen: breed with carrots or dandelions, kill with Deployers. A Bait Trap baited with"
		"carrots works too. Make a &astack&r."
	]
	"quest.409EE419472612AB.title": "Automate: Raw Rabbit"
	"quest.40B15D449F2EBE71.quest_desc": [
		"Smithing: a &aBlaze Burner&r, an &aenchanting table&r and a &aBlaze Upgrade Smithing"
		"Template&r. Enchants items automatically with liquid experience."
	]
	"quest.40B15D449F2EBE71.title": "Blaze Enchanter"
	"quest.40D51604C8B3AE17.quest_desc": [
		"Mill hardened nitro into &aNitropowder&r: a stronger charge filling than gunpowder."
	]
	"quest.40D51604C8B3AE17.title": "Nitropowder"
	"quest.40DC2725DCAD8BA8.quest_desc": [
		"Raw chicken under a Slicer with a knife. Make a &astack&r."
	]
	"quest.40DC2725DCAD8BA8.title": "Automate: Raw Chicken Cuts"
	"quest.40E46B6091948CA7.quest_desc": [
		"Run cod and salmon past the Peeler. Cooked steaks go into a &aSeafood Steak&r with steak and"
		"cooked lobster."
	]
	"quest.40E46B6091948CA7.title": "Fish Steaks"
	"quest.40F499E79AE3DD52.quest_desc": [
		"Mechanical crafting: explosive filling, iron and wooden slabs. Shells need a &afuze&r to"
		"go off."
	]
	"quest.40F499E79AE3DD52.title": "High Explosive Shell"
	"quest.410E56CB8C715403.quest_desc": [
		"Iron sheets, iron bars, andesite casing and a shaft. Spin it and give it a cartridge to"
		"clean the chunk around it. Pipe in water for a faster, sulfur-catching wet filter."
	]
	"quest.410E56CB8C715403.title": "Air Scrubber"
	"quest.412783421E3F2B5F.quest_desc": [
		"&6Stellarity&r: the dragon is &cnot there when you arrive&r. You summon it: place &a4 End"
		"Crystals&r on the 4 sparkling spots around the exit portal at the center of the main island."
		"It's a real boss: 300 health, armor, and invulnerable while any crystal stands."
		"&cNo air in the End&r: bring backtanks and air bladders."
	]
	"quest.412783421E3F2B5F.title": "The Ender Dragon"
	"quest.41370BD350C0E8DF.quest_desc": [
		"Andesite alloy and a shaft. The entry point to Enchantment Industry; its Ponder shows how"
		"it turns items and enchantments into &aliquid experience&r."
	]
	"quest.41370BD350C0E8DF.title": "Mechanical Grindstone"
	"quest.41380124E301CF88.quest_desc": [
		"Mix organic compost with water in a basin. Sprinklers spray it to speed up crops."
	]
	"quest.41380124E301CF88.title": "Liquid Fertilizer"
	"quest.41592A4B0B4E6609.quest_desc": [
		"A cooked fish steak, steak and cooked lobster (Mechanical Crafters). Make a &astack&r."
	]
	"quest.41592A4B0B4E6609.title": "Automate: Seafood Steak"
	"quest.415DCC8C641DB388.quest_desc": [
		"Blow yellowcake through the &aEnriching Campfire&r with an encased fan."
	]
	"quest.415DCC8C641DB388.title": "Enriched Yellowcake"
	"quest.4197D2995C3D7FE3.quest_desc": [
		"Iron plates, a dispenser and redstone. Mount it on an aircraft."
	]
	"quest.4197D2995C3D7FE3.title": "Rocket Pod Section"
	"quest.41C02E3221A34BAB.quest_desc": [
		"Every Brass-tier material and part, made by machines. Precision on an industrial scale."
	]
	"quest.41C02E3221A34BAB.title": "Brass Automation Mastered"
	"quest.41CD81FE0E6AA722.quest_desc": [
		"Spins up, then fires very fast. Power it with redstone."
	]
	"quest.41CD81FE0E6AA722.title": "Minigun"
	"quest.41F3783BD41BD8AD.quest_desc": [
		"A hay bale in an iron shell: bursts into a smoke screen to hide an advance."
	]
	"quest.41F3783BD41BD8AD.title": "Smoke Shell"
	"quest.421AAC9D06C82038.quest_desc": [
		"Stone through a lava fan a second time. Make a &astack&r."
	]
	"quest.421AAC9D06C82038.title": "Automate: Smooth Stone"
	"quest.4220A170A131104A.quest_desc": [
		"Pumpkin stems and a &aMechanical Saw&r cutting the pumpkins. Make a &astack&r."
	]
	"quest.4220A170A131104A.title": "Automate: Pumpkin"
	"quest.4257FB3FAF262265.quest_desc": [
		"Compact &aeggs, sugar and lapis&r in a Basin."
	]
	"quest.4257FB3FAF262265.title": "Cake Base o' Enchanting"
	"quest.4262DE4BB5374E58.quest_desc": [
		"Chickens drop feathers when killed; a Bait Trap baited with seeds gives them too. Make a &astack&r."
	]
	"quest.4262DE4BB5374E58.title": "Automate: Feather"
	"quest.428299DA2B3171F7.quest_desc": [
		"Every quest under &aMagma and Glowstone&r is done: 3 production lines running on their own."
	]
	"quest.428299DA2B3171F7.title": "Magma and Glowstone Mastered"
	"quest.42A23A4ACF5E0DBA.quest_desc": [
		"Outputs redstone by height: the basis of altitude hold."
	]
	"quest.42A23A4ACF5E0DBA.title": "Altitude Sensor"
	"quest.42A312B2143E049C.quest_desc": [
		"Throws hatchets from range."
	]
	"quest.42A312B2143E049C.title": "Marauder"
	"quest.42E06B591264712B.quest_desc": [
		"Copper, iron nuggets and guncotton. Guards a harbor."
	]
	"quest.42E06B591264712B.title": "Sea Mine"
	"quest.42F7C1E1748DCE3D.quest_desc": [
		"Deploy a precision control circuit blank onto brass casing. Program flight logic"
		"with Cimulink circuits."
	]
	"quest.42F7C1E1748DCE3D.title": "Circuit"
	"quest.435D9D6E00A270AC.quest_desc": [
		"Cooked chicken, bread, 2 baked potatoes, 2 carrots, onion, an egg and a bowl."
		"Make &a4&r."
		""
		"&7Needs eggs from Animal Product Automation."
	]
	"quest.435D9D6E00A270AC.title": "Automate: Roast Chicken"
	"quest.438364018067A419.quest_desc": [
		"Every quest under &aGems and Dusts&r is done: 4 production lines running on their own."
	]
	"quest.438364018067A419.title": "Gems and Dusts Mastered"
	"quest.438EF50C90497E4F.quest_desc": [
		"Andesite casing, iron sheet, shaft and gunpowder. A mount turns and aims a cannon with"
		"rotational power; assemble the cannon on it."
	]
	"quest.438EF50C90497E4F.title": "Cannon Mount"
	"quest.43B65B6F74E24201.quest_desc": [
		"&cWaystones don't generate&r in the world or in villages. You have to craft them, and every"
		"waystone recipe runs on &dTelejuice&r: Quantum Pearls, Quantum Casings and Quantum Paper."
		""
		"You'll learn to make it in the &dQuantum Expansion&r."
	]
	"quest.43B65B6F74E24201.title": "Waystones Are Built, Not Found"
	"quest.43B8063761FBCE93.quest_desc": [
		"A cow pen: breed them with Deployers holding wheat, and kill the adults with Deployers"
		"holding a sword. Make a &astack&r."
	]
	"quest.43B8063761FBCE93.title": "Automate: Raw Beef"
	"quest.43E8CC08C9CD8A1F.quest_desc": [
		"Full bee hives give honeycomb when sheared: try Deployers holding shears. Make a &astack&r."
	]
	"quest.43E8CC08C9CD8A1F.title": "Automate: Honeycomb"
	"quest.44241F8B25C03EB8.quest_desc": [
		"An air-to-air missile. Mechanical crafting with a &aProximity Fuze&r and a precision"
		"mechanism."
	]
	"quest.44241F8B25C03EB8.title": "AIM-9 Sidewinder"
	"quest.44270F9E712C8E30.quest_desc": [
		"An apple ringed with gold ingots: 8 per apple, so 512 gold for a stack. Make a &astack&r."
	]
	"quest.44270F9E712C8E30.title": "Automate: Golden Apple"
	"quest.446D9B17AB7994FD.quest_desc": [
		"Brass casing, a radar dish and a receiver: compact radar for aircraft."
	]
	"quest.446D9B17AB7994FD.title": "Plane Radar"
	"quest.44824E2BD594A84A.quest_desc": [
		"Crushed nickel ore through a lava fan. Make a &astack&r."
	]
	"quest.44824E2BD594A84A.title": "Automate: Nickel Ingot"
	"quest.44BEA75788C0D2BC.quest_desc": [
		"Shot balls and gunpowder: bursts into fragments."
	]
	"quest.44BEA75788C0D2BC.title": "Shrapnel Shell"
	"quest.45338D757CFC7C63.quest_desc": [
		"Iron sheet and andesite alloy. Pipe exhaust from a machine to a smokestack elsewhere."
		"A broken duct leaks and smokes."
	]
	"quest.45338D757CFC7C63.title": "Exhaust Duct"
	"quest.453E0E92B7BA6611.quest_desc": [
		"Train Casing and an electron tube (makes 2). Splits track into blocks so trains don't"
		"collide."
	]
	"quest.453E0E92B7BA6611.title": "Train Signal"
	"quest.4589C8FD19F78A7F.quest_desc": [
		"Lava flowing into &achocolate&r makes scoria. A Drill mines it. Make a &astack&r."
	]
	"quest.4589C8FD19F78A7F.title": "Automate: Scoria"
	"quest.459817C4038930C4.quest_desc": [
		"Brass sheets, an antenna, a monitor and an electron tube (pack recipe). Links to and flies"
		"FPV drones."
	]
	"quest.459817C4038930C4.title": "Drone Joystick"
	"quest.45BA406899B44C40.quest_desc": [
		"Casings, funnels, tunnels and chutes for a smarter factory."
	]
	"quest.45BA406899B44C40.title": "Brass Logistics"
	"quest.45BDA6C768B90B56.quest_desc": [
		"Blow kelp through &afire&r with an Encased Fan (smoking). Make a &astack&r of Dried Kelp."
	]
	"quest.45BDA6C768B90B56.title": "Automate: Dried Kelp"
	"quest.45EF11E35D7CAB2D.quest_desc": [
		"String, guncotton and iron nuggets (makes 2). Booby-trap a doorway."
	]
	"quest.45EF11E35D7CAB2D.title": "Tripwire Coil"
	"quest.45F467C71BDE3B92.quest_desc": [
		"Chickens lay eggs on their own. Catch them with hoppers or funnels under the pen."
		"Make a &astack&r (16)."
	]
	"quest.45F467C71BDE3B92.title": "Automate: Egg"
	"quest.460F2822FC8D77BC.quest_desc": [
		"Paper, a compass and redstone. Marks an area your radar weapons won't fire into, such as"
		"your own base."
	]
	"quest.460F2822FC8D77BC.title": "Radar Safe Zone Designator"
	"quest.463608773F5CEE47.quest_desc": [
		"Lead and copper nuggets into a blank gatling round."
	]
	"quest.463608773F5CEE47.title": "Gatling Round"
	"quest.464094FC2BEB33D4.quest_desc": [
		"A &aBait Trap&r (Mesh Trap plus a lantern) baited with fish, steaks, mussels or fish skin catches"
		"lobsters. Make a &astack&r."
	]
	"quest.464094FC2BEB33D4.title": "Automate: Raw Lobster"
	"quest.4680D4EEDDCD2B02.quest_desc": [
		"&eChanged in this pack:&r waystones don't generate. Mechanical crafting: Warp Stone,"
		"&d3 Quantum Pearls&r, &d2 Quantum Casings&r, casings and bricks."
	]
	"quest.4680D4EEDDCD2B02.title": "Waystone"
	"quest.4685125B29B34D93.quest_desc": [
		"Every quest under &aCrops&r is done: 18 production lines running on their own."
	]
	"quest.4685125B29B34D93.title": "Crops Mastered"
	"quest.46CD3DE458C8CF95.quest_desc": [
		"Raw cod under a Slicer with a knife. Make a &astack&r."
	]
	"quest.46CD3DE458C8CF95.title": "Automate: Raw Cod Slice"
	"quest.46D61453D2A55B56.quest_desc": [
		"Mixer: rice, raw meat, rotten flesh, bone meal and a bowl. Make a &astack&r (16)."
	]
	"quest.46D61453D2A55B56.title": "Automate: Dog Food"
	"quest.4706D48B2397DBEB.quest_desc": [
		"A boss that destroys blocks. Fight it far from your base."
	]
	"quest.4706D48B2397DBEB.title": "The Wither"
	"quest.471544857B419170.quest_desc": [
		"Deployers press planks onto cogwheels. Make a &astack&r."
	]
	"quest.471544857B419170.title": "Automate: Large Cogwheel"
	"quest.47BD23F65E10529D.quest_desc": [
		"Feed an army without lifting a knife. Make these with &amachines&r, not by hand."
	]
	"quest.47BD23F65E10529D.title": "Food Automation"
	"quest.47DAF49FAD3BD9FB.quest_desc": [
		"Bread, a beef patty, a leafy green, tomato and onion."
	]
	"quest.47DAF49FAD3BD9FB.title": "Hamburger"
	"quest.47E331B6B4A0C49F.quest_desc": [
		"4 melon slices, sugar and a glass bottle. Make a &astack&r (16)."
	]
	"quest.47E331B6B4A0C49F.title": "Automate: Melon Juice"
	"quest.47EF23A2057ECF4E.quest_desc": [
		"They climb walls. Walls alone will not stop them."
	]
	"quest.47EF23A2057ECF4E.title": "Spiders"
	"quest.47FAA13063C15889.quest_desc": [
		"A &aWater Wheel&r turns when water flows past it. It's your first source of"
		"&6stress capacity&r (SU). Every machine uses some; the goggles show how much is left."
	]
	"quest.47FAA13063C15889.title": "Water Wheel"
	"quest.4835DADB3C450D57.quest_desc": [
		"Raw mutton under a Slicer with a knife. Make a &astack&r."
	]
	"quest.4835DADB3C450D57.title": "Automate: Raw Mutton Chops"
	"quest.48768D4D201D8CE7.quest_desc": [
		"A &asteel sheet&r on &aSteel Casing&r. The shell for oil and engine machinery."
	]
	"quest.48768D4D201D8CE7.title": "Heavy Machinery Casing"
	"quest.48B1B3FC63F633F8.quest_desc": [
		"Assemble and stop trains at a &aStation&r. Check the Ponder."
	]
	"quest.48B1B3FC63F633F8.title": "Train Station"
	"quest.48BD6C1FF6EEBB8E.quest_desc": [
		"Desert zombies. They make you hungry."
	]
	"quest.48BD6C1FF6EEBB8E.title": "Husks"
	"quest.494BA293994AE30A.quest_desc": [
		"Every quest under &aSpout&r is done: 8 production lines running on their own."
	]
	"quest.494BA293994AE30A.title": "Spout Mastered"
	"quest.49FB082F1DDF9864.quest_desc": [
		"Deployers holding sand paper polish rose quartz (a Mechanical Peeler does too). Make a &astack&r."
	]
	"quest.49FB082F1DDF9864.title": "Automate: Polished Rose Quartz"
	"quest.4A5F8E84D4A3E786.quest_desc": [
		"Industrial iron and TNT. Deny an area of sea to enemy submarines."
	]
	"quest.4A5F8E84D4A3E786.title": "Underwater Mine"
	"quest.4AB19D7D47667BE1.quest_desc": [
		"Crushed lithium ore through a lava fan. Make a &astack&r."
	]
	"quest.4AB19D7D47667BE1.title": "Automate: Lithium Ingot"
	"quest.4AB1E382B8490E57.quest_desc": [
		"Brass casing, brass sheets, an electron tube and iron bars. Put it in an exhaust line:"
		"it catches soot, more the faster it spins. Pipe water in to wash out sulfur."
	]
	"quest.4AB1E382B8490E57.title": "Electrostatic Precipitator"
	"quest.4ACA6968EC983F12.quest_desc": [
		"Grow Umbran saplings and fell the trees with &aMechanical Saws&r. Leaf blocks only drop to shears:"
		"try Deployers holding shears. Make a &astack&r of each."
	]
	"quest.4ACA6968EC983F12.title": "Automate: Umbran"
	"quest.4B274D3E2316F111.quest_desc": [
		"Lead balls into a blank shotgun round."
	]
	"quest.4B274D3E2316F111.title": "Shotgun Round"
	"quest.4B42BE877F72A499.quest_desc": [
		"Brass casing, wooden slabs and a gyroscopic mechanism. A propeller bearing that"
		"keeps itself level."
	]
	"quest.4B42BE877F72A499.title": "Gyroscopic Propeller Bearing"
	"quest.4BCEC493225826A4.quest_desc": [
		"Iron and a lever. Use it on a copper chest to upgrade it in place: contents stay."
	]
	"quest.4BCEC493225826A4.title": "Iron Tier"
	"quest.4BE81C1CD42ADD22.quest_desc": [
		"Bread, cooked bacon, a leafy green and tomato. Make a &astack&r."
	]
	"quest.4BE81C1CD42ADD22.title": "Automate: Bacon Sandwich"
	"quest.4BEDE181FB336132.quest_desc": [
		"&6Aeroworks&r: a real cockpit. A &aControl Stand&r (copper casing, redstone link, electron"
		"tube, transmitter, precision mechanism) has &asockets&r for control modules. Sneak-right-click"
		"it to bind each module to &aRedstone Link&r frequencies, then wire those to your craft."
	]
	"quest.4BEDE181FB336132.title": "Control Stand"
	"quest.4BF2549A5697EC75.quest_desc": [
		"Paper, an electron tube and redstone. Tells friend from foe, so your guns leave"
		"transponder-marked craft alone."
	]
	"quest.4BF2549A5697EC75.title": "Identification Filter"
	"quest.4C0B58935DA7AACD.quest_desc": [
		"Compact &aliquid experience&r into a solid &aBlock of Experience&r."
	]
	"quest.4C0B58935DA7AACD.title": "Block of Experience"
	"quest.4C14CE0432A3011A.quest_desc": [
		"Every ore in the pack, mined, crushed and refined by machines. Diamonds and netherite too."
	]
	"quest.4C14CE0432A3011A.title": "Ore Automation"
	"quest.4C19787636CD5EF9.quest_desc": [
		"Mixer: raw fish, onion, tomato sauce and a bowl. Make a &astack&r (16)."
	]
	"quest.4C19787636CD5EF9.title": "Automate: Fish Stew"
	"quest.4C20D3C1C2FAB4CF.quest_desc": [
		"You've mastered brass. This &aunlocks the Industrial Age&r and all three &6Expansions&r:"
		"Heat, Quantum and Enchanting."
		""
		"&7Requires: Electron Tube, Deployer, Precision Mechanism and Mechanical Crafter.&r"
	]
	"quest.4C20D3C1C2FAB4CF.title": "Brass Age Complete"
	"quest.4C4C085C92F74D33.quest_desc": [
		"&6Create: Connected&r: copper sheets and a barrel. A sideways tank. Converts to and from a"
		"Fluid Tank in the crafting grid."
	]
	"quest.4C4C085C92F74D33.title": "Fluid Vessel"
	"quest.4C8806C45173F2D0.quest_desc": [
		"Mixer: milk, sugar and cocoa beans make liquid chocolate. A &aSpout&r fills buckets."
		"Fill &a16&r buckets."
	]
	"quest.4C8806C45173F2D0.title": "Automate: Chocolate"
	"quest.4C92BC6C73EA306C.quest_desc": [
		"&6Create Nuclear&r: uranium and thorium ores generate underground."
		"&cUranium is radioactive.&r Carry too much for too long and you get &cRadiation&r. Store it,"
		"don't hoard it in your pockets."
	]
	"quest.4C92BC6C73EA306C.title": "Uranium"
	"quest.4CC67633097B3200.quest_desc": [
		"Brass casing, a precision mechanism, brass sheets and andesite alloy. An Arm picks items"
		"up and drops them into machines, depots and chests in range."
	]
	"quest.4CC67633097B3200.title": "Mechanical Arm"
	"quest.4CCBC62EA65800AD.quest_desc": [
		"&aMechanical Crafting&r: copper spool, capacitor, brass casing and sheets, an electron tube"
		"and andesite alloy. Charges items on a depot below it (gold into Electrum) and zaps"
		"anything that wanders under it."
	]
	"quest.4CCBC62EA65800AD.title": "Tesla Coil"
	"quest.4D1D21B956A310AC.quest_desc": [
		"A chorus fruit farm feeding a heated mixer. Fill a &astack&r of Telejuice buckets (16)."
	]
	"quest.4D1D21B956A310AC.title": "Automate: Telejuice"
	"quest.4D2AE9BC5DC8E7A0.quest_desc": [
		"Crush zinc ore or raw zinc (asurine works too). Make a &astack&r."
	]
	"quest.4D2AE9BC5DC8E7A0.title": "Automate: Crushed Raw Zinc"
	"quest.4D3E8408DC5F369A.quest_desc": [
		"Every quest under &aMixing&r is done: 28 production lines running on their own."
	]
	"quest.4D3E8408DC5F369A.title": "Mixing Mastered"
	"quest.4D59F0C8C2DE0CB2.quest_desc": [
		"A mechanical bearing, torsion spring, clutch and gearshift. Moves control surfaces."
	]
	"quest.4D59F0C8C2DE0CB2.title": "Flap Bearing"
	"quest.4D699D6ADDDBDDE5.quest_desc": [
		"Iron plate, nuggets and red wool. Safely cut enemy tripwires."
	]
	"quest.4D699D6ADDDBDDE5.title": "Wire Cutters"
	"quest.4DA0DEC5FD32700E.quest_desc": [
		"Fill a &astack&r of Bucket o' Enchanting (16) from an automated setup."
	]
	"quest.4DA0DEC5FD32700E.title": "Automate: Liquid Experience"
	"quest.4DB1904CB77CFEAE.quest_desc": [
		"&6Create Aeronautics: AMBUSH&r: enemies attack in planned &cambushes&r and &cinvasions&r,"
		"including &cairships, armored cars and anti-air&r built with the same Create tech you"
		"use. Enemy airships can appear on their own."
		"&aPrepare:&r radar to see them coming (Radar chapter), anti-air guns, and an air-raid"
		"siren."
	]
	"quest.4DB1904CB77CFEAE.title": "Ambush!"
	"quest.4DD101E5933E8C5C.quest_desc": [
		"&6FTB Ultimine&r: hold the &aUltimine key&r (default &a`&r, the grave key; change it in"
		"Controls) and break a block to mine up to &a64&r connected blocks of the same kind: a whole"
		"ore vein or tree. Costs hunger per block. Hold it and right-click to harvest crops, strip"
		"logs or till soil in bulk."
	]
	"quest.4DD101E5933E8C5C.title": "Vein Mining"
	"quest.4E215730E6F0B136.quest_desc": [
		"Gunpowder, a lead nugget and paper: flintlock ammo."
	]
	"quest.4E215730E6F0B136.title": "Paper Cartridge"
	"quest.4E57CCC63F2E0A11.quest_desc": [
		"Every crop and every meat, by the stack, with no hands on the harvest."
	]
	"quest.4E57CCC63F2E0A11.title": "Crop Automation"
	"quest.4E5BE4B24397B9FE.quest_desc": [
		"Grow Willow saplings and fell the trees with &aMechanical Saws&r. Leaf blocks only drop to shears:"
		"try Deployers holding shears. Make a &astack&r of each."
	]
	"quest.4E5BE4B24397B9FE.title": "Automate: Willow"
	"quest.4E83FDAD16DA66F6.quest_desc": [
		"An illager &6airship&r on patrol finds your base. Shoot it down: autocannons and"
		"anti-air."
		"&aClick the checkmark when you're ready&r (quest edit mode OFF): the attack starts on the spot. Fight near your base."
	]
	"quest.4E83FDAD16DA66F6.title": "Wave 6: Patrol Airship"
	"quest.4EB5ADD78C50BDC2.quest_desc": [
		"&6Create: Bits 'n' Tracks&r: Sable-driven &atank treads&r. Check the Ponder for a track setup."
	]
	"quest.4EB5ADD78C50BDC2.title": "Tank Tread"
	"quest.4F0949D1FAB33BD1.quest_desc": [
		"An AP shot in a brass case: AP Shot, two brass sheets and packed guncotton. Firing leaves a"
		"&aSpent Cartridge Casing&r; reload it with an AP Shot and guncotton."
	]
	"quest.4F0949D1FAB33BD1.title": "BOPS Armor-Piercing Shell"
	"quest.4F2CCD3CA4F4ED74.quest_desc": [
		"Find wild tomatoes in warm biomes, cut them with a knife for seeds, and plant them."
	]
	"quest.4F2CCD3CA4F4ED74.title": "Tomato"
	"quest.4F2DB21B147A7C58.quest_desc": [
		"Diamonds and a lever. Gold to diamond."
	]
	"quest.4F2DB21B147A7C58.title": "Diamond Tier"
	"quest.4F41F56BD88F8594.quest_desc": [
		"Wash crushed zinc ore with a fan blowing through water. Make a &astack&r."
	]
	"quest.4F41F56BD88F8594.title": "Automate: Zinc Nugget"
	"quest.4F432EC45797F61B.quest_desc": [
		"Also from the stonecutter (iron block). Cheap cover for gun nests and trenches."
	]
	"quest.4F432EC45797F61B.title": "Sandbags"
	"quest.4F582B3F637B9DF4.quest_desc": [
		"The second reactor fuel: weaker than uranium, but it runs cooler."
	]
	"quest.4F582B3F637B9DF4.title": "Thorium"
	"quest.4FC33F44C920C77C.quest_desc": [
		"The Distillation Tower splits crude oil into fuels. &aGasoline&r is one of its outputs,"
		"and Napalm needs it."
	]
	"quest.4FC33F44C920C77C.title": "Gasoline"
	"quest.4FC97BFD3583B16A.quest_desc": [
		"The heavy infantry of the invasion."
	]
	"quest.4FC97BFD3583B16A.title": "Inquisitor"
	"quest.4FF0B24C57E15BD3.quest_desc": [
		"Andesite alloy, iron sheet, flint and steel and a stripped log: your first gun."
	]
	"quest.4FF0B24C57E15BD3.title": "Flintlock"
	"quest.500E380CBF65328A.quest_desc": [
		"Put &airon ingots&r on the Depot and let the Press flatten them into &aIron Sheets&r."
	]
	"quest.500E380CBF65328A.title": "Iron Sheets"
	"quest.505E04F6477F8763.quest_desc": [
		"Every quest under &aKinetic Parts&r is done: 9 production lines running on their own."
	]
	"quest.505E04F6477F8763.title": "Kinetic Parts Mastered"
	"quest.50697E645696804F.quest_desc": [
		"Bread, beef patty, a leafy green, tomato and onion. Make a &astack&r."
	]
	"quest.50697E645696804F.title": "Automate: Hamburger"
	"quest.50822B0BBA2CD21E.quest_desc": [
		"A transmitter, precision mechanism and compass. Fly drones wirelessly."
	]
	"quest.50822B0BBA2CD21E.title": "Drone Remote Controller"
	"quest.5083A2BCC04083A8.quest_desc": [
		"A mechanical piston, piston pole, shaft, brass casing and a sequenced"
		"gearshift. Pushes and pulls parts of your craft precisely."
	]
	"quest.5083A2BCC04083A8.title": "Hydraulic Linear Actuator"
	"quest.5089F68C0B1CFF8F.quest_desc": [
		"Every quest under &aFertilizer&r is done: 5 production lines running on their own."
	]
	"quest.5089F68C0B1CFF8F.title": "Fertilizer Mastered"
	"quest.5098E62B79F885D8.quest_desc": [
		"&6Enhanced AI&r: skeletons aim better and keep their distance. Fight from cover."
	]
	"quest.5098E62B79F885D8.title": "Snipers"
	"quest.50CD930018A90F12.quest_desc": [
		"Everything quantum starts in &dthe End&r: bring back &achorus fruit&r (and plant some)."
	]
	"quest.50CD930018A90F12.title": "Chorus Fruit"
	"quest.5116C8CBF8F4C26B.quest_desc": [
		"Andesite casing, piston pole and gunpowder. Pushes charges and shells into the breech."
	]
	"quest.5116C8CBF8F4C26B.title": "Cannon Loader"
	"quest.5152DA4587C8F7C0.quest_desc": [
		"A bigger illager band with an &5Evoker&r leader. Watch for fangs and vexes."
		"&aClick the checkmark when you're ready&r (quest edit mode OFF): the attack starts on the spot. Fight near your base."
	]
	"quest.5152DA4587C8F7C0.title": "Wave 3: Warband"
	"quest.515DC0FA59FD5614.quest_desc": [
		"Sticks and planks. Row a small boat by hand."
	]
	"quest.515DC0FA59FD5614.title": "Oar of Boat"
	"quest.516C1F6F3FFBD9C1.quest_desc": [
		"Mine iron ore with a &aMechanical Drill&r on a moving contraption. Make a &astack&r."
	]
	"quest.516C1F6F3FFBD9C1.title": "Automate: Raw Iron"
	"quest.51778DC1A4E7BF5F.quest_desc": [
		"Grow Empyreal saplings and fell the trees with &aMechanical Saws&r. Leaf blocks only drop to shears:"
		"try Deployers holding shears. Make a &astack&r of each."
	]
	"quest.51778DC1A4E7BF5F.title": "Automate: Empyreal"
	"quest.5194AC4C99BEB854.quest_desc": [
		"Mechanical crafting with a propeller and an impact fuze. Sinks ships."
	]
	"quest.5194AC4C99BEB854.title": "Sea Torpedo"
	"quest.51ABB649DF339B40.quest_desc": [
		"&aMechanical Crafting&r from enriched yellowcake. Reactor fuel, and the core of every"
		"nuclear shell."
	]
	"quest.51ABB649DF339B40.title": "Uranium Rod"
	"quest.51F7728E30F0B263.quest_desc": [
		"Grow Birch saplings and fell the trees with &aMechanical Saws&r. Leaf blocks only drop to shears:"
		"try Deployers holding shears. Make a &astack&r of each."
	]
	"quest.51F7728E30F0B263.title": "Automate: Birch"
	"quest.520CA4BA383F49EE.quest_desc": [
		"Grow Cherry saplings and fell the trees with &aMechanical Saws&r. Leaf blocks only drop to shears:"
		"try Deployers holding shears. Make a &astack&r of each."
	]
	"quest.520CA4BA383F49EE.title": "Automate: Cherry"
	"quest.521CA3B1F77D8E70.quest_desc": [
		"Sequenced assembly: sleepers, iron nuggets and zinc nuggets (makes 32 at a time). Create"
		"trains run on Train Track."
	]
	"quest.521CA3B1F77D8E70.title": "Train Track"
	"quest.5225776D1012E391.quest_desc": [
		"Four nuclear shells, end crystals and nether stars: a smaller thermonuclear shell."
	]
	"quest.5225776D1012E391.title": "Mini H-Bomb"
	"quest.52314BB35786FF3A.quest_desc": [
		"A fluid pipe and a cogwheel. Give it rotation and it pushes fluid along the pipe. Faster"
		"rotation pumps more."
	]
	"quest.52314BB35786FF3A.title": "Mechanical Pump"
	"quest.527B674EBDE64D78.quest_desc": [
		"&6Armored Constructs&r hull armor stops shells by its &atoughness&r and weighs the"
		"vehicle down by its &amass&r. Rolled steel is the baseline: steel, steel plates and a"
		"heavy plate, makes 8. A &astonecutter&r recolors any hull (15 camouflage patterns)."
	]
	"quest.527B674EBDE64D78.title": "Rolled Hull Armor"
	"quest.5282E7D30B7AA95C.quest_desc": [
		"Mixer: raw rabbit, carrot, potato, both mushrooms and a bowl. Make a &astack&r (16)."
	]
	"quest.5282E7D30B7AA95C.title": "Automate: Rabbit Stew"
	"quest.528466FC525F9B9E.quest_desc": [
		"Pumpkin, sugar and an egg (Mechanical Crafters). Make a &astack&r."
		""
		"&7Needs eggs from Animal Product Automation."
	]
	"quest.528466FC525F9B9E.title": "Automate: Pumpkin Pie"
	"quest.528707EC128E396E.quest_desc": [
		"Iron plates, copper, a note block and a shaft. Warn your base when bombers come."
	]
	"quest.528707EC128E396E.title": "Air-Raid Siren"
	"quest.52A00571472644AB.quest_desc": [
		"Mine copper ore with a Drill on a moving contraption. Make a &astack&r."
	]
	"quest.52A00571472644AB.title": "Automate: Raw Copper"
	"quest.52BE6EDACFC4FC5F.quest_desc": [
		"3 cooked mutton, 2 baked potatoes, 2 onions, milk and a bowl. Make &a4&r."
		""
		"&7Needs milk from Animal Product Automation."
	]
	"quest.52BE6EDACFC4FC5F.title": "Automate: Shepherd's Pie"
	"quest.5329946572EF2539.quest_desc": [
		"Press a &aBlock of Experience&r into an &aEnchanting Template&r."
	]
	"quest.5329946572EF2539.title": "Enchanting Template"
	"quest.5349BB8131A6B63D.quest_desc": [
		"Raw beef under a Slicer with a knife. Make a &astack&r."
	]
	"quest.5349BB8131A6B63D.title": "Automate: Minced Beef"
	"quest.537966C61051FF3E.quest_desc": [
		"Loop the sequenced assembly line so it runs unattended. Make a &astack&r of Precision"
		"Mechanisms."
	]
	"quest.537966C61051FF3E.title": "Automate: Precision Mechanisms"
	"quest.53A9557C86F6A159.quest_desc": [
		"A storage terminal with a crafting grid that pulls straight from the network."
	]
	"quest.53A9557C86F6A159.title": "Crafting Terminal"
	"quest.53C1D57D1C14787F.quest_desc": [
		"You've built the core Andesite machines. This &aunlocks the Brass Age&r, and the"
		"&6Automation&r chapter has goals for putting these machines to work."
		""
		"&7Requires: Press and Depot, Basin and Mixer, Belts and Iron Sheets.&r"
		""
		"Next up: you'll need a captured &cBlaze&r to make brass."
	]
	"quest.53C1D57D1C14787F.title": "Andesite Age Complete"
	"quest.53C388D6354E322F.quest_desc": [
		"An analog lever on brass casing with a transmitter: one tilt lever. The base for the yoke"
		"and throttle quadrant."
	]
	"quest.53C388D6354E322F.title": "Lever Module"
	"quest.53FCAEF396A40468.quest_desc": [
		"Sequenced assembly: Advanced Component, sturdy sheet and &dTelejuice&r. The heart of every"
		"teleporter."
	]
	"quest.53FCAEF396A40468.title": "Quantum Mechanism"
	"quest.540B75E0FDF7BF0F.quest_desc": [
		"Raw salmon through a smoking fan. Make a &astack&r."
	]
	"quest.540B75E0FDF7BF0F.title": "Automate: Cooked Salmon"
	"quest.542539A9D3F991D6.quest_desc": [
		"Much tougher, and lighter than steel: fireclay, heavy plates and a diamond."
	]
	"quest.542539A9D3F991D6.title": "Ceramic Hull Armor"
	"quest.5459DE3C6BCF979E.quest_desc": [
		"See under water. (A different block from the Air War sonar.)"
	]
	"quest.5459DE3C6BCF979E.title": "Sonar (Deep Seas)"
	"quest.545D0853A4D87489.quest_desc": [
		"&aCreate: Fishery Industry&r. A Frame Trap (zinc sheet and string) on a moving contraption, such"
		"as a &aTrap Bearing&r spinning it through water, catches fish and pulls up fishing loot that"
		"depends on the biome. No rod, no player."
	]
	"quest.545D0853A4D87489.title": "Frame Trap"
	"quest.5480C8B5E1657A00.quest_desc": [
		"Brass and iron sheets. Holds a belt of autocannon rounds for continuous fire."
	]
	"quest.5480C8B5E1657A00.title": "Autocannon Ammo Container"
	"quest.54A10483D0EE3E7F.quest_desc": [
		"&6Create: High Seas&r. Boats are Sable physics objects too (see the Physics Assembler in"
		"Aeronautics). A rudder steers."
	]
	"quest.54A10483D0EE3E7F.title": "Rudder"
	"quest.54DE44FFAE0A9DDE.quest_desc": [
		"&6Sophisticated Backpacks&r: leather, string and a chest. Wear it or place it."
	]
	"quest.54DE44FFAE0A9DDE.title": "Backpack"
	"quest.54F28171B8869203.quest_desc": [
		"Made with an iron sheet. A &aMechanical Harvester&r on a moving contraption harvests"
		"fully grown crops and replants them: the basis of any farm."
	]
	"quest.54F28171B8869203.title": "Mechanical Harvester"
	"quest.55133A80FE1B9D72.quest_desc": [
		"Break tall grass or wheat with a knife."
	]
	"quest.55133A80FE1B9D72.title": "Straw"
	"quest.55265CE7787A5196.quest_desc": [
		"An &aEncased Fan&r blowing through fire smokes food on belts and depots."
	]
	"quest.55265CE7787A5196.title": "Fan Cooking"
	"quest.558B1890C605987A.quest_desc": [
		"Mine titanium ore with a Drill on a moving contraption. Make a &astack&r."
	]
	"quest.558B1890C605987A.title": "Automate: Raw Titanium"
	"quest.5595EF082B5BFD12.quest_desc": [
		"Copper and a gold sheet. Put it on a boiler; redstone blows it. Taller stacks play lower."
	]
	"quest.5595EF082B5BFD12.title": "Steam Whistle"
	"quest.55D36CF33F3CCCBB.quest_desc": [
		"Mill wheat into flour, mix flour and water into dough, then bake it with an encased fan"
		"blowing through fire. Make a &astack&r."
	]
	"quest.55D36CF33F3CCCBB.title": "Automate: Bread"
	"quest.55D4A5D306F241A6.quest_desc": [
		"Every Andesite-tier material and part, made by machines. The foundation of every factory."
	]
	"quest.55D4A5D306F241A6.title": "Andesite Mastered"
	"quest.55F313C195066158.quest_desc": [
		"Mill or crush granite. Make a &astack&r."
	]
	"quest.55F313C195066158.title": "Automate: Red Sand"
	"quest.5616C2CB21D1F5E0.quest_desc": [
		"An impact fuze head and redstone (makes 2). Goes off on contact. Put a fuze on a shell"
		"before you load it."
	]
	"quest.5616C2CB21D1F5E0.title": "Impact Fuze"
	"quest.563C4DBA93D8EADA.quest_desc": [
		"Copper casing, a copper sheet and a dried kelp block. Lowers a hose to drain a lake or"
		"lava pool, or to fill one. Large bodies of water never run dry."
	]
	"quest.563C4DBA93D8EADA.title": "Hose Pulley"
	"quest.5654679C05A47678.quest_desc": [
		"&aLevitite&r provides lift: build it into a hull to make it float."
	]
	"quest.5654679C05A47678.title": "Levitite"
	"quest.56744B93E8B9829C.quest_desc": [
		"A chute, brass sheets and an electron tube on Mechanical Crafters. Make a &astack&r."
	]
	"quest.56744B93E8B9829C.title": "Automate: Smart Chute"
	"quest.56B896874512C7F2.quest_desc": [
		"Farmer, Chef and Rancher. Your faction never goes hungry again."
	]
	"quest.56B896874512C7F2.title": "Feed the Army"
	"quest.56BFFCE6BD56FE57.quest_desc": [
		"Sweet berry bushes regrow after picking. Keep them picked without hands. Make a &astack&r."
	]
	"quest.56BFFCE6BD56FE57.title": "Automate: Sweet Berries"
	"quest.56C06FAADEC153C4.quest_desc": [
		"A &aBlaze Burner&r (Brass Age), brass and iron sheets. Welds built-up cannon parts"
		"together."
	]
	"quest.56C06FAADEC153C4.title": "Cannon Welder"
	"quest.56DD42619431371D.quest_desc": [
		"Iron sheets and a stripped log. A longer flintlock barrel: more range."
	]
	"quest.56DD42619431371D.title": "Musket Barrel"
	"quest.5737E93025848C2B.quest_desc": [
		"Wash magma blocks with a fan blowing through water. Make a &astack&r."
	]
	"quest.5737E93025848C2B.title": "Automate: Obsidian"
	"quest.5759D788625EA06F.quest_desc": [
		"Crush Nether Bricks (the block): each has a 5% chance of scrap. Make a &astack&r."
	]
	"quest.5759D788625EA06F.title": "Automate: Netherite Scrap"
	"quest.57698FA008794B58.quest_desc": [
		"Raw salmon under a Slicer with a knife. Make a &astack&r."
	]
	"quest.57698FA008794B58.title": "Automate: Raw Salmon Slice"
	"quest.57B7CCC186625ABD.quest_desc": [
		"Build the Pumpjack over an oil deposit (find one with the Surface Scanner) and pump"
		"&aCrude Oil&r into a tank. Fill a bucket from the tank."
	]
	"quest.57B7CCC186625ABD.title": "Crude Oil"
	"quest.58136A6ECBF2CA4A.quest_desc": [
		"Mount blades on a &aPropeller Bearing&r and spin it for thrust."
	]
	"quest.58136A6ECBF2CA4A.title": "Propeller Bearing"
	"quest.58281E71C2982F6E.quest_desc": [
		"&6CBC Ballistic Computer&r: brass casing, electron tube, precision mechanism, shaft and a"
		"display board. Calculates the trajectory so you hit what you aim at."
		"&eNeeds the Brass Age.&r Automate brass (Automation chapter) to keep these guns fed."
	]
	"quest.58281E71C2982F6E.title": "Ballistic Computer"
	"quest.585243261D118217.quest_desc": [
		"&eThis pack's own recipe:&r diamonds are compacted from coal over a &6superheated&r burner."
	]
	"quest.585243261D118217.title": "Diamonds"
	"quest.58601A41B035E394.quest_desc": [
		"Right-click a placed chest or barrel with a tier upgrade to make it bigger &awithout"
		"emptying it&r. Copper first (copper ingots and a lever), then up the tiers."
	]
	"quest.58601A41B035E394.title": "Chest Tier Upgrades"
	"quest.591FA47EC216B85D.quest_desc": [
		"Some recipes need a &6Superheated&r burner. This pack has three fuel tiers, and each one"
		"needs superheat to produce, so you climb them in order:"
		""
		"&61. Blaze Cake&r: 2 min 40 s per cake"
		"&62. Biofuel&r: 20 min per bucket"
		"&63. Napalm&r: 1 hour per bucket (made in the &6Industrial Age&r)"
	]
	"quest.591FA47EC216B85D.title": "Fuel Tiers"
	"quest.593880FB761DDE5A.quest_desc": [
		"Mechanical crafting: precision mechanism, electron tube, brass and sturdy sheets, a"
		"propeller, a powder charge, guncotton and an impact fuze."
	]
	"quest.593880FB761DDE5A.title": "Cruise Missile"
	"quest.594D0103D8307571.quest_desc": [
		"Shafts, cogs, belts, casings and the logistics parts every factory is built from."
	]
	"quest.594D0103D8307571.title": "Kinetic Parts"
	"quest.596283CCE38214A8.quest_desc": [
		"Grow Maple saplings and fell the trees with &aMechanical Saws&r. Leaf blocks only drop to shears:"
		"try Deployers holding shears. Make a &astack&r of each."
	]
	"quest.596283CCE38214A8.title": "Automate: Maple"
	"quest.597A3E429F55275A.quest_desc": [
		"Train Casing and a wooden door (makes 2). Doors that work on a moving train."
	]
	"quest.597A3E429F55275A.title": "Train Door"
	"quest.598BE4ADE1531AFA.quest_desc": [
		"&6Create: High Seas&r: a blast furnace, a propeller and a lever. Burns fuel to drive"
		"your boat."
	]
	"quest.598BE4ADE1531AFA.title": "Boat Engine"
	"quest.59AC3D4CC846EDAF.quest_desc": [
		"Every raw meat and fish."
	]
	"quest.59AC3D4CC846EDAF.title": "Meats"
	"quest.59ACD0A7F0415F39.quest_desc": [
		"A &aMechanical Peeler&r peels raw salmon into a steak and fish skin. Make a &astack&r."
	]
	"quest.59ACD0A7F0415F39.title": "Automate: Salmon Steak"
	"quest.59C4C64E295DD12D.quest_desc": [
		"A mechanical pump, a copper block and a propeller. A water jet for fine maneuvering."
	]
	"quest.59C4C64E295DD12D.title": "Water Thruster"
	"quest.59C7A4B8DD096B55.quest_desc": [
		"A Propeller Bearing and a Gimbal Sensor. Tilts its rotor to steer the drone."
	]
	"quest.59C7A4B8DD096B55.title": "Tilting Propeller Bearing"
	"quest.5A3BA4624706AB01.quest_desc": [
		"Industrial iron, an electron tube and a lightning rod."
	]
	"quest.5A3BA4624706AB01.title": "Radar Receiver"
	"quest.5AD983ACCE696260.quest_desc": [
		"Mixer: raw chicken, carrot, a leafy green, any vegetable but melon, and a bowl."
		"Make a &astack&r (16)."
	]
	"quest.5AD983ACCE696260.title": "Automate: Chicken Soup"
	"quest.5AFAAE84D66D6BA3.quest_desc": [
		"Thin air down here too (see Pollution and Air): bring a backtank."
	]
	"quest.5AFAAE84D66D6BA3.title": "Into the Nether"
	"quest.5B0A036B4AB20650.quest_desc": [
		"Stonecut an iron ingot. A Press with this form stamps shotgun shells."
	]
	"quest.5B0A036B4AB20650.title": "Shotgun Shell Press Form"
	"quest.5B0AB69264381253.quest_desc": [
		"Adds a &aprecision mechanism&r and a cogwheel to the steel-and-brass build."
	]
	"quest.5B0AB69264381253.title": "Gatling"
	"quest.5B24BCB91BBD80FB.quest_desc": [
		"&6Tom's Simple Storage&r is this pack's storage network. The &aInventory Connector&r"
		"joins every touching chest, barrel and vault into one network. Needs a diamond and an"
		"ender pearl."
	]
	"quest.5B24BCB91BBD80FB.title": "Inventory Connector"
	"quest.5B2A171A8BB00B84.quest_desc": [
		"Iron, bricks and a campfire. The heat source for pots and skillets."
	]
	"quest.5B2A171A8BB00B84.title": "Stove"
	"quest.5B90707D8FDB5662.quest_desc": [
		"Train Casing and a pressure plate. Outputs redstone when a train passes."
	]
	"quest.5B90707D8FDB5662.title": "Train Observer"
	"quest.5B9696024A7D8AC9.quest_desc": [
		"Items you walk over go straight into the backpack."
	]
	"quest.5B9696024A7D8AC9.title": "Pickup Upgrade"
	"quest.5BC063A06F708BDE.quest_desc": [
		"A crafter slot cover, planks and a transmitter. The submarine's command console: drive and"
		"dive from here."
	]
	"quest.5BC063A06F708BDE.title": "Onboard Computer"
	"quest.5BE3FC9AB4DF6169.quest_desc": [
		"Every food in the pack, made by machines. The army eats well."
	]
	"quest.5BE3FC9AB4DF6169.title": "Master Chef"
	"quest.5BFC740EF1842F8A.quest_desc": [
		"Mixer: mussels and milk make the soup; a Spout fills bowls. Make a &astack&r."
		""
		"&7Needs milk from Animal Product Automation."
	]
	"quest.5BFC740EF1842F8A.title": "Automate: Mussel Soup"
	"quest.5C17E0C5F99D8D6D.quest_desc": [
		"A baked potato, cooked beef and milk. Make a &astack&r."
		""
		"&7Needs milk from Animal Product Automation."
	]
	"quest.5C17E0C5F99D8D6D.title": "Automate: Stuffed Potato"
	"quest.5C326BE896F9406D.quest_desc": [
		"The furnace makes &amolten steel&r; cast it into &aSteel Ingots&r."
	]
	"quest.5C326BE896F9406D.title": "Steel"
	"quest.5C8808451971B4AC.quest_desc": [
		"Raw bacon through a smoking fan. Make a &astack&r."
	]
	"quest.5C8808451971B4AC.title": "Automate: Cooked Bacon"
	"quest.5C8F73A18227EF75.quest_desc": [
		"&6Steam 'n' Rails&r adds more to trains: a handcar for quick trips."
	]
	"quest.5C8F73A18227EF75.title": "Handcar"
	"quest.5CB151858BB0EC67.quest_desc": [
		"Zombies and skeletons probe your walls."
		"&aClick the checkmark when you're ready&r (quest edit mode OFF): the attack starts on the spot. Fight near your base."
	]
	"quest.5CB151858BB0EC67.title": "Wave 1: Scouting Party"
	"quest.5D03F1D941E5D2B8.quest_desc": [
		"Made with iron sheets. A &aMechanical Drill&r mines whatever is in front of it: the heart"
		"of cobblestone generators and tunnel borers."
	]
	"quest.5D03F1D941E5D2B8.title": "Mechanical Drill"
	"quest.5D19704DF98EF7C1.quest_desc": [
		"The strongest barrels are &abuilt up&r from steel layers with a Cannon Builder, then"
		"bored with a Cannon Drill. Check the Ponder."
	]
	"quest.5D19704DF98EF7C1.title": "Built-Up Steel Cannon"
	"quest.5D4BCA7941DD7B93.quest_desc": [
		"Copper casing and iron bars. Empties buckets, bottles and potions dropped on it into the"
		"pipes below."
	]
	"quest.5D4BCA7941DD7B93.title": "Item Drain"
	"quest.5DDF8A5926B033B1.quest_desc": [
		"Wheat and cocoa beans (Mechanical Crafters). Make a &astack&r."
	]
	"quest.5DDF8A5926B033B1.title": "Automate: Cookie"
	"quest.5DFDB0F445DCDD6B.quest_desc": [
		"Every quest under &aMetals&r is done: 5 production lines running on their own."
	]
	"quest.5DFDB0F445DCDD6B.title": "Metals Mastered"
	"quest.5E4C130E5B208860.quest_desc": [
		"&6Create: Armored Constructs&r: a tank gun. Assemble Breech, Barrel sections, an"
		"Intermediate Muzzle and a Muzzle in a line. Pack recipes (the mod ships without any):"
		"&aMechanical Crafting&r from heavy plates and steel. Barrels come 2 at a time."
	]
	"quest.5E4C130E5B208860.title": "Arcon Cannon Barrel"
	"quest.5F2D60AF89DE6ABE.quest_desc": [
		"Eggs through a smoking fan. Make a &astack&r (16)."
		""
		"&7Needs eggs from Animal Product Automation."
	]
	"quest.5F2D60AF89DE6ABE.title": "Automate: Fried Egg"
	"quest.5F40C639C270FBD0.quest_desc": [
		"Bastion guards. They never calm down."
	]
	"quest.5F40C639C270FBD0.title": "Piglin Brute"
	"quest.5F57791FE7C5E54E.quest_desc": [
		"Mechanical crafting: brass and steel sheets, andesite alloy and a stripped log."
	]
	"quest.5F57791FE7C5E54E.title": "Shotgun"
	"quest.5FC5AF17035E86EE.quest_desc": [
		"Throws potions. Kill it before it supports the rest."
	]
	"quest.5FC5AF17035E86EE.title": "Alchemist"
	"quest.5FEBCACF7850D1AD.quest_desc": [
		"Raw porkchops through a smoking fan. Make a &astack&r."
	]
	"quest.5FEBCACF7850D1AD.title": "Automate: Cooked Porkchop"
	"quest.601B2FCAF5026C70.quest_desc": [
		"Iron sheets and netherrack on Mechanical Crafters. Make a &astack&r."
	]
	"quest.601B2FCAF5026C70.title": "Automate: Empty Blaze Burner"
	"quest.603877210C605F5D.quest_desc": [
		"Mixer: raw beef, carrot, potato and a bowl. Make a &astack&r (16)."
	]
	"quest.603877210C605F5D.title": "Automate: Beef Stew"
	"quest.60475C6A23C1B8CF.quest_desc": [
		"Mine sulfur ore with a Drill on a moving contraption. Make a &astack&r."
	]
	"quest.60475C6A23C1B8CF.title": "Automate: Raw Sulfur"
	"quest.60A8E36CAE45E950.quest_desc": [
		"&eThis pack's own recipe:&r &aCrushing Wheels&r crushing &aNether Bricks&r (the block) have a"
		"&a5% chance&r to drop &aNetherite Scrap&r. Netherrack is endless, so this is renewable."
		"(Ancient Debris blown through lava with a fan works too.)"
		""
		"Then let &aMechanical Crafters&r run the normal recipe: &a4 Netherite Scrap + 4 Gold Ingots&r"
		"= 1 Netherite Ingot. Make a &astack&r of Netherite Ingots."
	]
	"quest.60A8E36CAE45E950.title": "Automate: Netherite"
	"quest.60AC9F2A33E18216.quest_desc": [
		"Crush obsidian with Crushing Wheels. Make a &astack&r."
	]
	"quest.60AC9F2A33E18216.title": "Automate: Powdered Obsidian"
	"quest.60B7B7F88377BDD8.quest_desc": [
		"All three fuel tiers on tap. Your burners never go cold."
	]
	"quest.60B7B7F88377BDD8.title": "Heat Automation Mastered"
	"quest.60B90AF4C95E818F.quest_desc": [
		"Mix &acopper&r and &azinc&r in a Basin over a lit Blaze Burner."
	]
	"quest.60B90AF4C95E818F.title": "Brass Ingot"
	"quest.60C65DE73B4B6054.quest_desc": [
		"Wash soul sand with a fan blowing through water. Make a &astack&r."
	]
	"quest.60C65DE73B4B6054.title": "Automate: Nether Quartz"
	"quest.60FAD498BD32289F.quest_desc": [
		"Sequenced assembly and the parts it needs."
	]
	"quest.60FAD498BD32289F.title": "Precision"
	"quest.60FCA6A7CAC5BEBF.quest_desc": [
		"Press coal dust."
	]
	"quest.60FCA6A7CAC5BEBF.title": "Graphene"
	"quest.610E62DABE42F45B.quest_desc": [
		"Crush &azinc ore&r, wash the crushed ore with a fan, and smelt it. Make a &astack&r of Zinc"
		"Ingots."
	]
	"quest.610E62DABE42F45B.title": "Automate: Zinc Ingot"
	"quest.6112990A4F373F3B.quest_desc": [
		"Compact &aseeds&r into Seed Oil, then mix plants (crops, leaves, saplings, flowers) with"
		"&a100 mB of Seed Oil&r over a &6heated&r burner to make &aBiomass&r."
	]
	"quest.6112990A4F373F3B.title": "Biomass"
	"quest.6117481665174663.quest_desc": [
		"&6Create: Slice and Dice&r: a cogwheel, andesite casing and turntable. Put a knife in it"
		"and it runs &acutting board recipes&r on items below it, like a press on a depot or belt."
		"Check the Ponder."
	]
	"quest.6117481665174663.title": "Slicer"
	"quest.614588AD6D3684C0.quest_desc": [
		"Add a lead nugget to a blank round."
	]
	"quest.614588AD6D3684C0.title": "Revolver Round"
	"quest.61EA0CE43165502E.quest_desc": [
		"Fly it yourself: a &aSteering Wheel&r on your craft lets you steer from the seat."
	]
	"quest.61EA0CE43165502E.title": "Steering Wheel"
	"quest.6219439BB6C5DA8A.quest_desc": [
		"&eThis pack's recipe:&r a &6superheated&r Mixer with biofuel, gasoline and an aluminum ingot."
		"A Spout fills buckets. Fill &a16&r."
	]
	"quest.6219439BB6C5DA8A.title": "Automate: Napalm"
	"quest.623D285040FF4D37.quest_desc": [
		"A Press over a basin compacts 9 zinc ingots into a block. Make a &astack&r."
	]
	"quest.623D285040FF4D37.title": "Automate: Block of Zinc"
	"quest.628849AB04278591.quest_desc": [
		"Brass sheet, compass, electron tube, steel and precision mechanism: steers the missile"
		"onto a radar track."
	]
	"quest.628849AB04278591.title": "Guidance Computer"
	"quest.62C2BF76845D80A0.quest_desc": [
		"A &aBasin&r holds ingredients; a &aMechanical Mixer&r above it mixes them, and a Press"
		"above it compacts them. Many recipes need &6heat&r from a burner under the basin; you'll"
		"get there in the next two chapters."
	]
	"quest.62C2BF76845D80A0.title": "Basin and Mixer"
	"quest.62D79935090F608A.quest_desc": [
		"Built from &afireproof bricks&r with a &aBlast Furnace Output&r (cast iron block, pipe) and"
		"a hatch. Check the Ponder for the full multiblock."
	]
	"quest.62D79935090F608A.title": "Blast Furnace"
	"quest.62E11FB1B49183D9.quest_desc": [
		"Slowness arrows in cold biomes."
	]
	"quest.62E11FB1B49183D9.title": "Strays"
	"quest.62E731AF8B737E44.quest_desc": [
		"Soul soil, obsidian and a &5Nether Star&r."
	]
	"quest.62E731AF8B737E44.title": "Enriched Soul Soil"
	"quest.62E99830472736C1.quest_desc": [
		"Iron sheets: flat radar panels."
	]
	"quest.62E99830472736C1.title": "Radar Plate"
	"quest.6306F2A0E0D78360.quest_desc": [
		"Sequenced assembly with heavy plates, lead and nickel sheets, steel cogwheels and screws."
		"JEI shows every step."
	]
	"quest.6306F2A0E0D78360.title": "Steel Mechanism"
	"quest.6329826148B7D2C8.quest_desc": [
		"2 cod rolls, 3 salmon rolls, 3 kelp roll slices and a bowl. Make &a4&r."
	]
	"quest.6329826148B7D2C8.title": "Automate: Rice Roll Medley"
	"quest.635B592E27A35F35.quest_desc": [
		"Spout liquid fertilizer onto organic compost. Make a &astack&r."
	]
	"quest.635B592E27A35F35.title": "Automate: Rich Soil"
	"quest.636673A39A09D339.quest_desc": [
		"Gunpowder, iron plate, shot balls and a pressure plate."
	]
	"quest.636673A39A09D339.title": "Small Mine"
	"quest.636A79EE6234A536.quest_desc": [
		"Raw mutton through a smoking fan. Make a &astack&r."
	]
	"quest.636A79EE6234A536.title": "Automate: Cooked Mutton"
	"quest.6393779977E23D30.quest_desc": [
		"Redstone torch, lever, copper and iron plate. Sets off your C4."
	]
	"quest.6393779977E23D30.title": "Detonator"
	"quest.63D88DAF707C6F45.quest_desc": [
		"Raw titanium through a lava fan. Make a &astack&r."
	]
	"quest.63D88DAF707C6F45.title": "Automate: Titanium Ingot"
	"quest.63E3C2A3C78A67C7.quest_desc": [
		"Fishing loot: a &aFrame Trap&r on a moving contraption in water pulls up mussels. Make a &astack&r."
	]
	"quest.63E3C2A3C78A67C7.title": "Automate: Raw Blue Mussel"
	"quest.64156283A7F5D425.quest_desc": [
		"Press brass ingots into &aBrass Sheets&r on a Depot, like iron and gold."
	]
	"quest.64156283A7F5D425.title": "Brass Sheets"
	"quest.647DFE7493DF2C42.quest_desc": [
		"Every tree in the pack, vanilla and Biomes O' Plenty: a stack of logs and a stack of leaves each."
	]
	"quest.647DFE7493DF2C42.title": "Forestry"
	"quest.64F6FE46093FADEA.quest_desc": [
		"Clay balls through a lava fan. Make a &astack&r."
	]
	"quest.64F6FE46093FADEA.title": "Automate: Brick"
	"quest.6531378A87245AF5.quest_desc": [
		"Every quest under &aNetherite&r is done: 3 production lines running on their own."
	]
	"quest.6531378A87245AF5.title": "Netherite Mastered"
	"quest.653667B88343242F.quest_desc": [
		"Iron and brass sheets. Fixes to the flintlock for when they get too close."
	]
	"quest.653667B88343242F.title": "Bayonet"
	"quest.658409F99B53650B.quest_desc": [
		"A basalt generator: lava flowing over soul soil next to blue ice. A Drill mines it. Make a &astack&r."
	]
	"quest.658409F99B53650B.title": "Automate: Basalt"
	"quest.658C20D3D998E1FC.quest_desc": [
		"Crush or mill charcoal."
	]
	"quest.658C20D3D998E1FC.title": "Charcoal Dust"
	"quest.65B386CAEB47A994.quest_desc": [
		"&6Synaxis&r: precision controls for Sable craft (circuits, Lua, motors and actuators)."
	]
	"quest.65B386CAEB47A994.title": "Control Chair"
	"quest.65CB28479847E870.quest_desc": [
		"Crush copper ore or raw copper (veridium works too). Make a &astack&r."
	]
	"quest.65CB28479847E870.title": "Automate: Crushed Raw Copper"
	"quest.65D8A2AD77A82C98.quest_desc": [
		"Every quest under &aFan Cooking&r is done: 16 production lines running on their own."
	]
	"quest.65D8A2AD77A82C98.title": "Fan Cooking Mastered"
	"quest.65F25EDB14626C44.quest_desc": [
		"Crush coal ore with Crushing Wheels. Make a &astack&r."
	]
	"quest.65F25EDB14626C44.title": "Automate: Coal"
	"quest.661BA95EC4E158D5.quest_desc": [
		"Carrot, potato, beetroot and a leafy green in the Cooking Pot."
	]
	"quest.661BA95EC4E158D5.title": "Vegetable Soup"
	"quest.6629BCD414634293.quest_desc": [
		"Every Warnautics explosive uses &aPacked Guncotton&r, Big Cannons' high explosive"
		"(check JEI for how it's made)."
	]
	"quest.6629BCD414634293.title": "Packed Guncotton"
	"quest.663AB5DC04610255.quest_desc": [
		"Harvester rows, same as wheat. Make a &astack&r."
	]
	"quest.663AB5DC04610255.title": "Automate: Beetroot"
	"quest.663C120074F50910.quest_desc": [
		"A waystone shared by everyone who uses the same color. Uses Quantum Casings too."
	]
	"quest.663C120074F50910.title": "Sharestone"
	"quest.663EC1BF344C859B.quest_desc": [
		"Copper and a brass nugget. Call your train to you."
	]
	"quest.663EC1BF344C859B.title": "Conductor Whistle"
	"quest.66447527701EAC29.quest_desc": [
		"An arrow and copper. Shows which way the wind blows, for sailing."
	]
	"quest.66447527701EAC29.title": "Wind Vane"
	"quest.666707D21D56B27F.quest_desc": [
		"Engineer's Goggles, an electron tube and red glass. Shows water pressure at a"
		"glance."
	]
	"quest.666707D21D56B27F.title": "Pressure Goggles"
	"quest.669054B8698F5052.quest_desc": [
		"An Andesite Propeller and a Gimbal Sensor (makes 4). Drone lift and thrust."
	]
	"quest.669054B8698F5052.title": "Drone Propeller"
	"quest.66C3EC98853BC5DF.quest_desc": [
		"&6CBC Aeronautics Missiles&r: brass casing, steel, iron sheet and precision mechanism."
		"Launches guided missiles."
	]
	"quest.66C3EC98853BC5DF.title": "Missile Mount"
	"quest.66D223D025853928.quest_desc": [
		"2 raw salmon slices and cooked rice. Make a &astack&r."
	]
	"quest.66D223D025853928.title": "Automate: Salmon Roll"
	"quest.672CFFCB4514583D.quest_desc": [
		"Mushrooms on &arich soil&r grow into colonies. A &aSlicer&r with a knife cuts a colony into"
		"mushrooms. Make a &astack&r."
	]
	"quest.672CFFCB4514583D.title": "Automate: Red Mushroom"
	"quest.672FD2FD5E0B970A.quest_desc": [
		"A &aBasic Torpedo&r fixed to a &aRocket Bracket&r with two iron sheets (pack recipe)."
		"Dropped from aircraft into water, it runs to the target like a ship's torpedo."
	]
	"quest.672FD2FD5E0B970A.title": "Aerial Torpedo"
	"quest.67454231A804793A.quest_desc": [
		"The Coke Oven bakes &acoal&r into &aCoal Coke&r, the fuel for the blast furnace."
	]
	"quest.67454231A804793A.title": "Coal Coke"
	"quest.674633D31D85B876.quest_desc": [
		"&aAndesite Casing&r, a &aBrass Hand&r and an &aElectron Tube&r. A Deployer uses items like"
		"a player (placing, clicking, applying), and it's the key machine for sequenced assembly."
	]
	"quest.674633D31D85B876.title": "Deployer"
	"quest.67909118375EA207.quest_desc": [
		"Mine gold ore with a Drill on a moving contraption. Make a &astack&r."
	]
	"quest.67909118375EA207.title": "Automate: Raw Gold"
	"quest.679F6C0F323E288F.quest_desc": [
		"Convert an Andesite Propeller in a crafting grid. Light, cheap blades."
	]
	"quest.679F6C0F323E288F.title": "Wooden Propeller"
	"quest.67A8D26B5BBD67D5.quest_desc": [
		"Feed copper and zinc into a heated Mixer automatically. Make a &astack&r of Brass Ingots."
	]
	"quest.67A8D26B5BBD67D5.title": "Automate: Brass"
	"quest.680153DBEF875C5B.quest_desc": [
		"Bread, cooked chicken, a leafy green and carrot. Make a &astack&r."
	]
	"quest.680153DBEF875C5B.title": "Automate: Chicken Sandwich"
	"quest.680455D7BB0E4A30.quest_desc": [
		"Mixer: raw lobster, kelp and milk make the soup; a Spout fills bowls. Make a &astack&r."
		""
		"&7Needs milk from Animal Product Automation."
	]
	"quest.680455D7BB0E4A30.title": "Automate: Lobster Soup"
	"quest.681D7475EC18C5EA.quest_desc": [
		"A propeller, industrial iron and a shaft. Thrust under water."
	]
	"quest.681D7475EC18C5EA.title": "Submarine Propeller"
	"quest.6831CB5CFFFE83CA.quest_desc": [
		"Casings make machines tidy and are an ingredient in many recipes, including &dwaystones&r."
	]
	"quest.6831CB5CFFFE83CA.title": "Andesite Casing"
	"quest.683A03C336C4155F.quest_desc": [
		"Generators and drills: every stone the Andesite Age needs, without a pickaxe."
	]
	"quest.683A03C336C4155F.title": "Stone"
	"quest.688E209D19AE83F9.quest_desc": [
		"Dough under a Slicer with a knife. Dough: mill wheat into flour, then mix it with water."
		"Make a &astack&r."
	]
	"quest.688E209D19AE83F9.title": "Automate: Raw Pasta"
	"quest.689AB4054B803CCE.quest_desc": [
		"Uses a &aMechanical Arm&r: pick targets for your missiles."
	]
	"quest.689AB4054B803CCE.title": "Targeting Interface"
	"quest.689BC375391396D1.quest_desc": [
		"Crush emerald ore with Crushing Wheels. Make a &astack&r."
	]
	"quest.689BC375391396D1.title": "Automate: Emerald"
	"quest.68D51CBA48CE2950.quest_desc": [
		"Spout milk into glass bottles. Make a &astack&r (16)."
		""
		"&7Needs milk from Animal Product Automation."
	]
	"quest.68D51CBA48CE2950.title": "Automate: Milk Bottle"
	"quest.690304EEF8A85B66.quest_desc": [
		"The first Create material. Combine &aandesite&r with &airon nuggets&r (or zinc nuggets)."
		"Check &aJEI&r for the recipe: press &aU&r on an item to see how it's made."
	]
	"quest.690304EEF8A85B66.title": "Andesite Alloy"
	"quest.693C138BD4F5203A.quest_desc": [
		"2 raw cod slices and cooked rice. Make a &astack&r."
	]
	"quest.693C138BD4F5203A.title": "Automate: Cod Roll"
	"quest.6965B2C1A9D2D96A.quest_desc": [
		"Heats basins and boilers with liquid fuel. Very dirty on waste oil, clean on refined oil."
	]
	"quest.6965B2C1A9D2D96A.title": "Oil Burner"
	"quest.69751AD0E2419B9B.quest_desc": [
		"Brass casing, a capacitor, copper rods and electrum wire (roll electrum). Stores electricity. Blocks placed"
		"together act as one battery."
	]
	"quest.69751AD0E2419B9B.title": "Modular Accumulator"
	"quest.69950202A01FD5DC.quest_desc": [
		"Quartz and 5 redstone on Mechanical Crafters. Make a &astack&r."
	]
	"quest.69950202A01FD5DC.title": "Automate: Rose Quartz"
	"quest.6A0F5E3A470D0D6D.quest_desc": [
		"Brass casing, electron tube, Quantum Mechanism and Redstone Pearl. Fill it with"
		"&dTelejuice&r to teleport to a paired destination."
	]
	"quest.6A0F5E3A470D0D6D.title": "Entity Teleporter"
	"quest.6A3136FC8C67D6A5.quest_desc": [
		"Copper, glass panes and string. Spot targets by eye before you track them by radar."
	]
	"quest.6A3136FC8C67D6A5.title": "Binoculars"
	"quest.6A366BF3D0EF732F.quest_desc": [
		"Mixer: a pumpkin, rice, potato, onion, a brown mushroom, a berry and any vegetable"
		"but melon. Make &a4&r."
	]
	"quest.6A366BF3D0EF732F.title": "Automate: Stuffed Pumpkin"
	"quest.6A6B77129E1AEFE3.quest_desc": [
		"Steak, a baked potato, cooked rice, onion and a bowl. Make a &astack&r (16)."
	]
	"quest.6A6B77129E1AEFE3.title": "Automate: Steak and Potatoes"
	"quest.6A6F2AAAB71A2CDF.quest_desc": [
		"Ores don't regrow: a &aMechanical Drill&r on a moving contraption (a mining rig or tunnel bore) brings"
		"them in."
	]
	"quest.6A6F2AAAB71A2CDF.title": "Mining"
	"quest.6A815378A5DE98C6.quest_desc": [
		"&6Create Deep Seas&r. Flood and empty &aBallast Tanks&r to dive and surface."
	]
	"quest.6A815378A5DE98C6.title": "Ballast Tank"
	"quest.6A99365878ECA1A9.quest_desc": [
		"Two tomatoes and a bowl in the Cooking Pot (or a Create mixer)."
	]
	"quest.6A99365878ECA1A9.title": "Tomato Sauce"
	"quest.6AF6E11AB857B769.quest_desc": [
		"&aPolished Rose Quartz&r on an &aIron Sheet&r: the 'circuit' of Create machines."
	]
	"quest.6AF6E11AB857B769.title": "Electron Tube"
	"quest.6B217BD4AED205D0.quest_desc": [
		"A &6superheated&r Mixer melts cobblestone into lava (50 mB a block). A Spout fills"
		"buckets. Fill &a16&r."
	]
	"quest.6B217BD4AED205D0.title": "Automate: Lava"
	"quest.6B3AD946BC615531.quest_desc": [
		"A &aSpout&r fills food with honey, milk, chocolate and tea."
	]
	"quest.6B3AD946BC615531.title": "Spout"
	"quest.6B3BCED1EA271A59.quest_desc": [
		"A fan blowing through &alava&r smelts, through &afire&r smokes."
	]
	"quest.6B3BCED1EA271A59.title": "Fan Processing"
	"quest.6B8992B54A88BAD0.quest_desc": [
		"Mixer: pasta, raw fish, tomato, an ink sac and a bowl. Make a &astack&r (16)."
	]
	"quest.6B8992B54A88BAD0.title": "Automate: Squid Ink Pasta"
	"quest.6BB4725031FEA927.quest_desc": [
		"Red and white wool. Marks a spot on the water: channels, mines, rally points."
	]
	"quest.6BB4725031FEA927.title": "Buoy"
	"quest.6BC91EB7A3EC3C43.quest_desc": [
		"A Press over a basin compacts 9 coal into a block. Make a &astack&r."
	]
	"quest.6BC91EB7A3EC3C43.title": "Automate: Block of Coal"
	"quest.6BEC794B9B7ED2B9.quest_desc": [
		"Belts are made from &adried kelp&r. Gather &akelp&r from any ocean."
	]
	"quest.6BEC794B9B7ED2B9.title": "Kelp"
	"quest.6C2E39C435DB09B7.quest_desc": [
		"Andesite alloy on Mechanical Crafters. Make a &astack&r."
	]
	"quest.6C2E39C435DB09B7.title": "Automate: Basin"
	"quest.6C3CFAF816C70C1A.quest_desc": [
		"&6Trigger Mobs&r: some mobs spawn &ccarrying guns&r and fire them at you. Armor up and"
		"keep moving."
	]
	"quest.6C3CFAF816C70C1A.title": "Armed and Dangerous"
	"quest.6C84D12C75770661.quest_desc": [
		"Smoked ham, a honey bottle, 4 sweet berries, 2 cooked rice and a bowl. Make &a4&r."
	]
	"quest.6C84D12C75770661.title": "Automate: Honey Glazed Ham"
	"quest.6C99B713DE5C894D.quest_desc": [
		"Keep a cooking pot on a stove fed with funnels and pull the soup out. Make a &astack&r"
		"(16)."
	]
	"quest.6C99B713DE5C894D.title": "Automate: Vegetable Soup"
	"quest.6CB63BE4A285144A.quest_desc": [
		"Bread and 2 fried eggs. Make a &astack&r."
	]
	"quest.6CB63BE4A285144A.title": "Automate: Egg Sandwich"
	"quest.6CFFC5E6FB4D423C.quest_desc": [
		"&eChanged in this pack:&r brewing Biofuel now needs a &6Superheated&r burner. Mix"
		"&aSugar + Cinder Flour + 2 Biomass&r to make &a125 mB&r."
		""
		"Bootstrap it with Blaze Cakes. Once it's running, Biofuel can keep its own mixer hot."
	]
	"quest.6CFFC5E6FB4D423C.title": "Tier 2: Biofuel"
	"quest.6D0FA79299F60AAC.quest_desc": [
		"Bricks, iron, a water bucket and a wooden shovel. Put it on a stove and cook meals that"
		"give &aNourishment&r and &aComfort&r."
	]
	"quest.6D0FA79299F60AAC.title": "Cooking Pot"
	"quest.6D2805A2182ECE10.quest_desc": [
		"Pillagers and vindicators, led by a &cRaid Captain&r."
		"&aClick the checkmark when you're ready&r (quest edit mode OFF): the attack starts on the spot. Fight near your base."
	]
	"quest.6D2805A2182ECE10.title": "Wave 2: Raiding Party"
	"quest.6D4D3B1AE4194237.quest_desc": [
		"Grinds items: gravel to flint, flowers to dye, and more. Look up any item in JEI under"
		"&aMilling&r."
	]
	"quest.6D4D3B1AE4194237.title": "Millstone"
	"quest.6D5E029DCC15797C.quest_desc": [
		"Turn uranium powder into &aliquid uranium&r (check JEI), then compact it in a basin."
	]
	"quest.6D5E029DCC15797C.title": "Yellowcake"
	"quest.6D7A35883B8B3DFF.quest_desc": [
		"Bigger wheel, more power: a &aLarge Water Wheel&r gives far more stress capacity, at a"
		"slower speed. Gear it up with a large-to-small cogwheel pair."
	]
	"quest.6D7A35883B8B3DFF.title": "Large Water Wheel"
	"quest.6DA7A77B9BBA1369.quest_desc": [
		"Brass casing, a gyroscopic mechanism and a propeller. A propeller you can steer"
		"and throttle with redstone."
	]
	"quest.6DA7A77B9BBA1369.title": "Smart Propeller"
	"quest.6DC04ED3ECE631A7.quest_desc": [
		"&cBoss:&r the Invoker leads the invasion, with a boss bar and fangs. Bring a team."
	]
	"quest.6DC04ED3ECE631A7.title": "The Invoker"
	"quest.6DC2586768C49C09.quest_desc": [
		"Raw chicken cuts through a smoking fan (or slice cooked chicken). Make a &astack&r."
	]
	"quest.6DC2586768C49C09.title": "Automate: Cooked Chicken Cuts"
	"quest.6DFA7706AC394262.quest_desc": [
		"Zinc: the missile body that carries the warhead."
	]
	"quest.6DFA7706AC394262.title": "Payload Casing"
	"quest.6E3A0D04627D2E8E.quest_desc": [
		"Mixer: crushed magma and slime balls (or blaze powder and slime on Mechanical Crafters). Make a &astack&r."
	]
	"quest.6E3A0D04627D2E8E.title": "Automate: Magma Cream"
	"quest.6E5E6509CE32E013.quest_desc": [
		"The two eating fish. Cook them with a &asmoking&r fan or a smoker, or slice them first for"
		"more meals per fish."
	]
	"quest.6E5E6509CE32E013.title": "Cod and Salmon"
	"quest.6E78E57BD013830B.quest_desc": [
		"Cooked mutton chops, cooked rice, beetroot, tomato and a bowl. Make a &astack&r (16)."
	]
	"quest.6E78E57BD013830B.title": "Automate: Roasted Mutton Chops"
	"quest.6E9F388055BE2E9B.quest_desc": [
		"&aMechanical Crafting&r: copper spool, capacitor, iron rods, brass sheets and andesite"
		"alloy. Turns electricity back into rotation, with a speed you set. &eNeeds the Brass Age.&r"
	]
	"quest.6E9F388055BE2E9B.title": "Electric Motor"
	"quest.6F0574BFA980C31E.quest_desc": [
		"Plant rice in shallow water. Panicles &aMill&r into rice (Millstone or Crushing Wheels)."
		"Make a &astack&r."
	]
	"quest.6F0574BFA980C31E.title": "Automate: Rice"
	"quest.6F14B448D1FF9C9A.quest_desc": [
		"&6Dragons Plus&r: copper sheets, gold and a barrel. A tank that keeps its fluid when you"
		"break it."
	]
	"quest.6F14B448D1FF9C9A.title": "Fragile Fluid Tank"
	"quest.6F217E9F810098F7.quest_desc": [
		"Compact industrial sludge. Crush it for dust and a chance of metals, or smelt it into brick."
	]
	"quest.6F217E9F810098F7.title": "Sludge Cake"
	"quest.6F3BBA2B34BC0A91.quest_desc": [
		"Electron tube, iron plates, brass nuggets and redstone. Marks targets."
	]
	"quest.6F3BBA2B34BC0A91.title": "Target Designator"
	"quest.6FA2ACB82CCEA0DD.quest_desc": [
		"Spout chocolate onto a pie crust. Make a &astack&r."
		""
		"&7Needs milk from Animal Product Automation."
	]
	"quest.6FA2ACB82CCEA0DD.title": "Automate: Chocolate Pie"
	"quest.6FC902C0AAB2722B.quest_desc": [
		"&eChanged in this pack:&r mechanical crafting with &a7 Quantum Pearls&r, amethyst and"
		"emeralds."
	]
	"quest.6FC902C0AAB2722B.title": "Warp Stone"
	"quest.7000BE24649EACD6.quest_desc": [
		"Grow Redwood saplings and fell the trees with &aMechanical Saws&r. Leaf blocks only drop to shears:"
		"try Deployers holding shears. Make a &astack&r of each."
	]
	"quest.7000BE24649EACD6.title": "Automate: Redwood"
	"quest.70263C939D5DC8A6.quest_desc": [
		"Mixer: pasta, raw pork, dried kelp, an egg and a bowl. Make a &astack&r (16)."
		""
		"&7Needs eggs from Animal Product Automation."
	]
	"quest.70263C939D5DC8A6.title": "Automate: Noodle Soup"
	"quest.706F45431F5C5E14.quest_desc": [
		"Every quest under &aBrass Logistics&r is done: 5 production lines running on their own."
	]
	"quest.706F45431F5C5E14.title": "Brass Logistics Mastered"
	"quest.708ABE7F0EE91DFA.quest_desc": [
		"&eChanged in this pack:&r every scroll is made from &dQuantum Paper&r."
	]
	"quest.708ABE7F0EE91DFA.title": "Blank Scroll"
	"quest.70D3BE6805B8D5D8.quest_desc": [
		"Crush blaze rods with Crushing Wheels. Make a &astack&r."
	]
	"quest.70D3BE6805B8D5D8.title": "Automate: Blaze Powder"
	"quest.7122C875AA1F391F.quest_desc": [
		"Dirt, 2 straw, 2 bone meal and 4 tree bark (or 4 bone meal and 2 rotten flesh), on"
		"Mechanical Crafters. Tree bark: a Slicer holding an axe strips logs. Make a &astack&r."
	]
	"quest.7122C875AA1F391F.title": "Automate: Organic Compost"
	"quest.7127B39888B240ED.quest_desc": [
		"4 straw."
	]
	"quest.7127B39888B240ED.title": "Canvas"
	"quest.7153EFC543EF00EA.quest_desc": [
		"&aMechanical Crafting&r: a &5Nether Star&r, netherite, an item vault and casings."
		"Build the reactor the blueprint shows, load rods, and it makes &6millions of SU&r."
		"&cIf it overheats, it melts down:&r a nuclear explosion that leaves a &cWasteland&r"
		"biome behind. Everyone within 256 blocks gets a warning first. A reactor is a target."
	]
	"quest.7153EFC543EF00EA.title": "Reactor Controller"
	"quest.718E4E38BC1A75D0.quest_desc": [
		"Any cooked meat, onion, tomato and a stick. Make a &astack&r."
	]
	"quest.718E4E38BC1A75D0.title": "Automate: Barbecue on a Stick"
	"quest.71AA12F89FADBAA6.quest_desc": [
		"&6Offroad&r: ground vehicles are Sable physics objects (see the Physics Assembler in"
		"Aeronautics). Mount wheels on a &aWheel Mount&r."
	]
	"quest.71AA12F89FADBAA6.title": "Wheel Mount"
	"quest.71CD320A773018D0.quest_desc": [
		"Surround a backpack with iron for more slots. It keeps its contents."
	]
	"quest.71CD320A773018D0.title": "Iron Backpack"
	"quest.71E0AD84F1CF7715.quest_desc": [
		"Copper and a redstone torch. Its color shows the air quality around you."
	]
	"quest.71E0AD84F1CF7715.title": "Safety Lantern"
	"quest.71FA72B80315E6FB.quest_desc": [
		"Every quest under &aCrushing&r is done: 9 production lines running on their own."
	]
	"quest.71FA72B80315E6FB.title": "Crushing Mastered"
	"quest.72194779A11AA636.quest_desc": [
		"A valve handle on brass casing: a steering wheel. Dye it any color."
	]
	"quest.72194779A11AA636.title": "Wheel Module"
	"quest.722BD515250F1E67.quest_desc": [
		"Copper and zinc sheets with a redstone torch. A part of every electric machine."
	]
	"quest.722BD515250F1E67.title": "Capacitor"
	"quest.723094AEB5AA27D1.quest_desc": [
		"A lever module, brass and brass casing: pitch and roll in one control."
	]
	"quest.723094AEB5AA27D1.title": "Yoke Module"
	"quest.7232B86A04A1181F.quest_desc": [
		"&6Create&r: a multiblock that holds a huge amount of items. Place several side by side to"
		"make it bigger. Hook it to your Tom's network like any chest."
	]
	"quest.7232B86A04A1181F.title": "Item Vault"
	"quest.72424400C302B52D.quest_desc": [
		"&aMechanical Crafting&r: a Big Cannons &cHE Shell&r wrapped in 8 uranium rods and lead,"
		"with a &5Nether Star&r core. A mushroom cloud, and a blast that levels whole bases."
		"&cClaims &omaybe&r&c won't save anyone.&r Fire it from very far away, and never at home."
	]
	"quest.72424400C302B52D.title": "Nuclear Shell"
	"quest.728E9D32BE764BA7.quest_desc": [
		"Links teleporters together. Advanced component, brass sheet, redstone pearl, transmitter."
	]
	"quest.728E9D32BE764BA7.title": "TP Link"
	"quest.7298096382EF849F.quest_desc": [
		"A copper block, a mechanical pump and a transmitter. Runs the ballast pumps from one"
		"place."
	]
	"quest.7298096382EF849F.title": "Pump Controller"
	"quest.72AD940B35F91514.quest_desc": [
		"Flour, dough, cookies, pies and cakes."
	]
	"quest.72AD940B35F91514.title": "Bakery"
	"quest.72BF8D911FA88129.quest_desc": [
		"Mix &aChorus Fruit + 250 mB water&r over a &6heated&r burner to make &dTelejuice&r"
		"(Quantum Fluid)."
	]
	"quest.72BF8D911FA88129.title": "Telejuice"
	"quest.7314F8809800FC2F.quest_desc": [
		"Andesite alloy and dried kelp make an &aAndesite Tunnel&r: put it over a belt to cover it"
		"and split items off to the sides."
	]
	"quest.7314F8809800FC2F.title": "Andesite Tunnel"
	"quest.731740FB69570BAB.quest_desc": [
		"&eThis pack's own item:&r Spout &a100 mB of Telejuice&r onto &aPaper&r. Used for every"
		"waystone scroll."
	]
	"quest.731740FB69570BAB.title": "Quantum Paper"
	"quest.73638BEF242FD8D0.quest_desc": [
		"Two cogwheels and an industrial belt (makes 4). The sprocket that drives the treads."
	]
	"quest.73638BEF242FD8D0.title": "Flanged Cogwheel"
	"quest.73795B54B8F784EE.quest_desc": [
		"An analog lever, brass casing and a transmitter: two tilt axes on one stick."
	]
	"quest.73795B54B8F784EE.title": "Joystick Module"
	"quest.7391A72D1E941C14.quest_desc": [
		"A sail frame, black dye and iron (makes 4). Rotor blades."
	]
	"quest.7391A72D1E941C14.title": "Drone Blade"
	"quest.73A80F40FCC06F47.quest_desc": [
		"Wheels, planks and a shaft: a field carriage to drag a light cannon around."
	]
	"quest.73A80F40FCC06F47.title": "Cannon Carriage"
	"quest.73B701AF88A87639.quest_desc": [
		"A knife on the &aCutting Board&r (or a &aSlicer&r holding one) cuts each fish into &a2 slices&r."
	]
	"quest.73B701AF88A87639.title": "Fish Slices"
	"quest.7464283671580AFD.quest_desc": [
		"Crushing Wheels turn gem ores into gems and dust."
	]
	"quest.7464283671580AFD.title": "Gems and Dusts"
	"quest.746C159AEF0D05EF.quest_desc": [
		"&eThis pack's own recipe:&r crushing Nether Bricks can drop Netherite Scrap."
	]
	"quest.746C159AEF0D05EF.title": "Netherite"
	"quest.74777FCB60E4E957.quest_desc": [
		"Blow &agravel&r through water with an &aEncased Fan&r (washing) for iron nuggets, then"
		"have a &aMechanical Press&r over a &aBasin&r compact them: &a9 nuggets&r into an ingot,"
		"&a9 ingots&r into a block."
		""
		"Make a &astack&r each of nuggets, ingots and Blocks of Iron."
	]
	"quest.74777FCB60E4E957.title": "Automate: Iron"
	"quest.747B9C1E1629BAE3.quest_desc": [
		"Raw mutton chops through a smoking fan (or slice cooked mutton). Make a &astack&r."
	]
	"quest.747B9C1E1629BAE3.title": "Automate: Cooked Mutton Chops"
	"quest.7480EF1E2750E1CA.quest_desc": [
		"Every quest under &aRose Quartz&r is done: 3 production lines running on their own."
	]
	"quest.7480EF1E2750E1CA.title": "Rose Quartz Mastered"
	"quest.7495980C8CC73268.quest_desc": [
		"Iron bars, quartz and redstone: bursts near a target."
	]
	"quest.7495980C8CC73268.title": "Proximity Fuze"
	"quest.749FE3E4AD2CCE5B.quest_desc": [
		"Sends items to a paired destination. Brass casing, chute, barrel, Quantum Mechanism."
	]
	"quest.749FE3E4AD2CCE5B.title": "Item Teleporter"
	"quest.74B4F6E49CBE121B.quest_desc": [
		"The same console in brass casing: a desk-style cockpit for bigger craft."
	]
	"quest.74B4F6E49CBE121B.title": "Control Desk"
	"quest.74C9A5D8523819F4.quest_desc": [
		"Keeps the chunks around it loaded, so remote machines keep running. A beacon wrapped in"
		"Quantum Casings and Quantum Pearls, with a Quantum Mechanism (pack recipe)."
	]
	"quest.74C9A5D8523819F4.title": "Chunk Loader"
	"quest.74CDBCF76E1C34D2.quest_desc": [
		"Factions are &aFTB Teams&r. Quest progress is shared by everyone on your team."
		""
		"Create a party from the FTB Teams button in your inventory, or with"
		"&a/ftbteams party create <name>&r, then invite your teammates."
	]
	"quest.74CDBCF76E1C34D2.title": "Form a Team"
	"quest.74CFBB049C996D12.quest_desc": [
		"&6CBC Military Supplement&r: torpedoes are assembled in stages (see JEI) and fired from a"
		"torpedo tube."
	]
	"quest.74CFBB049C996D12.title": "Basic Torpedo"
	"quest.75335DE2B5EB654D.quest_desc": [
		"Cobblestone through a fan blowing through lava. Make a &astack&r."
	]
	"quest.75335DE2B5EB654D.title": "Automate: Stone"
	"quest.7561AD7708EB75D1.quest_desc": [
		"A cast-iron &6anti-air car&r with a heavy crew. Your aircraft are its targets."
		"&aClick the checkmark when you're ready&r (quest edit mode OFF): the attack starts on the spot. Fight near your base."
	]
	"quest.7561AD7708EB75D1.title": "Wave 7: Anti-Air Battery"
	"quest.75B21D2F895338BB.quest_desc": [
		"A Press over a basin compacts 9 brass ingots into a block. Make a &astack&r."
	]
	"quest.75B21D2F895338BB.title": "Automate: Block of Brass"
	"quest.75DA6E9988F3AA8E.quest_desc": [
		"The medium bomb's recipe plus &aSturdy Sheets&r."
	]
	"quest.75DA6E9988F3AA8E.title": "Large Bomb"
	"quest.76309B06924D5129.quest_desc": [
		"Spout a night vision potion onto cinder flour, or crush glowstone. Make a &astack&r."
	]
	"quest.76309B06924D5129.title": "Automate: Glowstone Dust"
	"quest.763A8D151E82F962.quest_desc": [
		"Copper wire wound on a spool. Use it on two connectors to wire them together."
		"TFMG has its own &aCopper Spool (TFMG Cable)&r for its cable insulators; the two don't mix."
	]
	"quest.763A8D151E82F962.title": "Copper Spool"
	"quest.763D4204A08B0422.quest_desc": [
		"Sequenced assembly: brass sheet and gunpowder, pressed with the form."
	]
	"quest.763D4204A08B0422.title": "Revolver Shell"
	"quest.7647AA74DA277AB7.quest_desc": [
		"Bullets are made of &alead&r. Mine and smelt lead ore."
	]
	"quest.7647AA74DA277AB7.title": "Lead"
	"quest.7677E2F5E9D9F3C5.quest_desc": [
		"Mixer: 2 apples, sugar and a glass bottle. Make a &astack&r (16)."
	]
	"quest.7677E2F5E9D9F3C5.title": "Automate: Apple Cider"
	"quest.768786DC2818C9FB.quest_desc": [
		"Another Distillation Tower output: aviation fuel for jet and turbine engines."
	]
	"quest.768786DC2818C9FB.title": "Kerosene"
	"quest.76CED96AB6CE2651.quest_desc": [
		"&6Steam 'n' Rails&r: andesite casing, a fence, iron plate and an electron tube. A signal"
		"arm that shows a Train Signal's state."
	]
	"quest.76CED96AB6CE2651.title": "Semaphore"
	"quest.76F59EFACD9DBDED.quest_desc": [
		"Fill a Blaze Cake Base with &a250 mB of lava&r using a Spout."
		""
		"Feed it to a Blaze Burner: &6Superheated for 2 min 40 s&r. Automate the feeding with a"
		"Mechanical Arm, Deployer or Funnel."
	]
	"quest.76F59EFACD9DBDED.title": "Tier 1: Blaze Cake"
	"quest.76F7847080F67A6F.quest_desc": [
		"Milk, wool, leather, eggs and feathers on tap."
	]
	"quest.76F7847080F67A6F.title": "Master Rancher"
	"quest.7723D422C390F52B.quest_desc": [
		"&6Create: Droneworks Simulated&r: the heart of a drone. Check the Ponder for a basic build."
	]
	"quest.7723D422C390F52B.title": "Drone Core"
	"quest.772EB687B23B503B.quest_desc": [
		"Protect your base with &aFTB Chunks&r. Open the claim map from the FTB buttons in your"
		"inventory and drag across chunks to claim them for your team."
		""
		"Claimed chunks stop other teams breaking or using your blocks."
	]
	"quest.772EB687B23B503B.title": "Claim Your Base"
	"quest.7750562BA513BD83.quest_desc": [
		"Moves a block to a paired destination. Needs an Item Teleporter and a Deployer."
	]
	"quest.7750562BA513BD83.title": "Block Teleporter"
	"quest.77518E8FBF4A5EBF.quest_desc": [
		"Stonecut an iron ingot. A Press with this form stamps shells."
	]
	"quest.77518E8FBF4A5EBF.title": "Revolver Shell Press Form"
	"quest.77578E1470294AE0.quest_desc": [
		"A &aGearbox&r turns rotation 90 degrees in any horizontal direction, and is more compact"
		"than a cog pair."
	]
	"quest.77578E1470294AE0.title": "Gearbox"
	"quest.77939D5A042C3A39.quest_desc": [
		"Ham through a smoking fan. Smoking is the only recipe for it. Make a &astack&r."
	]
	"quest.77939D5A042C3A39.title": "Automate: Smoked Ham"
	"quest.779A31FF93D9F4FD.quest_desc": [
		"Iron and brass sheets, gunpowder, copper nuggets and a cogwheel."
	]
	"quest.779A31FF93D9F4FD.title": "Frag Grenade"
	"quest.77B43DA86A99BD93.quest_desc": [
		"Bone meal, compost, rich soil and liquid fertilizer to keep the fields growing."
	]
	"quest.77B43DA86A99BD93.title": "Fertilizer"
	"quest.77BD910B208F5E79.quest_desc": [
		"Pumpjack to distillation tower, no hands. Fill a &astack&r of Gasoline buckets (16)."
	]
	"quest.77BD910B208F5E79.title": "Automate: Gasoline"
	"quest.77C78A666705D0ED.quest_desc": [
		"Raw rabbit through a smoking fan. Make a &astack&r."
	]
	"quest.77C78A666705D0ED.title": "Automate: Cooked Rabbit"
	"quest.77DB7EDAF5F47B92.quest_desc": [
		"Cast iron tank, pipe, sheet and fireproof bricks: where materials go in."
	]
	"quest.77DB7EDAF5F47B92.title": "Blast Furnace Hatch"
	"quest.77E858E43348CDA4.quest_desc": [
		"Mixer: cabbage plus any raw meat, fish, vegetable or mushroom. Make a &astack&r."
	]
	"quest.77E858E43348CDA4.title": "Automate: Cabbage Rolls"
	"quest.77F672E923133118.quest_desc": [
		"Glass, brass sheet and an electron tube. Hold it for a live pollution reading."
		"Engineer's Goggles show the state of every Smog machine."
	]
	"quest.77F672E923133118.title": "Aerometer"
	"quest.77F9BCF4792E9119.quest_desc": [
		"Makes &aoxygen&r for your crew. Submarines need air."
	]
	"quest.77F9BCF4792E9119.title": "Electrolyzer"
	"quest.781530919FCCDB83.quest_desc": [
		"Mixer: pasta, carrot, a mushroom, a leafy green, any vegetable but melon, and a"
		"bowl. Make a &astack&r (16)."
	]
	"quest.781530919FCCDB83.title": "Automate: Vegetable Noodles"
	"quest.7818999E3DE028B1.quest_desc": [
		"A &cRavager&r leads the assault, with illagers and witches behind it. It breaks crops and"
		"walls. Bring friends."
		"&aClick the checkmark when you're ready&r (quest edit mode OFF): the attack starts on the spot. Fight near your base."
	]
	"quest.7818999E3DE028B1.title": "Wave 4: Siege"
	"quest.781EB13B3D3031E6.quest_desc": [
		"&6Aeroworks&r: a flywheel and a Gimbal Sensor. Powered by rotation, it holds your craft"
		"level and steady."
	]
	"quest.781EB13B3D3031E6.title": "Gyroscope"
	"quest.785134420AE70E3C.quest_desc": [
		"&6CBC Military Supplement&r: aerial bombs for Big Cannons-style payloads."
	]
	"quest.785134420AE70E3C.title": "HE Bomb"
	"quest.788F9D6BEE492895.quest_desc": [
		"Keep the coke oven fed. Make a &astack&r of Coal Coke."
	]
	"quest.788F9D6BEE492895.title": "Automate: Coal Coke"
	"quest.78B7A9898E0C4DA1.quest_desc": [
		"An iron pressurizer, industrial iron and a water bucket. Measures depth by pressure."
	]
	"quest.78B7A9898E0C4DA1.title": "Pressure Barometer"
	"quest.7920789DD9C2605F.quest_desc": [
		"Raises the dead as Surrendered. Kill the caster first."
	]
	"quest.7920789DD9C2605F.title": "Necromancer"
	"quest.792CC832BC6F5671.quest_desc": [
		"Mechanical crafting: steel, brass and steel sheets, andesite alloy, a cogwheel and a log."
	]
	"quest.792CC832BC6F5671.title": "Revolver"
	"quest.792E4CF39E03634A.quest_desc": [
		"The toughest armor: coal coke, heavy plates and netherite scrap (mechanical crafting)."
	]
	"quest.792E4CF39E03634A.title": "Boron Hull Armor"
	"quest.7966DB5B8803ECF8.quest_desc": [
		"Dirt, straw, bone meal and &atree bark&r (strip logs on the cutting board). Place it and"
		"it slowly turns into &aRich Soil&r."
	]
	"quest.7966DB5B8803ECF8.title": "Organic Compost"
	"quest.799B3A7B52938525.quest_desc": [
		"Hot air balloons: a &aHot Air Burner&r under an envelope gives adjustable lift."
	]
	"quest.799B3A7B52938525.title": "Hot Air Burner"
	"quest.79AFAE2A1B4CB9E2.quest_desc": [
		"Industrial iron, a brass sheet, redstone and a comparator. Lets a mounted cannon aim and"
		"fire on its own."
	]
	"quest.79AFAE2A1B4CB9E2.title": "Automatic Cannon Controller"
	"quest.79D1D4ECACAC0E6A.quest_desc": [
		"Brass ingots, dried kelp and an electron tube on Mechanical Crafters. Make a &astack&r."
	]
	"quest.79D1D4ECACAC0E6A.title": "Automate: Brass Tunnel"
	"quest.7A0CFA70DB594577.quest_desc": [
		"Train Casing, a lever and a precision mechanism. Drive the train yourself."
	]
	"quest.7A0CFA70DB594577.title": "Train Controls"
	"quest.7A1C29BC7A1E7837.quest_desc": [
		"&6CBC: Firepower Components&r: a compact mount for cannons on vehicles and ships. Brass"
		"casing, shaft, cogwheel, iron plate and gunpowder."
		"&eNeeds the Brass Age.&r Automate brass (Automation chapter) to keep these guns fed."
	]
	"quest.7A1C29BC7A1E7837.title": "Compact Cannon Mount"
	"quest.7A3F84BDB5400331.quest_desc": [
		"Mixer: seed oil with crops, flowers, saplings, sticks or honeycomb. Make a &astack&r (16)."
	]
	"quest.7A3F84BDB5400331.title": "Automate: Biomass"
	"quest.7A488CFB10FAE4B1.quest_desc": [
		"Every quest under &aMeats&r is done: 8 production lines running on their own."
	]
	"quest.7A488CFB10FAE4B1.title": "Meats Mastered"
	"quest.7A4DBE38AB7A7226.quest_desc": [
		"Lava flowing into &ahoney&r makes limestone. A Drill mines it. Make a &astack&r."
	]
	"quest.7A4DBE38AB7A7226.title": "Automate: Limestone"
	"quest.7A61284E61C8C04F.quest_desc": [
		"Harvester rows, same as wheat. Make a &astack&r."
	]
	"quest.7A61284E61C8C04F.title": "Automate: Carrot"
	"quest.7A95F64CCEE986F4.quest_desc": [
		"Spout milk onto bread. Make a &astack&r."
		""
		"&7Needs milk from Animal Product Automation."
	]
	"quest.7A95F64CCEE986F4.title": "Automate: Sweet Roll"
	"quest.7AB9FC5B547B2BA9.quest_desc": [
		"&6Offroad&r: dried kelp and a shaft (makes 4). Standard wheels for a ground vehicle."
	]
	"quest.7AB9FC5B547B2BA9.title": "Tire"
	"quest.7AD5DD7C8C0D4923.quest_desc": [
		"A cobblestone generator below Y=0 makes cobbled deepslate. A Drill mines it. Make a &astack&r."
	]
	"quest.7AD5DD7C8C0D4923.title": "Automate: Cobbled Deepslate"
	"quest.7AD7EE7AAC074AE1.quest_desc": [
		"A netherite ingot and a lever. Diamond to netherite: the biggest chest."
	]
	"quest.7AD7EE7AAC074AE1.title": "Netherite Tier"
	"quest.7AEBA39C3151BF3B.quest_desc": [
		"Washed-out sulfur. Neutralize it in a basin (limestone works) back to clarified water."
	]
	"quest.7AEBA39C3151BF3B.title": "Acidic Runoff"
	"quest.7B00515BF7869680.quest_desc": [
		"Create Wars is a &6Create&r pack about building a faction that can &cfight&r: aircraft, artillery,"
		"radar-guided missiles, armored trains and submarines."
		""
		"This book is a &aguide&r: it never locks recipes or items. Chapters open up as you finish"
		"earlier ones: the &6Ages&r in order, then the &6Expansions&r once you reach the Brass Age."
	]
	"quest.7B00515BF7869680.quest_subtitle": "Open the book. You did it."
	"quest.7B00515BF7869680.title": "Welcome to Create Wars"
	"quest.7B036FB0C0449878.quest_desc": [
		"A belt and iron nuggets (makes 4). The heavy drive belt tank treads are built"
		"around."
	]
	"quest.7B036FB0C0449878.title": "Industrial Belt"
	"quest.7B0DBA63C3D5D511.quest_desc": [
		"Planks, sticks, a chest and a trapdoor (makes 6). Reach storage that isn't next to the"
		"connector."
	]
	"quest.7B0DBA63C3D5D511.title": "Inventory Cable"
	"quest.7B3E1F92DCD2B92E.quest_desc": [
		"Precision mechanism, sequenced gearshift, electron tube and brass. Turns to the angle a"
		"redstone signal asks for: drives flaps, rudders and turrets from your controls."
	]
	"quest.7B3E1F92DCD2B92E.title": "Mechanical Servo"
	"quest.7B4891B86DBC4114.quest_desc": [
		"Raw beef, carrot and potato in the Cooking Pot. Real food for a long fight."
	]
	"quest.7B4891B86DBC4114.title": "Beef Stew"
	"quest.7B58D6CB05D0188E.quest_desc": [
		"Iron sheets, packed guncotton and a &aTimed Fuze&r (pack recipe). Roll it off the stern"
		"over a submarine."
	]
	"quest.7B58D6CB05D0188E.title": "Depth Charge"
	"quest.7B757D6F1FE22F44.quest_desc": [
		"&6Create: Warnautics&r: bombs fall with &aBig Cannons ballistics&r. Cast iron, iron plate,"
		"guncotton and a powder charge. Combine two for a bigger rack."
	]
	"quest.7B757D6F1FE22F44.title": "Small Bomb"
	"quest.7BA25B26BF786669.quest_desc": [
		"A carrot ringed with gold nuggets. Make a &astack&r."
	]
	"quest.7BA25B26BF786669.title": "Automate: Golden Carrot"
	"quest.7BBB696A3AB127E1.quest_desc": [
		"3 wheat and an egg (Mechanical Crafters). Make a &astack&r."
		""
		"&7Needs eggs from Animal Product Automation."
	]
	"quest.7BBB696A3AB127E1.title": "Automate: Wheat Dough"
	"quest.7BD4707E991E34CD.quest_desc": [
		"Pie crust, sweet berries and milk (Mechanical Crafters). Make a &astack&r."
		""
		"&7Needs milk from Animal Product Automation."
	]
	"quest.7BD4707E991E34CD.title": "Automate: Sweet Berry Cheesecake"
	"quest.7C1A8620A78BA4B6.quest_desc": [
		"Pillagers patrol and raid villages with crossbows. &6CTOV&r outposts are styled to each"
		"biome, and &6Create: Pillager Arise&r adds mechanized pillager bases: towers, camps, a"
		"fortress gate, a cathedral, even a pillager village and a blimp."
	]
	"quest.7C1A8620A78BA4B6.title": "Raiders"
	"quest.7C25C2287D94AE08.quest_desc": [
		"Fill a &aRailway Casing&r with &a1000 mB of Telejuice&r using a Spout."
	]
	"quest.7C25C2287D94AE08.title": "Quantum Casing"
	"quest.7CA594E22D4342D7.quest_desc": [
		"Cast a &afishing rod&r into any water for &acod&r, &asalmon&r, &apufferfish&r and &atropical fish&r"
		"(plus junk and the odd treasure). Use a water bucket on a swimming fish to carry it home alive."
		""
		"Fish are meat too: Agriculture's &aMeats&r group automates cod and salmon."
	]
	"quest.7CA594E22D4342D7.title": "Fishing"
	"quest.7CEBB4B0BE358E76.quest_desc": [
		"&aMechanical Crafting&r: steel and graphene. Graphite rods &bcool&r a reactor."
	]
	"quest.7CEBB4B0BE358E76.title": "Graphite Rod"
	"quest.7CF1D81329527AF6.quest_desc": [
		"Pipes pull honey out of full bee hives as a fluid. A &aSpout&r fills buckets. Fill &a16&r"
		"buckets."
	]
	"quest.7CF1D81329527AF6.title": "Automate: Honey"
	"quest.7D0A81063D367284.quest_desc": [
		"&6Sophisticated Storage&r: chests that take upgrades and can be tiered up. Planks and a"
		"lever (any wood works)."
	]
	"quest.7D0A81063D367284.title": "Sophisticated Chest"
	"quest.7D15B372452C5020.quest_desc": [
		"Netherite upgrade of the wireless terminal: much longer range."
	]
	"quest.7D15B372452C5020.title": "Advanced Wireless Terminal"
	"quest.7D263B17652C8ACD.quest_desc": [
		"Right-click a stripped log or wood with a copper ingot. The shell of every fluid machine."
	]
	"quest.7D263B17652C8ACD.title": "Copper Casing"
	"quest.7D5C7962B8EC6F60.quest_desc": [
		"Iron ingots and iron sheets on Mechanical Crafters. Make a &astack&r."
	]
	"quest.7D5C7962B8EC6F60.title": "Automate: Chute"
	"quest.7D68A9CC1359838B.quest_desc": [
		"An iron sheet and andesite casing. It peels cod and salmon into a &afish steak&r plus &afish"
		"skin&r (roast the skin for lobster bait). It also polishes rose quartz and strips leather armor."
	]
	"quest.7D68A9CC1359838B.title": "Mechanical Peeler"
	"quest.7D6935F4DE704537.quest_desc": [
		"Chute, fluid pipe, brass and steel sheets: fires rockets."
	]
	"quest.7D6935F4DE704537.title": "Launcher"
	"quest.7DD6A8B29B761263.quest_desc": [
		"Compact dough, eggs and sugar into a cake base, bake it with a smoking fan, then Spout"
		"honey on. Make a &astack&r."
		""
		"&7Needs eggs from Animal Product Automation."
	]
	"quest.7DD6A8B29B761263.title": "Automate: Honey Cake"
	"quest.7E06F1098287576C.quest_desc": [
		"A longer barrel for the revolver."
	]
	"quest.7E06F1098287576C.title": "Revolver: Long Barrel"
	"quest.7E329D2CC7AAB77A.quest_desc": [
		"&aCreate: Fishery Industry&r: a &aMechanical Peeler&r splits fish into steaks and skin, Bait Traps catch"
		"lobsters, Frame Traps pull up mussels."
	]
	"quest.7E329D2CC7AAB77A.title": "Seafood"
	"quest.7E7A50CE9C12944F.quest_desc": [
		"Bee hives give honey: pipes pull it from a full hive as fluid. Spout it into glass"
		"bottles. Make a &astack&r (16)."
	]
	"quest.7E7A50CE9C12944F.title": "Automate: Honey Bottle"
	"quest.7E99C8CCE9860EDD.quest_desc": [
		"Mine zinc ore with a Drill on a moving contraption. Make a &astack&r."
	]
	"quest.7E99C8CCE9860EDD.title": "Automate: Raw Zinc"
	"quest.7EF44200E09553BD.quest_desc": [
		"Collect your first bucket of liquid experience (&aBucket o' Enchanting&r)."
	]
	"quest.7EF44200E09553BD.title": "Liquid Experience"
	"quest.7F34CAFF787D4716.quest_desc": [
		"Grow Hellbark saplings and fell the trees with &aMechanical Saws&r. Leaf blocks only drop to shears:"
		"try Deployers holding shears. Make a &astack&r of each."
	]
	"quest.7F34CAFF787D4716.title": "Automate: Hellbark"
	"quest.7FB9FCEB172EFC2A.quest_desc": [
		"Sequenced assembly: iron sheets, packed gunpowder, redstone and a brass nugget. The"
		"explosive end of a torpedo."
	]
	"quest.7FB9FCEB172EFC2A.title": "Torpedo Warhead"
	"quest.7FC3A773BDC66B97.quest_desc": [
		"Mixer: 2 cocoa beans, milk, sugar and a glass bottle, or Spout chocolate into a bottle."
		"Make a &astack&r (16)."
		""
		"&7Needs milk from Animal Product Automation."
	]
	"quest.7FC3A773BDC66B97.title": "Automate: Hot Cocoa"
	"quest.7FC5EB1EC259FB56.quest_desc": [
		"Grow Palm saplings and fell the trees with &aMechanical Saws&r. Leaf blocks only drop to shears:"
		"try Deployers holding shears. Make a &astack&r of each."
	]
	"quest.7FC5EB1EC259FB56.title": "Automate: Palm"
	"quest.7FFB52F03DAEEB3B.quest_desc": [
		"Spout milk onto a baked cake base (dough, eggs and sugar compacted, then smoked), or let"
		"Mechanical Crafters run the normal recipe. Make &a8&r."
		""
		"&7Needs milk and eggs from Animal Product Automation."
	]
	"quest.7FFB52F03DAEEB3B.title": "Automate: Cake"
