	"quest.48B1B3FC63F633F8.title": "Train Station"
	"quest.48BD6C1FF6EEBB8E.quest_desc": [
		"Desert zombies. They make you hungry."
	]
	"quest.48BD6C1FF6EEBB8E.title": "Husks"
	"quest.4A5F8E84D4A3E786.quest_desc": [
		"Deny an area of sea."
	]
	"quest.4A5F8E84D4A3E786.title": "Underwater Mine"
	"quest.4AB1E382B8490E57.quest_desc": [
		"Brass casing, brass sheets, an electron tube and iron bars. Put it in an exhaust line:"
