	"quest.001F652EAEFEE740.quest_desc": [
		"Canvas and sticks. Picks up items in front of it, like a hopper."
	]
	"quest.001F652EAEFEE740.title": "Basket"
	"quest.005AC10822BFEE7D.quest_desc": [
		"Clay, dirt and sand: lines the moulds."
	]
	"quest.005AC10822BFEE7D.title": "Casting Sand"
	"quest.007777F3484D6C9D.quest_desc": [
		"2 wheat and a honey bottle (Mechanical Crafters). Make a &astack&r."
	]
	"quest.007777F3484D6C9D.title": "Automate: Honey Cookie"
	"quest.009CCD32434C6521.quest_desc": [
		"Mixer: rice, an egg, carrot, onion and a bowl. Make a &astack&r (16)."
		""
		"&7Needs eggs from Animal Product Automation."
	]
	"quest.009CCD32434C6521.title": "Automate: Fried Rice"
	"quest.00A7805C13ECF448.quest_desc": [
		"Oak and dark oak leaves drop apples. A tree farm with &aMechanical Saws&r and leaf"
		"breakers keeps them coming. Make a &astack&r."
	]
	"quest.00A7805C13ECF448.title": "Automate: Apple"
	"quest.010EF62A99D48302.quest_desc": [
		"Every quest under &aPrecision&r is done: 4 production lines running on their own."
	]
	"quest.010EF62A99D48302.title": "Precision Mastered"
	"quest.012C8C453F6577FE.quest_desc": [
		"Leather, glass, string and a filter cartridge. Pulls pollution out of you."
	]
	"quest.012C8C453F6577FE.title": "Smog Respirator"
	"quest.01417E6752358717.quest_desc": [
		"Runs off a &acopper backtank&r: precision mechanism, valve, pipe, brass and iron sheets."
	]
	"quest.01417E6752358717.title": "Nailgun"
	"quest.0187FFB7EBEF8201.quest_desc": [
		"Grows on soul sand in any dimension. Harvester rows work. Make a &astack&r."
	]
	"quest.0187FFB7EBEF8201.title": "Automate: Nether Wart"
	"quest.01B274AEC6E98520.quest_desc": [
		"A Spout fills items on a Depot or belt with fluid. You'll use it for Blaze Cakes and,"
		"later, for &dQuantum Paper&r."
	]
	"quest.01B274AEC6E98520.title": "Spout"
	"quest.01C2A9C455D1A608.quest_desc": [
		"Farmer's Delight crop from wild cabbages. Harvester rows. Make a &astack&r."
	]
	"quest.01C2A9C455D1A608.title": "Automate: Cabbage"
	"quest.01DB109F38C332AE.quest_desc": [
		"Sequenced assembly on a blank shotgun round, with nails or blaze powder (makes 8)."
	]
	"quest.01DB109F38C332AE.title": "Shotgun Shell"
	"quest.0202D14D081DFB44.quest_desc": [
		"Iron plate, gunpowder and blaze powder (makes 2). Ammunition for rocket pods."
	]
	"quest.0202D14D081DFB44.title": "S-8 Rocket"
	"quest.020BBB506826B4F2.quest_desc": [
		"2 cabbages, 2 glow berries, a golden carrot, a honey bottle, beetroot, tomato and a"
		"bowl. Make &a4&r."
	]
	"quest.020BBB506826B4F2.title": "Automate: Gleaming Salad"
	"quest.023A04271E4D7329.quest_desc": [
		"Logs through a lava fan, or a Press compacting 2 logs over a basin. Make a &astack&r."
	]
	"quest.023A04271E4D7329.title": "Automate: Charcoal"
	"quest.026989985A23357E.quest_desc": [
		"A sturdy sheet, a spring, a shaft and zinc nuggets (makes 4). Smooths the ride over"
		"rough ground."
	]
	"quest.026989985A23357E.title": "Suspension Piece"
	"quest.027DCABF3223641D.quest_desc": [
		"A mechanical pump, copper spool, capacitor and dried kelp (mechanical crafting). Pumps"
		"fluid on electricity instead of rotation."
	]
	"quest.027DCABF3223641D.title": "Electric Pump"
	"quest.02BA6E0ADEE99DA1.quest_desc": [
		"Liquid levitite blend. JEI shows how it sets into solid levitite."
	]
	"quest.02BA6E0ADEE99DA1.title": "Levitite Blend"
	"quest.030523533305C9CD.quest_desc": [
		"Brass, lead and graphite rods. Wear the full set around reactors and fuel."
		"Any lead works."
	]
	"quest.030523533305C9CD.title": "Anti-Radiation Suit"
	"quest.033C1F151EC8E3E6.quest_desc": [
		"Andesite alloy and dried kelp on Mechanical Crafters. Make a &astack&r."
	]
	"quest.033C1F151EC8E3E6.title": "Automate: Andesite Tunnel"
	"quest.03495FB874BD1066.quest_desc": [
		"Andesite casing, fluid pipe, iron and a piston pole. Bores out cast and built-up barrels."
	]
	"quest.03495FB874BD1066.title": "Cannon Drill"
	"quest.036B26DACF1DA03A.quest_desc": [
		"&6Create: Who Touched My Train&r: lock your train against other teams. In this pack, train"
		"blocks also resist cannon fire (&6CBC: Locometal Armor&r, server-side)."
	]
	"quest.036B26DACF1DA03A.title": "Train Lock"
	"quest.03B65E923ACB37ED.quest_desc": [
		"Industrial iron and iron nuggets (makes 8). The cleats that give tank treads grip."
	]
	"quest.03B65E923ACB37ED.title": "Grouser"
	"quest.0470831658F15E52.quest_desc": [
		"Iron sheets and bars: the dish surface."
	]
	"quest.0470831658F15E52.title": "Radar Dish"
	"quest.047B724128CA8638.quest_desc": [
		"Brass casing material for train parts (and Quantum Casing)."
	]
	"quest.047B724128CA8638.title": "Train Casing"
	"quest.04D5C8ED75ADC36D.quest_desc": [
		"Smelt congealed nitro. Crush or mill it into Nitropowder, the stronger propellant."
	]
	"quest.04D5C8ED75ADC36D.title": "Hardened Nitro"
	"quest.0530DE0B845F1E35.quest_desc": [
		"Pigs and hoglins killed with a &aknife&r drop Ham. Try a Deployer holding a knife."
		"Make a &astack&r."
	]
	"quest.0530DE0B845F1E35.title": "Automate: Ham"
	"quest.0540AEA5FD47D948.quest_desc": [
		"A copper block, a gold sheet and andesite alloy. Build a &6boiler&r: a Fluid Tank with lit"
		"&aBlaze Burners&r underneath and water pumped in, then put Steam Engines on its sides and"
		"a shaft on each. A bigger tank and more heat run more engines. Look at the tank with"
		"goggles to see its level."
	]
	"quest.0540AEA5FD47D948.title": "Steam Engine"
	"quest.054F56945A0D2185.quest_desc": [
		"Andesite alloy. Turns a Basin into a foundry for melting metal."
	]
	"quest.054F56945A0D2185.title": "Basin Foundry Lid"
	"quest.05898BDC6E712A72.quest_desc": [
		"Made with iron sheets. A &aMechanical Saw&r cuts trees and processes wood; put it on a"
		"moving contraption to build a tree farm."
	]
	"quest.05898BDC6E712A72.title": "Mechanical Saw"
	"quest.05DA4FF98AE373A1.quest_desc": [
		"Cabbage with meat, fish, vegetables or mushrooms in the Cooking Pot."
	]
	"quest.05DA4FF98AE373A1.title": "Cabbage Rolls"
	"quest.05E8FA7B0F917B21.quest_desc": [
		"Fish skin through a smoking fan. Good lobster bait. Make a &astack&r."
	]
	"quest.05E8FA7B0F917B21.title": "Automate: Roasted Fish Skin"
	"quest.05F26295C0D4E064.quest_desc": [
		"Blazes drop rods: a farm around a Nether Fortress blaze spawner that kills them. Make a &astack&r."
	]
	"quest.05F26295C0D4E064.title": "Automate: Blaze Rod"
	"quest.05FD55AEF439EB0C.quest_desc": [
		"Cast iron tank, pipe and fireproof bricks: heats air for the furnace."
	]
	"quest.05FD55AEF439EB0C.title": "Blast Stove"
	"quest.062E02334D715791.quest_desc": [
		"Brass casing and a precision mechanism. Sets the exact &aRPM&r of whatever it feeds."
	]
	"quest.062E02334D715791.title": "Rotation Speed Controller"
	"quest.06594F19D2F3CE63.quest_desc": [
		"&aMechanical Crafting&r: adds wooden slabs and an &aImpact Fuze&r to the small bomb's"
		"ingredients."
	]
	"quest.06594F19D2F3CE63.title": "Medium Bomb"
	"quest.066EDE2B31CE6F97.quest_desc": [
		"The &aMechanical Press&r flattens ingots into sheets and compacts items in a &aBasin&r."
		"Put a &aDepot&r under it to hold what it's pressing."
	]
	"quest.066EDE2B31CE6F97.title": "Mechanical Press and Depot"
	"quest.0692A7D2C24B263A.quest_desc": [
		"Netherrack through a lava fan makes nether brick; a Press over a basin compacts 4 into"
		"a block. Make a &astack&r."
	]
	"quest.0692A7D2C24B263A.title": "Automate: Nether Bricks"
	"quest.06A39428AF78928B.quest_desc": [
		"Everything in Create starts with &aandesite&r: the gray stone found in big patches"
		"underground and in hillsides. Mine some."
	]
	"quest.06A39428AF78928B.title": "Find Andesite"
	"quest.06B714F2701E4D4F.quest_desc": [
		"Quartz and redstone into rose quartz, polished by Deployers holding sand paper, into electron tubes."
	]
	"quest.06B714F2701E4D4F.title": "Rose Quartz"
	"quest.06FB04B9C71307E7.quest_desc": [
		"A redstone lamp, note block, electron tube, iron sheet and red glass. Sounds when it gets"
		"a redstone signal."
	]
	"quest.06FB04B9C71307E7.title": "Industrial Alarm"
	"quest.0718F9C1F283457C.quest_desc": [
		"Deployers apply andesite alloy to stripped logs. Make a &astack&r."
	]
	"quest.0718F9C1F283457C.title": "Automate: Andesite Casing"
	"quest.0730161B25077A1B.quest_desc": [
		"2 apples, a golden carrot, a hay bale and a rice bale. Make a &astack&r (16)."
	]
	"quest.0730161B25077A1B.title": "Automate: Horse Feed"
	"quest.074CADD944FC37A4.quest_desc": [
		"Raw salmon slices through a smoking fan (or slice cooked salmon). Make a &astack&r."
	]
	"quest.074CADD944FC37A4.title": "Automate: Cooked Salmon Slice"
	"quest.0784C2E3B1ED63AB.quest_desc": [
		"Iron sheet, precision mechanism and shaft: steering for a missile."
	]
	"quest.0784C2E3B1ED63AB.title": "Actuator Fins"
	"quest.078D72E61EE6482B.quest_desc": [
		"Copper casing and a chute. Pumps fluids in and out of tanks on a moving contraption."
	]
	"quest.078D72E61EE6482B.title": "Portable Fluid Interface"
	"quest.07BF44C0797C1380.quest_desc": [
		"An upgrade base and logs. Each slot holds more items; higher tiers hold far more."
	]
	"quest.07BF44C0797C1380.title": "Stack Upgrade Tier 1"
	"quest.07D62E8960C7E77D.quest_desc": [
		"Grow Pine saplings and fell the trees with &aMechanical Saws&r. Leaf blocks only drop to shears:"
		"try Deployers holding shears. Make a &astack&r of each."
	]
	"quest.07D62E8960C7E77D.title": "Automate: Pine"
	"quest.07E8DC1BE76E7D93.quest_desc": [
		"A brass sheet on a filter cartridge. Lasts 4x longer. Wash a clogged one with a"
		"fan through water to clean it and get the soot back."
	]
	"quest.07E8DC1BE76E7D93.title": "Brass Filter Cartridge"
	"quest.07ED60DE136EC10C.quest_desc": [
		"Wash gravel with a fan blowing through water. Make a &astack&r."
	]
	"quest.07ED60DE136EC10C.title": "Automate: Flint"
	"quest.083D0860E2942759.quest_desc": [
		"A mechanical bearing, electron tube and iron sheet. Build a dish on it and spin it to"
		"&ascan the sky&r. Check the Ponder for radar builds."
	]
	"quest.083D0860E2942759.title": "Radar Bearing"
	"quest.084EBAB39C1C241D.quest_desc": [
		"Spout chocolate onto sweet berries. Chocolate: Mixer with milk, sugar and cocoa beans."
		"Make a &astack&r."
		""
		"&7Needs milk from Animal Product Automation."
	]
	"quest.084EBAB39C1C241D.title": "Automate: Chocolate Glazed Berries"
	"quest.0871F96D87A29AAD.quest_desc": [
		"Mixer: tomato, onion, beetroot, any vegetable but melon, and a bowl. Make a &astack&r"
		"(16)."
	]
	"quest.0871F96D87A29AAD.title": "Automate: Ratatouille"
	"quest.08A41104967AD286.quest_desc": [
		"Copper and zinc into a heated &aMixer&r, then pressed, compacted and cut into every brass form."
	]
	"quest.08A41104967AD286.title": "Brass"
	"quest.08ADF7B023180415.quest_desc": [
		"Find wild crops in the world and break them for seeds and produce. Plant them."
		"&aTip:&r Create's Millstone turns wild crops into seeds too."
	]
	"quest.08ADF7B023180415.title": "Wild Crops"
	"quest.08D2D37931A9F369.quest_desc": [
		"Deployers apply brass ingots to stripped logs. Make a &astack&r."
	]
	"quest.08D2D37931A9F369.title": "Automate: Brass Casing"
	"quest.08D30B70E04A17D4.quest_desc": [
		"&cThe end of the war.&r Three Mk.II nuclear shells, end crystals and nether stars. A"
		"thermonuclear dome and a shockwave in rings. There is nothing bigger."
	]
	"quest.08D30B70E04A17D4.title": "H-Bomb"
	"quest.092D0A0E2DF0AEE9.quest_desc": [
		"Turns nuggets into ingots and ingots into blocks as they come in."
	]
	"quest.092D0A0E2DF0AEE9.title": "Compacting Upgrade"
	"quest.0962E263FFA273D1.quest_desc": [
		"Everything that flies (or drives, or sails) starts here. A &aPhysics Assembler&r turns a"
		"built contraption into a real &6Sable&r physics object. Check its Ponder."
	]
	"quest.0962E263FFA273D1.title": "Physics Assembler"
	"quest.098FA67A40C809DB.quest_desc": [
		"Train Casing and a chute. Refuel a train while it waits at a station."
	]
	"quest.098FA67A40C809DB.title": "Portable Fuel Interface"
	"quest.09ACA9567831BCFF.quest_desc": [
		"A shaft and dried kelp (makes 4). Light vehicles."
	]
	"quest.09ACA9567831BCFF.title": "Small Tire"
	"quest.09C1A0FEB59A4D41.quest_desc": [
		"Andesite casing and cogwheels on Mechanical Crafters. Make a &astack&r."
	]
	"quest.09C1A0FEB59A4D41.title": "Automate: Gearbox"
	"quest.09D33D79CA336A9E.quest_desc": [
		"Same idea, turned on its side: a &aVertical Gearbox&r sends rotation up or down."
	]
	"quest.09D33D79CA336A9E.title": "Vertical Gearbox"
	"quest.09F05D7759AB902E.quest_desc": [
		"Crush raw uranium (Crushing Wheels), then crush the crushed uranium again. Crushing"
		"&agranite&r also gives a little."
	]
	"quest.09F05D7759AB902E.title": "Uranium Powder"
	"quest.0A3ABEAAAAB9D744.quest_desc": [
		"Mixer: 2 tomatoes and a bowl. Make a &astack&r (16)."
	]
	"quest.0A3ABEAAAAB9D744.title": "Automate: Tomato Sauce"
	"quest.0A4151F48A770553.quest_desc": [
		"Dried kelp makes &aBelts&r, which move items between machines. Place a belt by using"
		"it on two shafts."
	]
	"quest.0A4151F48A770553.title": "Belts"
	"quest.0ACD3C38CCC47073.quest_desc": [
		"A hydrophone: copper sheets, an electron tube, a note block and brass casing (pack recipe)."
		"Warns you of incoming torpedoes."
	]
	"quest.0ACD3C38CCC47073.title": "Torpedo Detection Device"
	"quest.0AED7F0E408DE000.quest_desc": [
		"Cast a barrel from molten &abronze&r: lighter and tougher than cast iron."
	]
	"quest.0AED7F0E408DE000.title": "Bronze Cannon"
	"quest.0AF456D00844DE07.quest_desc": [
		"Cows give milk to any bucket used on them: try Deployers holding empty buckets. Drain"
		"the milk into a tank for Spouts and Mixers. Fill &a16&r buckets."
	]
	"quest.0AF456D00844DE07.title": "Automate: Milk Bucket"
	"quest.0B1FFDFAEA02CC1B.quest_desc": [
		"Slime and paper. Tape a full chest to pick it up with everything inside."
	]
	"quest.0B1FFDFAEA02CC1B.title": "Packing Tape"
	"quest.0B4492CE16040D3F.quest_desc": [
		"Feed cobblestone into a &aMillstone&r. Make a &astack&r of gravel."
	]
	"quest.0B4492CE16040D3F.title": "Automate: Gravel"
	"quest.0B6A2CAD088DC8EA.quest_desc": [
		"Grow Magic saplings and fell the trees with &aMechanical Saws&r. Leaf blocks only drop to shears:"
		"try Deployers holding shears. Make a &astack&r of each."
	]
	"quest.0B6A2CAD088DC8EA.title": "Automate: Magic"
	"quest.0C31FEEDB9F4C0F8.quest_desc": [
		"Wild rice grows in shallow water. Plant it in water one block deep."
	]
	"quest.0C31FEEDB9F4C0F8.title": "Rice"
	"quest.0C34CAA169348117.quest_desc": [
		"Press &agold ingots&r into &aGolden Sheets&r: they make the Wrench and Goggles, and go into"
		"precision parts later."
	]
	"quest.0C34CAA169348117.title": "Gold Sheets"
	"quest.0C3E6CD025DD5F0B.quest_desc": [
		"Experience on tap."
	]
	"quest.0C3E6CD025DD5F0B.title": "Enchanting Automation"
	"quest.0C8ED7CBC0DFB08A.quest_desc": [
		"Mechanical crafting with an Entity Teleporter, Quantum Mechanism and more: build portals"
		"of your own shape. Each base needs at least 256 mB of Telejuice."
	]
	"quest.0C8ED7CBC0DFB08A.title": "Custom Portal Controller"
	"quest.0CC25CF336BC5A7A.quest_desc": [
		"Press gun steel into sheets."
	]
	"quest.0CC25CF336BC5A7A.title": "Steel Sheet"
	"quest.0CCE65E9808C43B9.quest_desc": [
		"A Press over a basin compacts biomass into pellets. Make a &astack&r."
	]
	"quest.0CCE65E9808C43B9.title": "Automate: Biomass Pellet"
	"quest.0CD62493EF389622.quest_desc": [
		"Brass casing and sheet, industrial iron, a &aCannon Loader&r and redstone. Reloads a big"
		"cannon from a magazine, so it keeps firing without a loader crew."
	]
	"quest.0CD62493EF389622.title": "Cannon Magazine Loader"
	"quest.0CD7E5A645ACC910.quest_desc": [
		"Better cannons are &acast&r: pour molten cast iron into a &amould&r. Check the Ponder"
		"for casting setups."
	]
	"quest.0CD7E5A645ACC910.title": "Cast Iron Cannon"
	"quest.0D13904184C440CF.quest_desc": [
		"A brass ingot, dried kelp and an electron tube on Mechanical Crafters. Make a &astack&r."
	]
	"quest.0D13904184C440CF.title": "Automate: Brass Funnel"
	"quest.0D1C293AEDBE7585.quest_desc": [
		"Wet scrubbers drain it. &cDo not dump it&r: it contaminates ground and kills plants."
	]
	"quest.0D1C293AEDBE7585.title": "Industrial Wastewater"
	"quest.0D3150A2462CFED0.quest_desc": [
		"Grow Mahogany saplings and fell the trees with &aMechanical Saws&r. Leaf blocks only drop to shears:"
		"try Deployers holding shears. Make a &astack&r of each."
	]
	"quest.0D3150A2462CFED0.title": "Automate: Mahogany"
	"quest.0D6FAA54E3DC19FA.quest_desc": [
		"An iron block, chain, iron sheet and ingot. Drop it to hold your ship in place."
	]
	"quest.0D6FAA54E3DC19FA.title": "Anchor"
	"quest.0D9AA173E29EA08E.quest_desc": [
		"A copper block and gold sheets. Fills an envelope with steam from a boiler, instead"
		"of hot air from a burner."
	]
	"quest.0D9AA173E29EA08E.title": "Steam Vent"
	"quest.0D9F1985E16955EF.quest_desc": [
		"A cobblestone generator with a &aMechanical Drill&r mining it nonstop. Make a &astack&r."
	]
	"quest.0D9F1985E16955EF.title": "Automate: Cobblestone"
	"quest.0DB4E16D719CF535.quest_desc": [
		"Farmer's Delight crop from wild tomatoes. Tomatoes climb ropes as they grow. Make a &astack&r."
	]
	"quest.0DB4E16D719CF535.title": "Automate: Tomato"
	"quest.0DE91D880C27E0AF.quest_desc": [
		"Brass sheet and a stripped log: steadies your aim."
	]
	"quest.0DE91D880C27E0AF.title": "Stock"
	"quest.0E100C9DE8E82065.quest_desc": [
		"&6Thick Air&r: you slowly run out of air &cbelow Y=0&r, &cabove Y=192&r, and in the Nether."
		"The End has no air at all. A &aBacktank&r with a &aDiving Helmet&r is your air supply."
		"&cPilots:&r flying above Y=192 needs this too."
	]
	"quest.0E100C9DE8E82065.title": "Copper Backtank"
	"quest.0E256B710E333EB5.quest_desc": [
		"Press over a basin: 2 flint, red sand and lava compact into granite. Make a &astack&r."
	]
	"quest.0E256B710E333EB5.title": "Automate: Granite"
	"quest.0E5FBD9105AE2934.quest_desc": [
		"Compact &aEgg + Sugar + Cinder Flour&r in a Basin (no heat needed)."
	]
	"quest.0E5FBD9105AE2934.title": "Blaze Cake Base"
	"quest.0E7AAD972EAEA28F.quest_desc": [
		"A dried kelp block and a shaft (makes 4). For the biggest builds."
	]
	"quest.0E7AAD972EAEA28F.title": "Monstrous Tire"
	"quest.0EAB97A5130F9DBA.quest_desc": [
		"Wash sand with a fan blowing through water. Make a &astack&r."
	]
	"quest.0EAB97A5130F9DBA.title": "Automate: Clay Ball"
	"quest.0EC617EE74B4E929.quest_desc": [
		"A &aFrame Trap&r (Create: Fishery Industry) on a moving contraption in water catches fish. Make a &astack&r."
	]
	"quest.0EC617EE74B4E929.title": "Automate: Raw Cod"
	"quest.0EF9790E6AD7081C.quest_desc": [
		"Kill them before they drink a potion."
	]
	"quest.0EF9790E6AD7081C.title": "Witches"
	"quest.0F1A32D940E5614D.quest_desc": [
		"Mass-produce the quantum supply chain."
	]
	"quest.0F1A32D940E5614D.title": "Quantum Automation"
	"quest.0F2155C8CF1B4D53.quest_desc": [
		"Mixer: rice, both mushrooms, carrot, potato and a bowl. Make a &astack&r (16)."
	]
	"quest.0F2155C8CF1B4D53.title": "Automate: Mushroom Rice"
	"quest.0F40CAE0D098AF0B.quest_desc": [
		"A &aMechanical Saw&r cuts andesite alloy into shafts. Make a &astack&r."
	]
	"quest.0F40CAE0D098AF0B.title": "Automate: Shaft"
	"quest.0F710C47C2A97638.quest_desc": [
		"Same parts as the Mechanical Servo, but it keeps turning step by step while a signal is"
		"held."
	]
	"quest.0F710C47C2A97638.title": "Stepper Servo"
	"quest.0F7748F4F8A801A3.quest_desc": [
		"Melon slices, ice and a stick (Mechanical Crafters). Make a &astack&r."
	]
	"quest.0F7748F4F8A801A3.title": "Automate: Melon Popsicle"
	"quest.0F8FE5F9FB341304.quest_desc": [
		"Compact gunpowder into &aPacked Gunpowder&r and put it in an &aEmpty Powder Charge&r"
		"(wool and string). More charges = more range, and more strain on the barrel."
	]
	"quest.0F8FE5F9FB341304.title": "Powder Charge"
	"quest.0F99D02B0C15D1C8.quest_desc": [
		"Iron and a brick. Cook on the stove, or swing it as a weapon."
	]
	"quest.0F99D02B0C15D1C8.title": "Skillet"
	"quest.0FB364E6D5715082.quest_desc": [
		"Compact the base, fill it with lava and feed the cakes to your burners, all without"
		"touching it. Make a &astack&r of Blaze Cakes."
	]
	"quest.0FB364E6D5715082.title": "Automate: Blaze Cakes"
	"quest.0FC5913EC2DC28C7.quest_desc": [
		"Dough, cabbage, onion, and raw chicken, pork or beef (or a brown mushroom) in the Cooking Pot."
	]
	"quest.0FC5913EC2DC28C7.title": "Dumplings"
	"quest.1010F3ECFE297C65.quest_desc": [
		"Graphite, an electron tube and a brass cartridge. Lasts 16x longer. A clean factory."
	]
	"quest.1010F3ECFE297C65.title": "Precision Filter Cartridge"
	"quest.1037456320C3F749.quest_desc": [
		"A pig pen: breed with carrots, potatoes or beetroot, kill with Deployers. Make a &astack&r."
	]
	"quest.1037456320C3F749.title": "Automate: Raw Porkchop"
	"quest.10994D153CA9FABA.quest_desc": [
		"&6Enhanced AI&r: creepers &cbreach walls&r on purpose, and zombies dig to reach you. Build"
		"thick walls, or something they cannot dig through."
	]
	"quest.10994D153CA9FABA.title": "Breachers"
	"quest.109B3C60E36DD5D4.quest_desc": [
		"Made by &aSequenced Assembly&r: a &agolden sheet&r passes Deployers adding cogwheels, large"
		"cogwheels and iron nuggets, in a loop. JEI shows each step."
	]
	"quest.109B3C60E36DD5D4.title": "Precision Mechanism"
	"quest.10AD0D22CA85F4CC.quest_desc": [
		"Crush redstone ore. Washing crushed iron ore also gives some. Make a &astack&r."
	]
	"quest.10AD0D22CA85F4CC.title": "Automate: Redstone Dust"
	"quest.10EEAA6ABB049773.quest_desc": [
		"Copper and andesite alloy. Chestplate and leggings for swimming outside the hull. Wear"
		"them with a Copper Backtank and Diving Helmet."
	]
	"quest.10EEAA6ABB049773.title": "Diving Gear"
	"quest.10F87A2D17CAB073.quest_desc": [
		"Run the blast furnace continuously. Make a &astack&r of Steel Ingots."
	]
	"quest.10F87A2D17CAB073.title": "Automate: Steel"
	"quest.10F97F3E76257275.quest_desc": [
		"Brass casing and a stick. Sets engine and propeller power from the seat."
	]
	"quest.10F97F3E76257275.title": "Throttle Lever"
	"quest.1108EED880BF4006.quest_desc": [
		"Mechanical Crafters split brass ingots into nuggets. Make a &astack&r."
	]
	"quest.1108EED880BF4006.title": "Automate: Brass Nugget"
	"quest.1129FA0B61122D2C.quest_desc": [
		"Brass, brass casing and a transmitter: a 2x2 grid of buttons for weapons and gear."
	]
	"quest.1129FA0B61122D2C.title": "Button Panel"
	"quest.112B7097521CB372.quest_desc": [
		"Mix &ablaze powder, gunpowder and magma cream&r. The start of stronger propellant."
	]
	"quest.112B7097521CB372.title": "Congealed Nitro"
	"quest.119F31071255E1D5.quest_desc": [
		"Scrubbers side by side join into one panel. A full &a5x5&r reaches up and clears the high"
		"air and the smog clouds."
	]
	"quest.119F31071255E1D5.title": "Scrubber Panel"
	"quest.11CA58893FDF2BE1.quest_desc": [
		"A pressure plate on brass casing: foot pedals for the rudder."
	]
	"quest.11CA58893FDF2BE1.title": "Pedal Module"
	"quest.11E96D23C53E1554.quest_desc": [
		"Clay blocks through a lava fan. Make a &astack&r."
	]
	"quest.11E96D23C53E1554.title": "Automate: Terracotta"
	"quest.11EA8CD56F3793DD.quest_desc": [
		"Crush iron ore or raw iron (crimsite works too). Make a &astack&r."
	]
	"quest.11EA8CD56F3793DD.title": "Automate: Crushed Raw Iron"
	"quest.11FDB45C5A84681B.quest_desc": [
		"A raid's heavy armor."
	]
	"quest.11FDB45C5A84681B.title": "Ravager"
	"quest.127AA1F33B96756E.quest_desc": [
		"Every quest under &aAssembly&r is done: 21 production lines running on their own."
	]
	"quest.127AA1F33B96756E.title": "Assembly Mastered"
	"quest.1298DB0145DC3F6E.quest_desc": [
		"The Necromancer's undead illagers."
	]
	"quest.1298DB0145DC3F6E.title": "Surrendered"
	"quest.12A25766728BDFA9.quest_desc": [
		"Moves items between a moving train (or ship, or vehicle) and storage at a station."
		"Place one on the train and one facing it on the platform. Supply runs to the front."
	]
	"quest.12A25766728BDFA9.title": "Portable Storage Interface"
	"quest.12AC683015838254.quest_desc": [
		"Wash crushed gold ore, or crush tuff with Crushing Wheels. Make a &astack&r."
	]
	"quest.12AC683015838254.title": "Automate: Gold Nugget"
	"quest.12DEA2DEFB681BBE.quest_desc": [
		"Crush raw thorium into dust, turn it into &aliquid thorium&r, and compact it in a basin"
		"(check JEI for every step)."
	]
	"quest.12DEA2DEFB681BBE.title": "Thorium Ingot"
	"quest.12ECAC1AADD5B049.quest_desc": [
		"Raw porkchops under a Slicer with a knife. Make a &astack&r."
	]
	"quest.12ECAC1AADD5B049.title": "Automate: Raw Bacon"
	"quest.13546BC248B79776.quest_desc": [
		"Grow Fir saplings and fell the trees with &aMechanical Saws&r. Leaf blocks only drop to shears:"
		"try Deployers holding shears. Make a &astack&r of each."
	]
	"quest.13546BC248B79776.title": "Automate: Fir"
	"quest.135D466BB447FEEE.quest_desc": [
		"Brass casing, electron tube and precision mechanism. Shows radar contacts."
	]
	"quest.135D466BB447FEEE.title": "Monitor"
	"quest.135F39054A742654.quest_desc": [
		"&eThis pack's own item:&r mix an &aEnder Pearl + 250 mB Telejuice&r in a Basin."
		"Replaces ender pearls in waystone recipes."
	]
	"quest.135F39054A742654.title": "Quantum Pearl"
	"quest.1360814D51B29322.quest_desc": [
		"&aIndustrial Iron Blocks&r and &acast iron&r. Build the oven multiblock (see its Ponder)."
	]
	"quest.1360814D51B29322.title": "Coke Oven"
	"quest.136F496D90F393CB.quest_desc": [
		"Every crop and every meat in the pack, automated."
	]
	"quest.136F496D90F393CB.title": "Master Farmer"
	"quest.1379459167819F72.quest_desc": [
		"Make a &astack&r of Electron Tubes without crafting them by hand (Deployers on a belt work)."
	]
	"quest.1379459167819F72.title": "Automate: Electron Tubes"
	"quest.13DA2722EF75F739.quest_desc": [
		"Compact chocolate (Mixer: milk, sugar, cocoa beans) with a Press over a basin. Make a &astack&r."
		""
		"&7Needs milk from Animal Product Automation."
	]
	"quest.13DA2722EF75F739.title": "Automate: Bar of Chocolate"
	"quest.13F1284AC1E75833.quest_desc": [
		"Raw cod slices have no smoking recipe: blow them through &alava&r (blasting), or slice"
		"cooked cod. Make a &astack&r."
	]
	"quest.13F1284AC1E75833.title": "Automate: Cooked Cod Slice"
	"quest.142907BF4AC1001F.quest_desc": [
		"Milk, wool, leather, eggs and feathers from farms that run themselves."
	]
	"quest.142907BF4AC1001F.title": "Animal Product Automation"
	"quest.142E80308593260C.quest_desc": [
		"Crushed ore through a fan blowing through lava smelts it, with a better yield than raw ore."
	]
	"quest.142E80308593260C.title": "Ingots"
	"quest.14598E93ADD43738.quest_desc": [
		"2 cooked bacon, 2 fried eggs and a bowl. Make a &astack&r (16)."
	]
	"quest.14598E93ADD43738.title": "Automate: Bacon and Eggs"
	"quest.14817DE690D788A0.quest_desc": [
		"A Press over a belt of iron ingots. Make a &astack&r of Iron Sheets."
	]
	"quest.14817DE690D788A0.title": "Automate: Iron Sheets"
	"quest.14882C77E4C621EF.quest_desc": [
		"Crushing ores drops experience nuggets as a bonus (iron and copper ore do). Make a &astack&r."
	]
	"quest.14882C77E4C621EF.title": "Automate: Nugget of Experience"
	"quest.14939665A825B598.quest_desc": [
		"Lets hoppers, funnels and pipes insert into and extract from the whole network."
	]
	"quest.14939665A825B598.title": "Inventory Interface"
	"quest.149E2F64521FBDE6.quest_desc": [
		"Wear it with the backtank to breathe from it."
	]
	"quest.149E2F64521FBDE6.title": "Copper Diving Helmet"
	"quest.14AE92114CC90F48.quest_desc": [
		"Cook kelp in a furnace, smoker or on a campfire. Later, an &aEncased Fan&r blowing"
		"through fire does it in bulk."
	]
	"quest.14AE92114CC90F48.title": "Dried Kelp"
	"quest.14B98BF46C51736C.quest_desc": [
		"The same recipe with a &aShaft&r in place of the chute. Sends rotation to every"
		"Energy Transmitter on the Network: power a front-line base from home."
	]
	"quest.14B98BF46C51736C.title": "Energy Transmitter"
	"quest.14BCD8B12AE6EF84.quest_desc": [
		"The biggest bomb. Mechanical crafting around a Large Bomb, with a precision mechanism and"
		"sturdy sheets. &cBe careful where you drop it.&r"
	]
	"quest.14BCD8B12AE6EF84.title": "MOAB"
	"quest.14DD63CA2A19993C.quest_desc": [
		"Mixer: 3 beetroot and a bowl. Make a &astack&r (16)."
	]
	"quest.14DD63CA2A19993C.title": "Automate: Beetroot Soup"
	"quest.14ED0DFC2655F555.quest_desc": [
		"Roll a copper ingot."
	]
	"quest.14ED0DFC2655F555.title": "Copper Rod"
	"quest.14F05E34C1274D70.quest_desc": [
		"A Press over a basin compacts 4 magma cream into a block. Make a &astack&r."
	]
	"quest.14F05E34C1274D70.title": "Automate: Magma Block"
	"quest.14F4496BA65A8740.quest_desc": [
		"A fire caster. Found at Firecaller huts."
	]
	"quest.14F4496BA65A8740.title": "Firecaller"
	"quest.14F99FFA53D598FD.quest_desc": [
		"Where the round goes in: heavy plates, steel plates, steel blocks and a &aSteel"
		"Mechanism&r (mechanical crafting)."
	]
	"quest.14F99FFA53D598FD.title": "Arcon Barrel Section (Breech)"
	"quest.1529F2A9136540B7.quest_desc": [
		"Every quest under &aForestry&r is done: 21 production lines running on their own."
	]
	"quest.1529F2A9136540B7.title": "Forestry Mastered"
	"quest.157B57B8355906AB.quest_desc": [
		"Heavy casing, steel mechanism and electron tube. Finds &aoil deposits&r underground."
	]
	"quest.157B57B8355906AB.title": "Surface Scanner"
	"quest.158949282D4A6D1F.quest_desc": [
		"Every quest under &aBrass&r is done: 5 production lines running on their own."
	]
	"quest.158949282D4A6D1F.title": "Brass Mastered"
	"quest.15F2EF2491DD22B5.quest_desc": [
		"Fishing loot: a &aFrame Trap&r on a moving contraption in water pulls up mussels. Make a &astack&r."
	]
	"quest.15F2EF2491DD22B5.title": "Automate: Raw Mediterranean Mussel"
	"quest.15F66045D0C797A4.quest_desc": [
		"A long-range guided missile: set its target with the Target Gunner Gadget."
	]
	"quest.15F66045D0C797A4.title": "Tomahawk"
	"quest.162B154459B5939E.quest_desc": [
		"Stonecut an iron block. Steam 'n' Rails' armored train plating. With &6CBC Locometal"
		"Armor&r it resists cannon fire."
	]
	"quest.162B154459B5939E.title": "Riveted Locometal"
	"quest.1644ECEFAD7DDC5C.quest_desc": [
		"A copper sheet and copper ingots. Pipes connect tanks and machines. They carry nothing on"
		"their own: they need a pump."
	]
	"quest.1644ECEFAD7DDC5C.title": "Fluid Pipe"
	"quest.1652FAEEF42E8E51.quest_desc": [
		"&6Create: Dragons Plus&r: an item drain and a copper ingot. A drain that works on"
		"contraptions."
	]
	"quest.1652FAEEF42E8E51.title": "Fluid Hatch"
	"quest.1700A4738A7B371C.quest_desc": [
		"&aMechanical Crafting&r: copper spool, iron rods and sheets, andesite alloy. Turns rotation"
		"into electricity: put one on your steam engines' shaft."
	]
	"quest.1700A4738A7B371C.title": "Alternator"
	"quest.170A73A299563CC2.quest_desc": [
		"Iron nuggets (crafting or sequenced assembly). Nailgun ammo."
	]
	"quest.170A73A299563CC2.title": "Nails"
	"quest.17101C72A1903A91.quest_desc": [
		"&6Who Touched My Train&r: iron. Lock your train so only key holders can drive it."
	]
	"quest.17101C72A1903A91.title": "Iron Key"
	"quest.1735BB1FF6FB4780.quest_desc": [
		"Emergency air. Soul fire, soul torches and soul campfires also make small pockets of"
		"breathable air."
	]
	"quest.1735BB1FF6FB4780.title": "Bottle of Soulfire"
	"quest.1738721036346250.quest_desc": [
		"A propeller, nozzle, item drain, redstone link and electron tube. Spreads the"
		"electrolyzer's oxygen through the hull."
	]
	"quest.1738721036346250.title": "Oxygen Diffuser"
	"quest.173ABC8BE01255D1.quest_desc": [
		"Farmer's Delight crop from wild onions. Harvester rows. Make a &astack&r."
	]
	"quest.173ABC8BE01255D1.title": "Automate: Onion"
	"quest.17A6D73E23678BDD.quest_desc": [
		"Deep dark. Probably best avoided."
	]
	"quest.17A6D73E23678BDD.title": "The Warden"
	"quest.17B1845142FA92B6.quest_desc": [
		"Mixer: glow berries, milk, an egg, sugar and a glass bottle. Make a &astack&r (16)."
		""
		"&7Needs milk and eggs from Animal Product Automation."
	]
	"quest.17B1845142FA92B6.title": "Automate: Glow Berry Custard"
	"quest.17E18F4C217EB8F5.quest_desc": [
		"Crafted from a button panel: a 3x3 grid."
	]
	"quest.17E18F4C217EB8F5.title": "Button Keypad"
	"quest.1810AAC17B0A938A.quest_desc": [
		"Craft &aQuartz&r with &aredstone dust&r to make &aRose Quartz&r."
	]
	"quest.1810AAC17B0A938A.title": "Rose Quartz"
	"quest.1812CCA684B685B6.quest_desc": [
		"Every quest under &aFan Processing&r is done: 5 production lines running on their own."
	]
	"quest.1812CCA684B685B6.title": "Fan Processing Mastered"
	"quest.18C30ADB760AAE42.quest_desc": [
		"Copper casing, Block of Experience and a sponge."
	]
