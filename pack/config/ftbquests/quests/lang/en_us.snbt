		"Pushes and pulls parts of your craft precisely."
	]
	"quest.5083A2BCC04083A8.title": "Hydraulic Linear Actuator"
	"quest.5098E62B79F885D8.quest_desc": [
		"&6Enhanced AI&r: skeletons aim better and keep their distance. Fight from cover."
	]
	"quest.5098E62B79F885D8.title": "Snipers"
	"quest.50CD930018A90F12.quest_desc": [
		"Everything quantum starts in &dthe End&r: bring back &achorus fruit&r (and plant some)."
	]
	"quest.50CD930018A90F12.title": "Chorus Fruit"
	"quest.5116C8CBF8F4C26B.quest_desc": [
		"Andesite casing, piston pole and gunpowder. Pushes charges and shells into the breech."
	]
	"quest.5116C8CBF8F4C26B.title": "Cannon Loader"
	"quest.515DC0FA59FD5614.quest_desc": [
		"Row, row, row."
	]
	"quest.515DC0FA59FD5614.title": "Oar of Boat"
	"quest.5194AC4C99BEB854.quest_desc": [
		"Mechanical crafting with a propeller and an impact fuze. Sinks ships."
	]
	"quest.5194AC4C99BEB854.title": "Sea Torpedo"
	"quest.521CA3B1F77D8E70.quest_desc": [
		"Create trains run on &aTrain Track&r."
	]
	"quest.521CA3B1F77D8E70.title": "Train Track"
	"quest.528707EC128E396E.quest_desc": [
		"Iron plates, copper, a note block and a shaft. Warn your base when bombers come."
	]
	"quest.528707EC128E396E.title": "Air-Raid Siren"
	"quest.5329946572EF2539.quest_desc": [
		"Press a &aBlock of Experience&r into an &aEnchanting Template&r."
	]
	"quest.5329946572EF2539.title": "Enchanting Template"
	"quest.537966C61051FF3E.quest_desc": [
		"Loop the sequenced assembly line so it runs unattended. Make &a5 Precision Mechanisms&r."
	]
	"quest.537966C61051FF3E.title": "Automate: Precision Mechanisms"
	"quest.53A9557C86F6A159.quest_desc": [
		"A storage terminal with a crafting grid that pulls straight from the network."
	]
	"quest.53A9557C86F6A159.title": "Crafting Terminal"
	"quest.53C1D57D1C14787F.quest_desc": [
		"You've built the core Andesite machines. This &aunlocks the Brass Age&r, and the"
		"&6Automation&r chapter has goals for putting these machines to work."
		""
		"&7Requires: Press and Depot, Basin and Mixer, Belts and Iron Sheets.&r"
		""
		"Next up: you'll need a captured &cBlaze&r to make brass."
	]
	"quest.53C1D57D1C14787F.title": "Andesite Age Complete"
	"quest.53FCAEF396A40468.quest_desc": [
		"Sequenced assembly: Advanced Component, sturdy sheet and &dTelejuice&r. The heart of every"
		"teleporter."
	]
	"quest.53FCAEF396A40468.title": "Quantum Mechanism"
	"quest.5459DE3C6BCF979E.quest_desc": [
		"See under water. (A different block from the Air War sonar.)"
	]
	"quest.5459DE3C6BCF979E.title": "Sonar (Deep Seas)"
	"quest.5480C8B5E1657A00.quest_desc": [
		"Holds a belt of autocannon rounds for continuous fire."
	]
	"quest.5480C8B5E1657A00.title": "Autocannon Ammo Container"
	"quest.54A10483D0EE3E7F.quest_desc": [
		"&6Create: High Seas&r. Boats are Sable physics objects too (see the Physics Assembler in"
		"Aeronautics). A rudder steers."
	]
	"quest.54A10483D0EE3E7F.title": "Rudder"
	"quest.54DE44FFAE0A9DDE.quest_desc": [
		"&6Sophisticated Backpacks&r: leather, string and a chest. Wear it or place it."
	]
	"quest.54DE44FFAE0A9DDE.title": "Backpack"
	"quest.54F28171B8869203.quest_desc": [
		"Made with an iron sheet. A &aMechanical Harvester&r on a moving contraption harvests"
		"fully grown crops and replants them: the basis of any farm."
	]
	"quest.54F28171B8869203.title": "Mechanical Harvester"
	"quest.55133A80FE1B9D72.quest_desc": [
		"Break tall grass or wheat with a knife."
	]
	"quest.55133A80FE1B9D72.title": "Straw"
	"quest.5616C2CB21D1F5E0.quest_desc": [
		"Goes off on contact. Put a fuze on a shell before loading it."
	]
	"quest.5616C2CB21D1F5E0.title": "Impact Fuze"
	"quest.5654679C05A47678.quest_desc": [
		"&aLevitite&r provides lift: build it into a hull to make it float."
	]
	"quest.5654679C05A47678.title": "Levitite"
	"quest.56C06FAADEC153C4.quest_desc": [
		"Blaze burner, brass and iron sheets: welds cannon parts together."
	]
	"quest.56C06FAADEC153C4.title": "Cannon Welder"
	"quest.56DD42619431371D.quest_desc": [
		"A long barrel for the flintlock: more range."
	]
	"quest.56DD42619431371D.title": "Musket Barrel"
	"quest.57B7CCC186625ABD.quest_desc": [
		"Your first bucket of &acrude oil&r."
	]
	"quest.57B7CCC186625ABD.title": "Crude Oil"
	"quest.58136A6ECBF2CA4A.quest_desc": [
		"Mount blades on a &aPropeller Bearing&r and spin it for thrust."
	]
	"quest.58136A6ECBF2CA4A.title": "Propeller Bearing"
	"quest.58281E71C2982F6E.quest_desc": [
		"&6CBC Ballistic Computer&r: calculates trajectories so you can hit what you aim at."
	]
	"quest.58281E71C2982F6E.title": "Ballistic Computer"
	"quest.58601A41B035E394.quest_desc": [
		"Right-click a placed chest or barrel with a tier upgrade to make it bigger &awithout"
		"emptying it&r. Copper first (copper ingots and a lever), then up the tiers."
	]
	"quest.58601A41B035E394.title": "Chest Tier Upgrades"
	"quest.591FA47EC216B85D.quest_desc": [
		"Some recipes need a &6Superheated&r burner. This pack has three fuel tiers, and each one"
		"needs superheat to produce, so you climb them in order:"
		""
		"&61. Blaze Cake&r: 2 min 40 s per cake"
		"&62. Biofuel&r: 20 min per bucket"
		"&63. Napalm&r: 1 hour per bucket (made in the &6Industrial Age&r)"
	]
	"quest.591FA47EC216B85D.title": "Fuel Tiers"
	"quest.593880FB761DDE5A.quest_desc": [
		"Mechanical crafting: precision mechanism, electron tube, brass and sturdy sheets, a"
		"propeller, a powder charge, guncotton and an impact fuze."
	]
	"quest.593880FB761DDE5A.title": "Cruise Missile"
	"quest.597A3E429F55275A.quest_desc": [
		"Doors that work on a moving train."
	]
	"quest.597A3E429F55275A.title": "Train Door"
	"quest.598BE4ADE1531AFA.quest_desc": [
		"Drives your boat through the water."
	]
	"quest.598BE4ADE1531AFA.title": "Boat Engine"
	"quest.59C4C64E295DD12D.quest_desc": [
		"Fine maneuvering under water."
	]
	"quest.59C4C64E295DD12D.title": "Water Thruster"
	"quest.59C7A4B8DD096B55.quest_desc": [
		"Tilts rotors to steer."
	]
	"quest.59C7A4B8DD096B55.title": "Tilting Propeller Bearing"
	"quest.5A3BA4624706AB01.quest_desc": [
		"Industrial iron, an electron tube and a lightning rod."
	]
	"quest.5A3BA4624706AB01.title": "Radar Receiver"
	"quest.5AFAAE84D66D6BA3.quest_desc": [
		"Thin air down here too (see Pollution and Air): bring a backtank."
	]
	"quest.5AFAAE84D66D6BA3.title": "Into the Nether"
	"quest.5B0A036B4AB20650.quest_desc": [
		"The press form for shotgun shells."
	]
	"quest.5B0A036B4AB20650.title": "Shotgun Shell Press Form"
	"quest.5B0AB69264381253.quest_desc": [
		"Adds a &aprecision mechanism&r and a cogwheel to the steel-and-brass build."
	]
	"quest.5B0AB69264381253.title": "Gatling"
	"quest.5B24BCB91BBD80FB.quest_desc": [
		"&6Tom's Simple Storage&r is this pack's storage network. The &aInventory Connector&r"
		"joins every touching chest, barrel and vault into one network. Needs a diamond and an"
		"ender pearl."
	]
	"quest.5B24BCB91BBD80FB.title": "Inventory Connector"
	"quest.5B2A171A8BB00B84.quest_desc": [
		"Iron, bricks and a campfire. The heat source for pots and skillets."
	]
	"quest.5B2A171A8BB00B84.title": "Stove"
	"quest.5B90707D8FDB5662.quest_desc": [
		"Outputs redstone when a train passes."
	]
	"quest.5B90707D8FDB5662.title": "Train Observer"
	"quest.5B9696024A7D8AC9.quest_desc": [
		"Items you walk over go straight into the backpack."
	]
	"quest.5B9696024A7D8AC9.title": "Pickup Upgrade"
	"quest.5BC063A06F708BDE.quest_desc": [
		"The submarine's command console."
	]
	"quest.5BC063A06F708BDE.title": "Onboard Computer"
	"quest.5C326BE896F9406D.quest_desc": [
		"The furnace makes &amolten steel&r; cast it into &aSteel Ingots&r."
	]
	"quest.5C326BE896F9406D.title": "Steel"
	"quest.5C8F73A18227EF75.quest_desc": [
		"&6Steam 'n' Rails&r adds more to trains: a handcar for quick trips."
	]
	"quest.5C8F73A18227EF75.title": "Handcar"
	"quest.5D03F1D941E5D2B8.quest_desc": [
		"Made with iron sheets. A &aMechanical Drill&r mines whatever is in front of it: the heart"
		"of cobblestone generators and tunnel borers."
	]
	"quest.5D03F1D941E5D2B8.title": "Mechanical Drill"
	"quest.5D19704DF98EF7C1.quest_desc": [
		"The strongest barrels are &abuilt up&r from steel layers with a Cannon Builder, then"
		"bored with a Cannon Drill. Check the Ponder."
	]
	"quest.5D19704DF98EF7C1.title": "Built-Up Steel Cannon"
	"quest.5E4C130E5B208860.quest_desc": [
		"&6Create: Armored Constructs&r: tank-style vehicle cannons."
	]
	"quest.5E4C130E5B208860.title": "Arcon Cannon Barrel"
	"quest.5F40C639C270FBD0.quest_desc": [
		"Bastion guards. They never calm down."
	]
	"quest.5F40C639C270FBD0.title": "Piglin Brute"
	"quest.5F57791FE7C5E54E.quest_desc": [
		"Mechanical crafting: brass and steel sheets, andesite alloy and a stripped log."
	]
	"quest.5F57791FE7C5E54E.title": "Shotgun"
	"quest.60A8E36CAE45E950.quest_desc": [
		"&eThis pack's own recipe:&r &aCrushing Wheels&r crushing &aNether Bricks&r (the block) have a"
		"&a5% chance&r to drop &aNetherite Scrap&r. Netherrack is endless, so this is renewable."
		"(Ancient Debris blown through lava with a fan works too.)"
		""
		"Then let &aMechanical Crafters&r run the normal recipe: &a4 Netherite Scrap + 4 Gold Ingots&r"
		"= 1 Netherite Ingot. Make &a4 Netherite Ingots&r."
	]
	"quest.60A8E36CAE45E950.title": "Automate: Netherite"
	"quest.60B90AF4C95E818F.quest_desc": [
		"Mix &acopper&r and &azinc&r in a Basin over a lit Blaze Burner."
	]
	"quest.60B90AF4C95E818F.title": "Brass Ingot"
	"quest.610E62DABE42F45B.quest_desc": [
		"Crush &azinc ore&r, wash the crushed ore with a fan, and smelt it. Make a &astack&r of Zinc"
		"Ingots."
	]
	"quest.610E62DABE42F45B.title": "Automate: Ore Processing"
	"quest.6112990A4F373F3B.quest_desc": [
		"Compact &aseeds&r into Seed Oil, then mix plants (crops, leaves, saplings, flowers) with"
		"&a100 mB of Seed Oil&r over a &6heated&r burner to make &aBiomass&r."
	]
	"quest.6112990A4F373F3B.title": "Biomass"
	"quest.6117481665174663.quest_desc": [
		"&6Create: Slice and Dice&r: a cogwheel, andesite casing and turntable. Put a knife in it"
		"and it runs &acutting board recipes&r on items below it, like a press on a depot or belt."
		"Check the Ponder."
	]
	"quest.6117481665174663.title": "Slicer"
	"quest.614588AD6D3684C0.quest_desc": [
		"Add a lead nugget to a blank round."
	]
	"quest.614588AD6D3684C0.title": "Revolver Round"
	"quest.61EA0CE43165502E.quest_desc": [
		"Fly it yourself: a &aSteering Wheel&r on your craft lets you steer from the seat."
	]
	"quest.61EA0CE43165502E.title": "Steering Wheel"
	"quest.628849AB04278591.quest_desc": [
		"Brass sheet, compass, electron tube, steel and precision mechanism: steers the missile"
		"onto a radar track."
	]
	"quest.628849AB04278591.title": "Guidance Computer"
	"quest.62C2BF76845D80A0.quest_desc": [
		"A &aBasin&r holds ingredients; a &aMechanical Mixer&r above it mixes them, and a Press"
		"above it compacts them. Many recipes need &6heat&r from a burner under the basin; you'll"
		"get there in the next two chapters."
	]
	"quest.62C2BF76845D80A0.title": "Basin and Mixer"
	"quest.62D79935090F608A.quest_desc": [
		"Built from &afireproof bricks&r with a &aBlast Furnace Output&r (cast iron block, pipe) and"
		"a hatch. Check the Ponder for the full multiblock."
	]
	"quest.62D79935090F608A.title": "Blast Furnace"
	"quest.62E11FB1B49183D9.quest_desc": [
		"Slowness arrows in cold biomes."
	]
	"quest.62E11FB1B49183D9.title": "Strays"
	"quest.62E99830472736C1.quest_desc": [
		"Iron sheets: flat radar panels."
	]
	"quest.62E99830472736C1.title": "Radar Plate"
	"quest.6306F2A0E0D78360.quest_desc": [
		"Sequenced assembly with heavy plates, lead and nickel sheets, steel cogwheels and screws."
		"JEI shows every step."
	]
	"quest.6306F2A0E0D78360.title": "Steel Mechanism"
	"quest.636673A39A09D339.quest_desc": [
		"Gunpowder, iron plate, shot balls and a pressure plate."
	]
	"quest.636673A39A09D339.title": "Small Mine"
	"quest.6393779977E23D30.quest_desc": [
		"Redstone torch, lever, copper and iron plate. Sets off your C4."
	]
	"quest.6393779977E23D30.title": "Detonator"
	"quest.64156283A7F5D425.quest_desc": [
		"Press brass ingots into &aBrass Sheets&r on a Depot, like iron and gold."
	]
	"quest.64156283A7F5D425.title": "Brass Sheets"
	"quest.653667B88343242F.quest_desc": [
		"For when they get too close."
	]
	"quest.653667B88343242F.title": "Bayonet"
	"quest.658C20D3D998E1FC.quest_desc": [
		"Crush or mill charcoal."
	]
	"quest.658C20D3D998E1FC.title": "Charcoal Dust"
	"quest.65B386CAEB47A994.quest_desc": [
		"&6Synaxis&r: precision controls for Sable craft (circuits, Lua, motors and actuators)."
	]
	"quest.65B386CAEB47A994.title": "Control Chair"
	"quest.661BA95EC4E158D5.quest_desc": [
		"Hearty and simple."
	]
	"quest.661BA95EC4E158D5.title": "Vegetable Soup"
	"quest.6629BCD414634293.quest_desc": [
		"Every Warnautics explosive uses &aPacked Guncotton&r, Big Cannons' high explosive"
		"(check JEI for how it's made)."
	]
	"quest.6629BCD414634293.title": "Packed Guncotton"
	"quest.663C120074F50910.quest_desc": [
		"A waystone shared by everyone who uses the same color. Uses Quantum Casings too."
	]
	"quest.663C120074F50910.title": "Sharestone"
	"quest.663EC1BF344C859B.quest_desc": [
		"Call your train."
	]
	"quest.663EC1BF344C859B.title": "Conductor Whistle"
	"quest.66447527701EAC29.quest_desc": [
		"Shows the wind."
	]
	"quest.66447527701EAC29.title": "Wind Vane"
	"quest.666707D21D56B27F.quest_desc": [
		"Read water pressure at a glance."
	]
	"quest.666707D21D56B27F.title": "Pressure Goggles"
	"quest.669054B8698F5052.quest_desc": [
		"Lift and thrust."
	]
	"quest.669054B8698F5052.title": "Drone Propeller"
	"quest.66C3EC98853BC5DF.quest_desc": [
		"&6CBC Aeronautics Missiles&r: brass casing, steel, iron sheet and precision mechanism."
		"Launches guided missiles."
	]
	"quest.66C3EC98853BC5DF.title": "Missile Mount"
	"quest.672FD2FD5E0B970A.quest_desc": [
		"Dropped from aircraft into water."
	]
	"quest.672FD2FD5E0B970A.title": "Aerial Torpedo"
	"quest.67454231A804793A.quest_desc": [
		"The Coke Oven bakes &acoal&r into &aCoal Coke&r, the fuel for the blast furnace."
	]
	"quest.67454231A804793A.title": "Coal Coke"
	"quest.674633D31D85B876.quest_desc": [
		"&aAndesite Casing&r, a &aBrass Hand&r and an &aElectron Tube&r. A Deployer uses items like"
		"a player (placing, clicking, applying), and it's the key machine for sequenced assembly."
	]
	"quest.674633D31D85B876.title": "Deployer"
	"quest.679F6C0F323E288F.quest_desc": [
		"Simple, cheap blades."
	]
	"quest.679F6C0F323E288F.title": "Wooden Propeller"
	"quest.67A8D26B5BBD67D5.quest_desc": [
		"Feed copper and zinc into a heated Mixer automatically. Make a &astack&r of Brass Ingots."
	]
	"quest.67A8D26B5BBD67D5.title": "Automate: Brass"
	"quest.681D7475EC18C5EA.quest_desc": [
		"Underwater thrust."
	]
	"quest.681D7475EC18C5EA.title": "Submarine Propeller"
	"quest.6831CB5CFFFE83CA.quest_desc": [
		"Casings make machines tidy and are an ingredient in many recipes, including &dwaystones&r."
	]
	"quest.6831CB5CFFFE83CA.title": "Andesite Casing"
	"quest.689AB4054B803CCE.quest_desc": [
		"Uses a &aMechanical Arm&r: pick targets for your missiles."
	]
	"quest.689AB4054B803CCE.title": "Targeting Interface"
	"quest.690304EEF8A85B66.quest_desc": [
		"The first Create material. Combine &aandesite&r with &airon nuggets&r (or zinc nuggets)."
		"Check &aJEI&r for the recipe: press &aU&r on an item to see how it's made."
	]
	"quest.690304EEF8A85B66.title": "Andesite Alloy"
	"quest.6965B2C1A9D2D96A.quest_desc": [
		"Heats basins and boilers with liquid fuel. Very dirty on waste oil, clean on refined oil."
	]
	"quest.6965B2C1A9D2D96A.title": "Oil Burner"
	"quest.6A0F5E3A470D0D6D.quest_desc": [
		"Brass casing, electron tube, Quantum Mechanism and Redstone Pearl. Fill it with"
		"&dTelejuice&r to teleport to a paired destination."
	]
	"quest.6A0F5E3A470D0D6D.title": "Entity Teleporter"
	"quest.6A3136FC8C67D6A5.quest_desc": [
		"Copper, glass panes and string. Spot targets by eye before you track them by radar."
	]
	"quest.6A3136FC8C67D6A5.title": "Binoculars"
	"quest.6A815378A5DE98C6.quest_desc": [
		"&6Create Deep Seas&r. Flood and empty &aBallast Tanks&r to dive and surface."
	]
	"quest.6A815378A5DE98C6.title": "Ballast Tank"
	"quest.6A99365878ECA1A9.quest_desc": [
		"Tomatoes in the pot."
	]
	"quest.6A99365878ECA1A9.title": "Tomato Sauce"
	"quest.6AF6E11AB857B769.quest_desc": [
		"&aPolished Rose Quartz&r on an &aIron Sheet&r: the 'circuit' of Create machines."
	]
	"quest.6AF6E11AB857B769.title": "Electron Tube"
	"quest.6BB4725031FEA927.quest_desc": [
		"Mark a spot on the water."
	]
	"quest.6BB4725031FEA927.title": "Buoy"
	"quest.6BEC794B9B7ED2B9.quest_desc": [
		"Belts are made from &adried kelp&r. Gather &akelp&r from any ocean."
	]
	"quest.6BEC794B9B7ED2B9.title": "Kelp"
	"quest.6C3CFAF816C70C1A.quest_desc": [
		"&6Trigger Mobs&r: some mobs spawn &ccarrying guns&r and fire them at you. Armor up and"
		"keep moving."
	]
	"quest.6C3CFAF816C70C1A.title": "Armed and Dangerous"
	"quest.6CFFC5E6FB4D423C.quest_desc": [
		"&eChanged in this pack:&r brewing Biofuel now needs a &6Superheated&r burner. Mix"
		"&aSugar + Cinder Flour + 2 Biomass&r to make &a125 mB&r."
		""
		"Bootstrap it with Blaze Cakes. Once it's running, Biofuel can keep its own mixer hot."
	]
	"quest.6CFFC5E6FB4D423C.title": "Tier 2: Biofuel"
	"quest.6D0FA79299F60AAC.quest_desc": [
		"Bricks, iron, a water bucket and a wooden shovel. Put it on a stove and cook meals that"
		"give &aNourishment&r and &aComfort&r."
	]
	"quest.6D0FA79299F60AAC.title": "Cooking Pot"
	"quest.6D4D3B1AE4194237.quest_desc": [
		"Grinds items: gravel to flint, flowers to dye, and more. Look up any item in JEI under"
		"&aMilling&r."
	]
	"quest.6D4D3B1AE4194237.title": "Millstone"
	"quest.6D7A35883B8B3DFF.quest_desc": [
		"Bigger wheel, more power: a &aLarge Water Wheel&r gives far more stress capacity, at a"
		"slower speed. Gear it up with a large-to-small cogwheel pair."
	]
	"quest.6D7A35883B8B3DFF.title": "Large Water Wheel"
	"quest.6DA7A77B9BBA1369.quest_desc": [
		"A propeller you can control."
	]
	"quest.6DA7A77B9BBA1369.title": "Smart Propeller"
	"quest.6DFA7706AC394262.quest_desc": [
		"Zinc: the missile body that carries the warhead."
	]
	"quest.6DFA7706AC394262.title": "Payload Casing"
	"quest.6F217E9F810098F7.quest_desc": [
		"Compact industrial sludge. Crush it for dust and a chance of metals, or smelt it into brick."
	]
	"quest.6F217E9F810098F7.title": "Sludge Cake"
	"quest.6F3BBA2B34BC0A91.quest_desc": [
		"Electron tube, iron plates, brass nuggets and redstone. Marks targets."
	]
	"quest.6F3BBA2B34BC0A91.title": "Target Designator"
	"quest.6FC902C0AAB2722B.quest_desc": [
		"&eChanged in this pack:&r mechanical crafting with &a7 Quantum Pearls&r, amethyst and"
		"emeralds."
	]
	"quest.6FC902C0AAB2722B.title": "Warp Stone"
	"quest.708ABE7F0EE91DFA.quest_desc": [
		"&eChanged in this pack:&r every scroll is made from &dQuantum Paper&r."
