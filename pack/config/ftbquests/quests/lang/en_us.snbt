{
	"chapter.053911DC66C6FCCC.chapter_subtitle": [
		"Superheating and this pack's fuel tiers"
	]
	"chapter.053911DC66C6FCCC.title": "Heat Expansion"
	"chapter.0A8F7FB8A84C2634.chapter_subtitle": [
		"Heated mixing, brass, precision parts and ore processing"
