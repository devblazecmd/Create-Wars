	"quest.3B2B86194B0D7B30.title": "Backpack Upgrade Base"
	"quest.3B31101BA6D1CD75.quest_desc": [
		"Electron tube, precision mechanism and redstone: shells that steer."
	]
	"quest.3B31101BA6D1CD75.title": "Guided Fuze"
	"quest.3B3CD1F476F29F0A.quest_desc": [
		"Bread, cooked mutton, a leafy green and onion. Make a &astack&r."
	]
	"quest.3B3CD1F476F29F0A.title": "Automate: Mutton Wrap"
	"quest.3B5F548390851EEA.quest_desc": [
		"Crush nickel ore or raw nickel. Make a &astack&r."
	]
	"quest.3B5F548390851EEA.title": "Automate: Crushed Raw Nickel"
	"quest.3B82772AE6E8EDFF.quest_desc": [
		"Mixer: raw cod, potato, tomato, an egg and a bowl. Make a &astack&r (16)."
		""
		"&7Needs eggs from Animal Product Automation."
	]
	"quest.3B82772AE6E8EDFF.title": "Automate: Baked Cod Stew"
	"quest.3BABEFE16AC81C7F.quest_desc": [
		"A seat, a transmitter and a precision mechanism. Command your drones from a vehicle."
	]
	"quest.3BABEFE16AC81C7F.title": "Commander Seat"
	"quest.3BCB9BC5F3C84756.quest_desc": [
		"Wild cabbages grow near beaches. Cut them with a knife for seeds."
	]
	"quest.3BCB9BC5F3C84756.title": "Cabbage"
	"quest.3BD3289A683A729A.quest_desc": [
		"Cast iron and iron (makes 8). Armor-piercing ammo for the autocannon."
	]
	"quest.3BD3289A683A729A.title": "AP Autocannon Round"
	"quest.3BD47489393A7320.quest_desc": [
		"Find a &cBlaze&r (a Nether fortress blaze spawner is ideal) and use the Empty Blaze Burner"
		"on it to capture it."
		""
		"Feed it fuel (coal, logs) and it heats a Basin above it: &6Heated&r."
	]
	"quest.3BD47489393A7320.title": "Catch a Blaze"
	"quest.3BEAA6EE640B6112.quest_desc": [
		"Dried kelp on &aMechanical Crafters&r. Make a &astack&r."
	]
	"quest.3BEAA6EE640B6112.title": "Automate: Mechanical Belt"
	"quest.3BF3768260E3F121.quest_desc": [
		"&aCogwheels&r pass rotation sideways to other cogs. Pairing a &alarge&r and a &asmall&r"
		"cogwheel doubles or halves the speed."
	]
	"quest.3BF3768260E3F121.title": "Cogwheels"
	"quest.3BF6E02C1B19C2F7.quest_desc": [
		"Ingots, blocks and sheets: a &aMechanical Press&r over a basin compacts, over a belt it flattens."
	]
	"quest.3BF6E02C1B19C2F7.title": "Metals"
	"quest.3C0083216B96355F.quest_desc": [
		"A rapid-fire cannon from a cast &abreech&r and &abarrel&r. Feeds on cartridges."
	]
	"quest.3C0083216B96355F.title": "Autocannon"
	"quest.3C1DF54BD2B58369.quest_desc": [
		"Salmon steaks through a smoking fan. Make a &astack&r."
	]
	"quest.3C1DF54BD2B58369.title": "Automate: Cooked Salmon Steak"
	"quest.3C79CDB58B8E9FF4.quest_desc": [
		"Every quest under &aBlaze Fuel&r is done: 5 production lines running on their own."
	]
	"quest.3C79CDB58B8E9FF4.title": "Blaze Fuel Mastered"
	"quest.3D18216C0DC91D67.quest_desc": [
		"&6Create Crafts and Additions&r electricity starts here. Andesite casing, andesite alloy, iron"
		"sheets and a shaft. Rolls ingots into rods and sheets into wire."
	]
	"quest.3D18216C0DC91D67.title": "Rolling Mill"
	"quest.3D42DEA97763E9D2.quest_desc": [
		"Settle wastewater in a basin with a mixer."
	]
	"quest.3D42DEA97763E9D2.title": "Clarified Water"
	"quest.3DA1AB3F86870E76.quest_desc": [
		"Sand through a fan blowing through lava. Make a &astack&r."
	]
	"quest.3DA1AB3F86870E76.title": "Automate: Glass"
	"quest.3DDDAE7916041D79.quest_desc": [
		"A shield-bearing brute. Get around the shield."
	]
	"quest.3DDDAE7916041D79.title": "Basher"
	"quest.3E29E3FED7F25BED.quest_desc": [
		"A &aRolling Mill&r rolls paper or bamboo into straw (for the Blaze Burner with Straw)."
		"Make a &astack&r (16)."
	]
	"quest.3E29E3FED7F25BED.title": "Automate: Straw"
	"quest.3E2D23E1D3A0EBE4.quest_desc": [
		"Everything starts with rotation. Head to the &6Andesite Age&r."
	]
	"quest.3E2D23E1D3A0EBE4.title": "Start Building"
	"quest.3E8A5CA51D5E3551.quest_desc": [
		"Outputs 0-15 redstone for the pollution around it. Turn on scrubbers automatically."
	]
	"quest.3E8A5CA51D5E3551.title": "Smog Sensor"
	"quest.3E8CDCFA219066BF.quest_desc": [
		"Iron sheets, packed guncotton and an &aImpact Fuze&r (pack recipe). Drop it low over water:"
