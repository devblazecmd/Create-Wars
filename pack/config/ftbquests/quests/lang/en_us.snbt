	]
	"quest.7966DB5B8803ECF8.title": "Organic Compost"
	"quest.799B3A7B52938525.quest_desc": [
		"Hot air balloons: a &aHot Air Burner&r under an envelope gives adjustable lift."
	]
	"quest.799B3A7B52938525.title": "Hot Air Burner"
	"quest.79AFAE2A1B4CB9E2.quest_desc": [
		"Lets cannons fire on their own."
	]
	"quest.79AFAE2A1B4CB9E2.title": "Automatic Cannon Controller"
	"quest.7A0CFA70DB594577.quest_desc": [
		"Drive the train yourself."
	]
	"quest.7A0CFA70DB594577.title": "Train Controls"
	"quest.7A1C29BC7A1E7837.quest_desc": [
		"&6CBC: Firepower Components&r. A compact mount for cannons on vehicles and ships."
	]
	"quest.7A1C29BC7A1E7837.title": "Compact Cannon Mount"
	"quest.7AB9FC5B547B2BA9.quest_desc": [
		"Put rubber on the road."
	]
	"quest.7AB9FC5B547B2BA9.title": "Tire"
	"quest.7AD7EE7AAC074AE1.quest_desc": [
		"Diamond to netherite: the biggest chest."
	]
	"quest.7AD7EE7AAC074AE1.title": "Netherite Tier"
	"quest.7AEBA39C3151BF3B.quest_desc": [
		"Washed-out sulfur. Neutralize it in a basin (limestone works) back to clarified water."
	]
	"quest.7AEBA39C3151BF3B.title": "Acidic Runoff"
	"quest.7B00515BF7869680.quest_desc": [
		"Create Wars is a &6Create&r pack about building a faction that can &cfight&r: aircraft, artillery,"
		"radar-guided missiles, armored trains and submarines."
		""
		"This book is a &aguide&r: it never locks recipes or items. Chapters open up as you finish"
		"earlier ones: the &6Ages&r in order, then the &6Expansions&r once you reach the Brass Age."
	]
	"quest.7B00515BF7869680.quest_subtitle": "Open the book. You did it."
	"quest.7B00515BF7869680.title": "Welcome to Create Wars"
	"quest.7B036FB0C0449878.quest_desc": [
		"Heavy-duty drive belt."
	]
	"quest.7B036FB0C0449878.title": "Industrial Belt"
	"quest.7B0DBA63C3D5D511.quest_desc": [
		"Reach storage that isn't next to the connector."
	]
	"quest.7B0DBA63C3D5D511.title": "Inventory Cable"
	"quest.7B4891B86DBC4114.quest_desc": [
		"Real food for a long fight."
	]
	"quest.7B4891B86DBC4114.title": "Beef Stew"
	"quest.7B58D6CB05D0188E.quest_desc": [
		"For things below you."
	]
	"quest.7B58D6CB05D0188E.title": "Depth Charge"
	"quest.7B757D6F1FE22F44.quest_desc": [
		"&6Create: Warnautics&r: bombs fall with &aBig Cannons ballistics&r. Cast iron, iron plate,"
