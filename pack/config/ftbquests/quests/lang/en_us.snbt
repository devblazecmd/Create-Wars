	"quest.001F652EAEFEE740.quest_desc": [
		"Canvas and sticks. Picks up items in front of it, like a hopper."
	]
	"quest.001F652EAEFEE740.title": "Basket"
	"quest.005AC10822BFEE7D.quest_desc": [
		"Clay, dirt and sand: lines the moulds."
	]
	"quest.005AC10822BFEE7D.title": "Casting Sand"
	"quest.012C8C453F6577FE.quest_desc": [
		"Leather, glass, string and a filter cartridge. Pulls pollution out of you."
	]
	"quest.012C8C453F6577FE.title": "Smog Respirator"
	"quest.01417E6752358717.quest_desc": [
		"Runs off a &acopper backtank&r: precision mechanism, valve, pipe, brass and iron sheets."
	]
	"quest.01417E6752358717.title": "Nailgun"
	"quest.01B274AEC6E98520.quest_desc": [
		"A Spout fills items on a Depot or belt with fluid. You'll use it for Blaze Cakes and,"
		"later, for &dQuantum Paper&r."
	]
	"quest.01B274AEC6E98520.title": "Spout"
	"quest.01DB109F38C332AE.quest_desc": [
		"Stamped with the shotgun press form."
	]
	"quest.01DB109F38C332AE.title": "Shotgun Shell"
	"quest.0202D14D081DFB44.quest_desc": [
		"Iron plate, gunpowder and blaze powder (makes 2). Ammunition for rocket pods."
	]
	"quest.0202D14D081DFB44.title": "S-8 Rocket"
	"quest.026989985A23357E.quest_desc": [
		"Smooths the ride."
	]
	"quest.026989985A23357E.title": "Suspension Piece"
	"quest.02BA6E0ADEE99DA1.quest_desc": [
		"Liquid levitite blend. JEI shows how it sets into solid levitite."
	]
	"quest.02BA6E0ADEE99DA1.title": "Levitite Blend"
	"quest.03495FB874BD1066.quest_desc": [
		"Andesite casing, fluid pipe, iron and a piston pole. Bores out cast and built-up barrels."
	]
	"quest.03495FB874BD1066.title": "Cannon Drill"
	"quest.036B26DACF1DA03A.quest_desc": [
		"&6Create: Who Touched My Train&r: lock your train against other teams. In this pack, train"
		"blocks also resist cannon fire (&6CBC: Locometal Armor&r, server-side)."
	]
	"quest.036B26DACF1DA03A.title": "Train Lock"
	"quest.03B65E923ACB37ED.quest_desc": [
		"Track grip."
	]
	"quest.03B65E923ACB37ED.title": "Grouser"
	"quest.0470831658F15E52.quest_desc": [
		"Iron sheets and bars: the dish surface."
	]
	"quest.0470831658F15E52.title": "Radar Dish"
	"quest.047B724128CA8638.quest_desc": [
		"Brass casing material for train parts (and Quantum Casing)."
	]
	"quest.047B724128CA8638.title": "Train Casing"
	"quest.04D5C8ED75ADC36D.quest_desc": [
		"Smelt congealed nitro."
	]
	"quest.04D5C8ED75ADC36D.title": "Hardened Nitro"
	"quest.054F56945A0D2185.quest_desc": [
		"Andesite alloy. Turns a Basin into a foundry for melting metal."
	]
	"quest.054F56945A0D2185.title": "Basin Foundry Lid"
	"quest.05898BDC6E712A72.quest_desc": [
		"Made with iron sheets. A &aMechanical Saw&r cuts trees and processes wood; put it on a"
		"moving contraption to build a tree farm."
	]
	"quest.05898BDC6E712A72.title": "Mechanical Saw"
	"quest.05DA4FF98AE373A1.quest_desc": [
		"Cabbage leaves and filling."
	]
	"quest.05DA4FF98AE373A1.title": "Cabbage Rolls"
	"quest.05FD55AEF439EB0C.quest_desc": [
		"Cast iron tank, pipe and fireproof bricks: heats air for the furnace."
	]
	"quest.05FD55AEF439EB0C.title": "Blast Stove"
	"quest.062E02334D715791.quest_desc": [
		"Brass casing and a precision mechanism. Sets the exact &aRPM&r of whatever it feeds."
	]
	"quest.062E02334D715791.title": "Rotation Speed Controller"
	"quest.06594F19D2F3CE63.quest_desc": [
		"&aMechanical Crafting&r: adds wooden slabs and an &aImpact Fuze&r to the small bomb's"
		"ingredients."
	]
	"quest.06594F19D2F3CE63.title": "Medium Bomb"
	"quest.066EDE2B31CE6F97.quest_desc": [
		"The &aMechanical Press&r flattens ingots into sheets and compacts items in a &aBasin&r."
		"Put a &aDepot&r under it to hold what it's pressing."
	]
	"quest.066EDE2B31CE6F97.title": "Mechanical Press and Depot"
	"quest.06A39428AF78928B.quest_desc": [
		"Everything in Create starts with &aandesite&r: the gray stone found in big patches"
		"underground and in hillsides. Mine some."
	]
	"quest.06A39428AF78928B.title": "Find Andesite"
	"quest.06FB04B9C71307E7.quest_desc": [
		"Sound the alarm."
	]
	"quest.06FB04B9C71307E7.title": "Industrial Alarm"
	"quest.0784C2E3B1ED63AB.quest_desc": [
		"Iron sheet, precision mechanism and shaft: steering for a missile."
	]
	"quest.0784C2E3B1ED63AB.title": "Actuator Fins"
	"quest.07BF44C0797C1380.quest_desc": [
		"Each slot holds more items. Higher tiers hold far more."
	]
	"quest.07BF44C0797C1380.title": "Stack Upgrade Tier 1"
	"quest.07E8DC1BE76E7D93.quest_desc": [
		"Lasts 4x longer."
	]
	"quest.07E8DC1BE76E7D93.title": "Brass Filter Cartridge"
	"quest.083D0860E2942759.quest_desc": [
		"A mechanical bearing, electron tube and iron sheet. Build a dish on it and spin it to"
		"&ascan the sky&r. Check the Ponder for radar builds."
	]
	"quest.083D0860E2942759.title": "Radar Bearing"
	"quest.08ADF7B023180415.quest_desc": [
		"Find wild crops in the world and break them for seeds and produce. Plant them."
		"&aTip:&r Create's Millstone turns wild crops into seeds too."
	]
	"quest.08ADF7B023180415.title": "Wild Crops"
	"quest.092D0A0E2DF0AEE9.quest_desc": [
		"Turns nuggets into ingots and ingots into blocks as they come in."
	]
	"quest.092D0A0E2DF0AEE9.title": "Compacting Upgrade"
	"quest.0962E263FFA273D1.quest_desc": [
		"Everything that flies (or drives, or sails) starts here. A &aPhysics Assembler&r turns a"
		"built contraption into a real &6Sable&r physics object. Check its Ponder."
	]
	"quest.0962E263FFA273D1.title": "Physics Assembler"
	"quest.098FA67A40C809DB.quest_desc": [
		"Refuel a train at a station."
	]
	"quest.098FA67A40C809DB.title": "Portable Fuel Interface"
	"quest.09ACA9567831BCFF.quest_desc": [
		"Light vehicles."
	]
	"quest.09ACA9567831BCFF.title": "Small Tire"
	"quest.09D33D79CA336A9E.quest_desc": [
		"Same idea, turned on its side: a &aVertical Gearbox&r sends rotation up or down."
	]
	"quest.09D33D79CA336A9E.title": "Vertical Gearbox"
	"quest.0A4151F48A770553.quest_desc": [
		"Dried kelp makes &aBelts&r, which move items between machines. Place a belt by using"
		"it on two shafts."
	]
	"quest.0A4151F48A770553.title": "Belts"
	"quest.0ACD3C38CCC47073.quest_desc": [
		"Warns of incoming torpedoes."
	]
	"quest.0ACD3C38CCC47073.title": "Torpedo Detection Device"
	"quest.0AED7F0E408DE000.quest_desc": [
		"Cast a barrel from molten &abronze&r: lighter and tougher than cast iron."
	]
	"quest.0AED7F0E408DE000.title": "Bronze Cannon"
	"quest.0B1FFDFAEA02CC1B.quest_desc": [
		"Slime and paper. Tape a full chest to pick it up with everything inside."
	]
	"quest.0B1FFDFAEA02CC1B.title": "Packing Tape"
	"quest.0B4492CE16040D3F.quest_desc": [
		"Feed cobblestone into a &aMillstone&r. Make a &astack&r of gravel."
	]
	"quest.0B4492CE16040D3F.title": "Automate: Gravel"
	"quest.0C31FEEDB9F4C0F8.quest_desc": [
		"Grows in shallow water."
	]
	"quest.0C31FEEDB9F4C0F8.title": "Rice"
	"quest.0C34CAA169348117.quest_desc": [
		"Press &agold ingots&r into &aGolden Sheets&r: they make the Wrench and Goggles, and go into"
		"precision parts later."
	]
	"quest.0C34CAA169348117.title": "Gold Sheets"
	"quest.0C3E6CD025DD5F0B.quest_desc": [
		"Experience on tap."
	]
	"quest.0C3E6CD025DD5F0B.title": "Enchanting Automation"
	"quest.0C8ED7CBC0DFB08A.quest_desc": [
		"Mechanical crafting with an Entity Teleporter, Quantum Mechanism and more: build portals"
		"of your own shape. Each base needs at least 256 mB of Telejuice."
	]
	"quest.0C8ED7CBC0DFB08A.title": "Custom Portal Controller"
	"quest.0CC25CF336BC5A7A.quest_desc": [
		"Press gun steel into sheets."
	]
	"quest.0CC25CF336BC5A7A.title": "Steel Sheet"
	"quest.0CD62493EF389622.quest_desc": [
		"Reloads big cannons from a magazine."
	]
	"quest.0CD62493EF389622.title": "Cannon Magazine Loader"
	"quest.0CD7E5A645ACC910.quest_desc": [
		"Better cannons are &acast&r: pour molten cast iron into a &amould&r. Check the Ponder"
		"for casting setups."
	]
	"quest.0CD7E5A645ACC910.title": "Cast Iron Cannon"
	"quest.0D1C293AEDBE7585.quest_desc": [
		"Wet scrubbers drain it. &cDo not dump it&r: it contaminates ground and kills plants."
	]
	"quest.0D1C293AEDBE7585.title": "Industrial Wastewater"
	"quest.0D6FAA54E3DC19FA.quest_desc": [
		"Stay put."
	]
	"quest.0D6FAA54E3DC19FA.title": "Anchor"
	"quest.0D9AA173E29EA08E.quest_desc": [
		"Another way to fill an envelope."
	]
	"quest.0D9AA173E29EA08E.title": "Steam Vent"
	"quest.0D9F1985E16955EF.quest_desc": [
		"A cobblestone generator with a &aMechanical Drill&r mining it nonstop. Make a &astack&r."
	]
	"quest.0D9F1985E16955EF.title": "Automate: Cobblestone"
	"quest.0DE91D880C27E0AF.quest_desc": [
		"Brass sheet and a stripped log: steadies your aim."
	]
	"quest.0DE91D880C27E0AF.title": "Stock"
	"quest.0E100C9DE8E82065.quest_desc": [
		"&6Thick Air&r: you slowly run out of air &cbelow Y=0&r, &cabove Y=128&r, and in the Nether."
		"The End has no air at all. A &aBacktank&r with a &aDiving Helmet&r is your air supply."
		"&cPilots:&r flying above Y=128 needs this too."
	]
	"quest.0E100C9DE8E82065.title": "Copper Backtank"
	"quest.0E5FBD9105AE2934.quest_desc": [
		"Compact &aEgg + Sugar + Cinder Flour&r in a Basin (no heat needed)."
	]
	"quest.0E5FBD9105AE2934.title": "Blaze Cake Base"
	"quest.0E7AAD972EAEA28F.quest_desc": [
		"For the biggest builds."
	]
	"quest.0E7AAD972EAEA28F.title": "Monstrous Tire"
	"quest.0EF9790E6AD7081C.quest_desc": [
		"Kill them before they drink a potion."
	]
	"quest.0EF9790E6AD7081C.title": "Witches"
	"quest.0F1A32D940E5614D.quest_desc": [
		"Mass-produce the quantum supply chain."
	]
	"quest.0F1A32D940E5614D.title": "Quantum Automation"
	"quest.0F8FE5F9FB341304.quest_desc": [
		"Compact gunpowder into &aPacked Gunpowder&r and put it in an &aEmpty Powder Charge&r"
		"(wool and string). More charges = more range, and more strain on the barrel."
	]
	"quest.0F8FE5F9FB341304.title": "Powder Charge"
	"quest.0F99D02B0C15D1C8.quest_desc": [
		"Iron and a brick. Cook on the stove, or swing it as a weapon."
	]
	"quest.0F99D02B0C15D1C8.title": "Skillet"
	"quest.0FB364E6D5715082.quest_desc": [
		"Compact the base, fill it with lava and feed the cakes to your burners, all without"
		"touching it. Make a &astack&r of Blaze Cakes."
	]
	"quest.0FB364E6D5715082.title": "Automate: Blaze Cakes"
	"quest.0FC5913EC2DC28C7.quest_desc": [
		"Dough and filling."
	]
	"quest.0FC5913EC2DC28C7.title": "Dumplings"
	"quest.1010F3ECFE297C65.quest_desc": [
		"Graphite, an electron tube and a brass cartridge. Lasts 16x longer. A clean factory."
	]
	"quest.1010F3ECFE297C65.title": "Precision Filter Cartridge"
	"quest.10994D153CA9FABA.quest_desc": [
		"&6Enhanced AI&r: creepers &cbreach walls&r on purpose, and zombies dig to reach you. Build"
		"thick walls, or something they cannot dig through."
	]
	"quest.10994D153CA9FABA.title": "Breachers"
	"quest.109B3C60E36DD5D4.quest_desc": [
		"Made by &aSequenced Assembly&r: a &agolden sheet&r passes Deployers adding cogwheels, large"
		"cogwheels and iron nuggets, in a loop. JEI shows each step."
	]
	"quest.109B3C60E36DD5D4.title": "Precision Mechanism"
	"quest.10EEAA6ABB049773.quest_desc": [
		"Diving chestplate and leggings for swimming outside."
	]
	"quest.10EEAA6ABB049773.title": "Diving Gear"
	"quest.10F87A2D17CAB073.quest_desc": [
		"Run the blast furnace continuously. Make a &astack&r of Steel Ingots."
	]
	"quest.10F87A2D17CAB073.title": "Automate: Steel"
	"quest.10F97F3E76257275.quest_desc": [
		"Control engine and propeller power."
	]
	"quest.10F97F3E76257275.title": "Throttle Lever"
	"quest.112B7097521CB372.quest_desc": [
		"Mix &ablaze powder, gunpowder and magma cream&r. The start of stronger propellant."
	]
	"quest.112B7097521CB372.title": "Congealed Nitro"
	"quest.119F31071255E1D5.quest_desc": [
		"Scrubbers side by side join into one panel. A full &a5x5&r reaches up and clears the high"
		"air and the smog clouds."
	]
	"quest.119F31071255E1D5.title": "Scrubber Panel"
	"quest.11FDB45C5A84681B.quest_desc": [
		"A raid's heavy armor."
	]
	"quest.11FDB45C5A84681B.title": "Ravager"
	"quest.135D466BB447FEEE.quest_desc": [
		"Brass casing, electron tube and precision mechanism. Shows radar contacts."
	]
	"quest.135D466BB447FEEE.title": "Monitor"
	"quest.135F39054A742654.quest_desc": [
		"&eThis pack's own item:&r mix an &aEnder Pearl + 250 mB Telejuice&r in a Basin."
		"Replaces ender pearls in waystone recipes."
	]
	"quest.135F39054A742654.title": "Quantum Pearl"
	"quest.1360814D51B29322.quest_desc": [
		"&aIndustrial Iron Blocks&r and &acast iron&r. Build the oven multiblock (see its Ponder)."
	]
	"quest.1360814D51B29322.title": "Coke Oven"
	"quest.1379459167819F72.quest_desc": [
		"Make &a5 Electron Tubes&r without crafting them by hand (Deployers on a belt work)."
	]
	"quest.1379459167819F72.title": "Automate: Electron Tubes"
	"quest.14817DE690D788A0.quest_desc": [
		"A Press over a belt of iron ingots. Make a &astack&r of Iron Sheets."
	]
	"quest.14817DE690D788A0.title": "Automate: Iron Sheets"
	"quest.14939665A825B598.quest_desc": [
		"Lets hoppers, funnels and pipes insert into and extract from the whole network."
	]
	"quest.14939665A825B598.title": "Inventory Interface"
	"quest.149E2F64521FBDE6.quest_desc": [
		"Wear it with the backtank to breathe from it."
	]
	"quest.149E2F64521FBDE6.title": "Copper Diving Helmet"
	"quest.14AE92114CC90F48.quest_desc": [
		"Cook kelp in a furnace, smoker or on a campfire. Later, an &aEncased Fan&r blowing"
		"through fire does it in bulk."
	]
	"quest.14AE92114CC90F48.title": "Dried Kelp"
	"quest.14BCD8B12AE6EF84.quest_desc": [
		"The biggest bomb. Mechanical crafting around a Large Bomb, with a precision mechanism and"
		"sturdy sheets. &cBe careful where you drop it.&r"
	]
	"quest.14BCD8B12AE6EF84.title": "MOAB"
	"quest.14F99FFA53D598FD.quest_desc": [
		"Where the shell goes in."
	]
	"quest.14F99FFA53D598FD.title": "Arcon Barrel Section (Breech)"
	"quest.157B57B8355906AB.quest_desc": [
		"Heavy casing, steel mechanism and electron tube. Finds &aoil deposits&r underground."
	]
	"quest.157B57B8355906AB.title": "Surface Scanner"
	"quest.15F66045D0C797A4.quest_desc": [
		"A long-range guided missile: set its target with the Target Gunner Gadget."
	]
	"quest.15F66045D0C797A4.title": "Tomahawk"
	"quest.162B154459B5939E.quest_desc": [
		"Armored-train looks."
	]
	"quest.162B154459B5939E.title": "Riveted Locometal"
	"quest.170A73A299563CC2.quest_desc": [
		"Nailgun ammo."
	]
	"quest.170A73A299563CC2.title": "Nails"
	"quest.17101C72A1903A91.quest_desc": [
		"Opens your locked trains."
	]
	"quest.17101C72A1903A91.title": "Iron Key"
	"quest.1735BB1FF6FB4780.quest_desc": [
		"Emergency air. Soul fire, soul torches and soul campfires also make small pockets of"
		"breathable air."
	]
	"quest.1735BB1FF6FB4780.title": "Bottle of Soulfire"
	"quest.1738721036346250.quest_desc": [
		"Spreads oxygen through the hull."
	]
	"quest.1738721036346250.title": "Oxygen Diffuser"
	"quest.17A6D73E23678BDD.quest_desc": [
		"Deep dark. Probably best avoided."
	]
	"quest.17A6D73E23678BDD.title": "The Warden"
