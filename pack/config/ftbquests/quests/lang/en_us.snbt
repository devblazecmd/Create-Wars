	"quest.390997AC21E3AFB3.title": "Floater"
	"quest.392E87A3E40E4C76.quest_desc": [
		"Temperate biomes."
	]
	"quest.392E87A3E40E4C76.title": "Onion"
	"quest.398902EC58D4FE30.quest_desc": [
