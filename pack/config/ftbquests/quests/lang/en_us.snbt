	"quest.39B7178398319DC1.title": "Fire Controller"
	"quest.39DD3C2618D9991D.quest_desc": [
		"Every quest under &aSeafood&r is done: 16 production lines running on their own."
	]
	"quest.39DD3C2618D9991D.title": "Seafood Mastered"
	"quest.39E5554A01D624E3.quest_desc": [
		"Potatoes through a smoking fan. Make a &astack&r."
	]
	"quest.39E5554A01D624E3.title": "Automate: Baked Potato"
	"quest.3A1DAC5D045482E9.quest_desc": [
		"In this pack the Farmer's Delight cooking pot meals are also &aMixer&r recipes."
	]
	"quest.3A1DAC5D045482E9.title": "Mixing"
	"quest.3A6991406BB1CE62.quest_desc": [
		"&6Create: The Air War&r: a first-person attack drone. Four Andesite Propellers, a gyro"
		"stabilizer, antenna, camera and packed guncotton (pack recipe). Place it, link it with the"
		"Drone Joystick, and fly it into the target."
	]
	"quest.3A6991406BB1CE62.title": "FPV Drone"
	"quest.3A964BAC2C4E7B3A.quest_desc": [
		"Crops grow faster on it, and mushrooms grow into colonies."
	]
	"quest.3A964BAC2C4E7B3A.title": "Rich Soil"
	"quest.3B041FE3D50F4212.quest_desc": [
		"Sheep regrow wool after shearing: try Deployers holding shears. Dyed wool washes white"
		"in a fan blowing through water. Make a &astack&r."
