	"quest.4E215730E6F0B136.title": "Paper Cartridge"
	"quest.4EB5ADD78C50BDC2.quest_desc": [
		"&6Create: Bits 'n' Tracks&r: Sable-driven &atank treads&r. Check the Ponder for a track setup."
