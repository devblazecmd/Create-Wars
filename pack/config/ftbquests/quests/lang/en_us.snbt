	"quest.37AB361F8F9DA444.title": "Automate: Raw Amalgam"
	"quest.37DB384485B2E2CA.quest_desc": [
		"Crush gold ore or raw gold (ochrum works too). Make a &astack&r."
	]
	"quest.37DB384485B2E2CA.title": "Automate: Crushed Raw Gold"
	"quest.381EFD6DCD13A8ED.quest_desc": [
		"Actuator fins, brass casing, steel and a powder charge."
	]
	"quest.381EFD6DCD13A8ED.title": "Rocket Motor"
	"quest.383DAE64E511F83A.quest_desc": [
		"Raw fish, an onion and tomato sauce in the Cooking Pot."
	]
	"quest.383DAE64E511F83A.title": "Fish Stew"
	"quest.385048FDBEED3462.quest_desc": [
		"Iron plates, glass, a compass and redstone. Aim your drops from the air."
	]
	"quest.385048FDBEED3462.title": "Bombsight"
	"quest.38531C3CA7566C6E.quest_desc": [
		"Wooden slabs, a Create propeller and a shaft. Sturdier blades for a Propeller"
		"Bearing."
	]
	"quest.38531C3CA7566C6E.title": "Andesite Propeller"
	"quest.386FB1A022BFF30E.quest_desc": [
		"Production goals for Andesite-tier machines. Make these with &amachines&r, not by hand."
	]
	"quest.386FB1A022BFF30E.title": "Andesite Automation"
	"quest.38B0DD0B0812EC56.quest_desc": [
		"Apple, 2 melon slices, a pumpkin slice, 2 berries and a bowl. Make a &astack&r (16)."
	]
	"quest.38B0DD0B0812EC56.title": "Automate: Fruit Salad"
	"quest.38F621FA929A1DD8.quest_desc": [
		"&6Create: The Air War&r. Arm your aircraft. (Its launchers and their ammo are removed in this"
